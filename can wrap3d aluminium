<div id="canwrap-hostinger-embed">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
            }
        }
    </script>

    <div id="cw-weldmax-wrapper">
        
        <div id="cw-ui-layer">
            <h2 class="cw-title">Canwrap3D™</h2>
            <span class="cw-version-label">Aluminium Monoblock Pro</span>

            <div class="cw-control-group">
                <div class="cw-label-row"><span>VIEWPORT BACKGROUND</span></div>
                <div class="cw-btn-row">
                    <button id="bg-default" class="cw-toggle-btn cw-toggle-left active">Default</button>
                    <button id="bg-dark" class="cw-toggle-btn cw-toggle-mid">Dark</button>
                    <button id="bg-white" class="cw-toggle-btn cw-toggle-mid">White</button>
                    <button id="bg-custom" class="cw-toggle-btn cw-toggle-right">Custom</button>
                </div>
                <input type="file" id="bgUpload" accept="image/*" style="display:none">
            </div>

            <div class="cw-control-group">
                <div class="cw-label-row"><span>DIMENSIONS</span></div>
                
                <div class="cw-label-row" style="margin-top:5px; font-weight:400; color:#666;">
                    Diameter <span id="diamVal" style="float:right; font-weight:700;">35mm</span>
                </div>
                <select id="diameterSelect" class="cw-select">
                    <option value="35">35mm</option>
                    <option value="40">40mm</option>
                    <option value="45">45mm</option>
                    <option value="50">50mm</option>
                    <option value="53">53mm</option>
                    <option value="57">57mm</option>
                    <option value="66">66mm</option>
                </select>

                <div class="cw-label-row" style="margin-top:8px; font-weight:400; color:#666;">Shoulder Profile</div>
                <select id="shoulderSelect" class="cw-select">
                    <option value="standard">Standard (Round)</option>
                    <option value="bullet">Bullet (Ogive)</option>
                    <option value="flat">Industrial (Flat)</option>
                    <option value="rimless">Rimless (Soft)</option>
                </select>

                <div class="cw-label-row" style="margin-top:8px; font-weight:400; color:#666;">Body Shape</div>
                <select id="bodyShapeSelect" class="cw-select">
                    <option value="straight">Straight (Standard)</option>
                    <option value="waisted">Waisted (Hourglass)</option>
                    <option value="tapered">Tapered Base (V-Shape)</option>
                    <option value="grip">Top Grip (3 Rings)</option>
                    <option value="bottom_grip">Bottom Grip (3 Rings)</option>
                    <option value="ringed_neck">Neck Ringed</option>
                    <option value="barrel">Volume Barrel</option>
                </select>

                <div class="cw-label-row" style="margin-top:8px; font-weight:400; color:#666;">
                    Height <span id="heightVal" style="float:right; font-weight:700;">150mm</span>
                </div>
                <input type="range" id="heightRange" class="cw-range" min="80" max="300" value="150">

                <div class="cw-label-row" style="margin-top:8px; font-weight:400; color:#666;">
                    Shoulder Height <span id="shoulderVal" style="float:right; font-weight:700;">15mm</span>
                </div>
                <input type="range" id="shoulderRange" class="cw-range" min="2" max="60" value="15">
            </div>

            <button class="cw-primary-btn" onclick="document.getElementById('artUpload').click()">
                <span>&#8682;</span> UPLOAD DESIGN
            </button>
            <input type="file" id="artUpload" accept="image/*" style="display:none">
            <div id="cw-loading">Processing Artwork...</div>

            <div class="cw-control-group">
                <div class="cw-label-row"><span>BRIGHTNESS</span> <span id="brightVal">50%</span></div>
                <input type="range" id="brightRange" class="cw-range" min="0" max="100" value="50">
                
                <div style="height: 8px;"></div>

                <div class="cw-label-row"><span>GLOSS</span> <span id="glossVal">70%</span></div>
                <input type="range" id="glossRange" class="cw-range" min="0" max="100" value="70">
            </div>

            <div class="cw-control-group">
                <div class="cw-btn-row" style="gap:8px">
                    <button class="cw-btn-small" id="btnFlipH">FLIP HORIZ</button>
                    <button class="cw-btn-small" id="btnFlipV">FLIP VERT</button>
                </div>
            </div>
            <div style="height: 20px;"></div>
        </div>

        <div id="cw-canvas-layer"></div>

    </div>

    <style>
