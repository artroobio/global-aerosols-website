# Cloudflare Pages cache rules.
# Lighthouse "Use efficient cache lifetimes" — long-cache static assets so
# repeat visits and subpage navigation load from local browser cache.

# Astro build output: content-hashed filenames, safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static images (stable filenames) — cache 30 days.
/images/*
  Cache-Control: public, max-age=2592000

# Fonts / icons / static root assets.
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
