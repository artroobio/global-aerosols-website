              <tr><td>LPG</td><td>Lowest</td><td>Domestic refining infrastructure</td></tr>
              <tr><td>DME</td><td>Mid-range</td><td>Specialty chemical import</td></tr>
              <tr><td>HFCs</td><td>Highest</td><td>Import dependence, regulatory compliance</td></tr>
