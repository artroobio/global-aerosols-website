---
import '../styles/global.css';
import Navbar from '../lc/components/Navbar.astro';
import Footer from '../lc/components/Footer.astro';
import SmoothScroll from '../lc/components/SmoothScroll.astro';
import WhatsAppFloat from '../lc/components/WhatsAppFloat.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  schemaJson?: any;
}

const {
  title = 'Global Aerosols - Industrial & Chemical Product R&D Specialists',
  description = 'Get expert R&D, chemical formulations, aerosol consulting, and turnkey manufacturing engineering from industrial specialist Absar Khan and the Global Aerosols team.',
  canonical = Astro.url.href,
  ogImage = 'https://www.globalaerosols.com/og-default.jpg',
  ogType = 'website',
  schemaJson,
} = Astro.props;

const rawCanonical = canonical.startsWith('http') ? canonical : `https://www.globalaerosols.com${canonical}`;
const cleanCanonical = (() => {
  try {
    const u = new URL(rawCanonical);
    if (!u.pathname.endsWith('/') && !u.pathname.split('/').pop()?.includes('.')) {
      u.pathname += '/';
    }
    return u.toString();
  } catch {
    return rawCanonical;
  }
})();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={cleanCanonical} />

    <meta name="robots" content="index, follow" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link rel="alternate" hreflang="en" href={cleanCanonical} />
    <link rel="alternate" hreflang="x-default" href={cleanCanonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={cleanCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Global Aerosols" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={cleanCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}
  </head>
  <body>
    <SmoothScroll />
    <Navbar />

    <div class="content-wrapper">
      <slot />
    </div>

    <Footer />
    <WhatsAppFloat />

    <script is:inline>
      (function() {
        const STATIC_CATEGORIES = ['home', 'industrial', 'auto', 'cosmetics', 'paints', 'arts', 'nav'];

        function getFallbackSrc(src) {
          if (!src) return src;
          // Skip same-origin URLs (already local) to prevent infinite rewrite loop
          if (!src.startsWith('http') || src.startsWith(window.location.origin)) return src;
          const idx = src.indexOf('images/');
          if (idx === -1) return src;

          const cleanPath = src.substring(idx); // e.g. "images/category/filename" or "images/slug/filename"
          const segments = cleanPath.split('/');
          if (segments.length === 3) {
            const category = segments[1];
            const filename = segments[2];
            if (STATIC_CATEGORIES.indexOf(category) !== -1) {
              return '/' + cleanPath;
            } else {
              return '/images/blog/' + filename;
            }
          }
          return '/' + cleanPath;
        }

        // Check if CDN has failed in this or previous sessions
        let cdnFailed = false;
        try {
          cdnFailed = localStorage.getItem('r2_cdn_failed') === 'true';
        } catch (e) {}

        function handleImageError(img) {
          if (img.src) {
            const fallback = getFallbackSrc(img.src);
            if (fallback !== img.src) {
              img.src = fallback;
              if (!cdnFailed) {
                cdnFailed = true;
                try {
                  localStorage.setItem('r2_cdn_failed', 'true');
                } catch (e) {}
              }
            }
          }
        }

        // Listen for image load errors globally (using capture phase)
        window.addEventListener('error', function(e) {
          if (e && e.target && e.target.tagName === 'IMG') {
            handleImageError(e.target);
          }
        }, true);

        // Scan and rewrite images and background styles
        function scanAndRewrite() {
          // 1. Rewrite <img> tags
          document.querySelectorAll('img').forEach(function(img) {
            if (img.src) {
              const fallback = getFallbackSrc(img.src);
              if (fallback !== img.src) {
                img.src = fallback;
              }
            }
          });

          // 2. Rewrite background images
          document.querySelectorAll('[style*="images"]').forEach(function(el) {
            const style = el.getAttribute('style') || '';
            const match = style.match(/url\(['"]?([^'")]+images\/[^'")]+)['"]?\)/);
            if (match && match[1]) {
              const originalUrl = match[1];
              const fallbackUrl = getFallbackSrc(originalUrl);
              if (fallbackUrl !== originalUrl) {
                el.style.backgroundImage = 'url("' + fallbackUrl + '")';
              }
            }
          });
        }

        // If CDN already marked as failed, rewrite immediately to prevent flash/delay
        if (cdnFailed) {
          scanAndRewrite();

          // Set up periodic scanning and DOM-ready triggers
          document.addEventListener('DOMContentLoaded', scanAndRewrite);
          window.addEventListener('load', scanAndRewrite);
          
          // Use MutationObserver for high-performance reactive scanning
          if (window.MutationObserver) {
            const observer = new MutationObserver(scanAndRewrite);
            observer.observe(document.documentElement, {
              childList: true,
              subtree: true,
              attributes: true,
              attributeFilter: ['style', 'src']
            });
          } else {
            setInterval(scanAndRewrite, 300);
          }
        }
      })();
    </script>
  </body>
</html>

<style>
  :global(.content-wrapper) {
    padding-top: 88px;
  }
</style>
