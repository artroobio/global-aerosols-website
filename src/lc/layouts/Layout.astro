---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	ogType?: string;
}

const {
	title = 'Global Aerosols | Premium Aerosol Engineering & Systems',
	description = 'Expert aerosol engineering, consulting, and turnkey manufacturing engineering from industrial specialist Absar Khan and the Global Aerosols team.',
	canonical,
	ogImage = 'https://www.globalaerosols.com/og-default.jpg',
	ogType = 'website',
} = Astro.props;

const rawCanonicalUrl = canonical
	? (canonical.startsWith('http') ? canonical : `https://www.globalaerosols.com${canonical}`)
	: Astro.url.href;
const canonicalUrl = (() => {
	try {
		const u = new URL(rawCanonicalUrl);
		if (!u.pathname.endsWith('/') && !u.pathname.split('/').pop()?.includes('.')) {
			u.pathname += '/';
		}
		return u.toString();
	} catch {
		return rawCanonicalUrl;
	}
})();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a0a0a" />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<meta name="robots" content="index, follow" />
		<link rel="alternate" hreflang="en" href={canonicalUrl} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content="Global Aerosols" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- ── Sitewide Organization / Manufacturer entity (commercial supplier signal) ── -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": ["Organization", "Manufacturer"],
			"@id": "https://www.globalaerosols.com/#organization",
			"name": "Global Aerosols",
			"url": "https://www.globalaerosols.com/",
			"logo": "https://www.globalaerosols.com/og-default.jpg",
			"image": "https://www.globalaerosols.com/og-default.jpg",
			"description": "Manufacturer, wholesale supplier and exporter of aerosol cans, valves, actuators, caps and filling equipment, plus contract aerosol filling and product formulation services.",
			"slogan": "Premium Aerosol Engineering & Systems",
			"areaServed": "Worldwide",
			"knowsAbout": [
				"Aerosol cans", "Aluminum monobloc cans", "Tinplate aerosol cans",
				"Aerosol valves", "Bag-on-valve (BoV)", "Aerosol actuators", "Aerosol caps",
				"Aerosol filling equipment", "Contract aerosol filling", "Product formulation"
			],
			"sameAs": [],
			"contactPoint": {
				"@type": "ContactPoint",
				"telephone": "+91-9819548320",
				"contactType": "sales",
				"areaServed": "Worldwide",
				"availableLanguage": ["English"]
			},
			"address": {
				"@type": "PostalAddress",
				"addressCountry": "IN"
			},
			"makesOffer": [
				{ "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Aerosol Cans (Aluminum Monobloc & Tinplate)" }, "url": "https://www.globalaerosols.com/services/aerosol-cans/" },
				{ "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Aerosol Valves, Actuators & Spray Caps" }, "url": "https://www.globalaerosols.com/services/aerosol-valves-caps-and-actuators/" },
				{ "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Aerosol Caps & Overcaps" }, "url": "https://www.globalaerosols.com/services/aerosol-caps/" },
				{ "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Aerosol Machines & Filling Equipment" }, "url": "https://www.globalaerosols.com/services/aerosol-machines-and-equipment/" },
				{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Contract Aerosol Filling" } },
				{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Product Formulation" } }
			]
		})} />

		<!-- Preconnect to image CDN -->
		<link rel="preconnect" href="https://cdn.globalaerosols.com/" crossorigin />

		<!-- Fonts async (non-render-blocking) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@400;500;600;700&family=Michroma&family=Montserrat:wght@200;300;400;700;800;900&family=Poppins:wght@300;400;600&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@400;500;600;700&family=Michroma&family=Montserrat:wght@200;300;400;700;800;900&family=Poppins:wght@300;400;600&display=swap" /></noscript>
	</head>
	<body>
		<SmoothScroll />
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
		<WhatsAppFloat />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		overflow-x: clip;
	}
	main {
		padding-top: 0;
	}
	html {
		scroll-behavior: smooth;
	}

	/* ── Animated heading word-wrapper (used by About + all service pages) ── */
	.aw {
		display: inline-block;
		white-space: nowrap;
		margin-right: 0.24em;
	}

	/* Line-break helper used in service page headings */
	.br-d { display: none; }
	@media (min-width: 720px) { .br-d { display: inline; } }
</style>
