---
// src/lc/components/PharmaceuticalsProcessParallax.astro
const steps = [
  {
    num: "01",
    title: "Custom Formulation Development",
    img: "/images/pharmaceuticals/pharma_scroll_1.png",
    description: "Development of pharmaceutical tablets, capsules, syrups, injectables, medical devices, nutraceuticals, dietary supplements, wound care products, diagnostic reagents, and healthcare solutions for pharmaceutical and medical device industries.",
    badge: "Formulation R&D"
  },
  {
    num: "02",
    title: "Reverse Engineering & Benchmarking",
    img: "/images/pharmaceuticals/pharma_scroll_2.png",
    description: "Analysis of competitor pharmaceutical and healthcare products including API profiles, excipient systems, dissolution profiles, clinical equivalence studies, medical device specifications, and formulation reconstruction for generic drug development and healthcare product matching.",
    badge: "Reverse Engineering"
  },
  {
    num: "03",
    title: "Performance & Bioavailability Tuning",
    img: "/images/pharmaceuticals/pharma_scroll_3.png",
    description: "Fine-tuning of API bioavailability, therapeutic efficacy, dissolution rates, stability profiles, drug delivery systems, medical device performance, patient safety parameters, and clinical outcomes for enhanced healthcare solutions and pharmaceutical products.",
    badge: "Efficacy Tuning"
  },
  {
    num: "04",
    title: "Regulatory & Compliance Support",
    img: "/images/pharmaceuticals/pharma_scroll_4.png",
    description: "Complete regulatory support including clinical documentation, stability studies, bioequivalence testing, GMP compliance, USFDA/WHO/EU/ISO guidelines adherence, medical device regulations, pharmacovigilance, dossier preparation, and regulatory filing assistance for pharmaceutical and healthcare products.",
    badge: "Compliance Support"
  },
  {
    num: "05",
    title: "Cost & Raw Material Optimization",
    img: "/images/pharmaceuticals/pharma_scroll_5.png",
    description: "Reduce manufacturing costs through API sourcing optimization, excipient alternatives, medical-grade material substitution, and process efficiency improvements while maintaining clinical efficacy, therapeutic outcomes, patient safety, and healthcare quality standards.",
    badge: "Value Engineering"
  },
  {
    num: "06",
    title: "Scale-Up, Plant Setup & Transfer",
    img: "/images/pharmaceuticals/pharma_scroll_6.png",
    description: "Guidance for pharmaceutical manufacturing equipment, medical device production systems, process validation, technology transfer, GMP/ISO certified facility setup, healthcare quality control, batch scale-up protocols, and seamless transition from lab-scale to commercial healthcare production.",
    badge: "Production Transfer"
  }
];
---

<section class="pharmaceuticals-process-sticky-section">
  <div class="process-grid-container">

    <!-- Left Column: Sticky Sidebar -->
    <div class="process-sidebar">
      <div class="sidebar-content">
        <span class="process-eyebrow">R&D Solutions</span>
        <h2 class="process-main-title">
          {"Pharmaceutical & Healthcare Solutions".split(' ').map(word => (
            <span class="word-wrapper">
              {word.split('').map(char => (
                <span class="blue-char">{char}</span>
              ))}
            </span>
          ))}
        </h2>
        <p class="process-subtitle">
          Experience a systematic engineering approach built specifically for modern pharmaceutical formulations, medical devices, active diagnostics, and therapeutic wellness products.
        </p>
        <div class="process-bullet-subs">
          <p class="sub-bullet">✦ API and Bioavailability Optimization</p>
          <p class="sub-bullet">✦ GMP Blending Scale-Up & Technology Transfer</p>
        </div>

        <!-- Horizontal Button Timeline (Desktop Only) -->
        <div class="process-timeline">
          {steps.map((step, index) => (
            <div class="timeline-step" data-step-index={index}>
              <div class="step-content">
                <span class="step-num">{step.num}</span>
                <span class="step-label">{step.title}</span>
              </div>
              <div class="step-arrow-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="step-arrow-icon">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Column: Scrolling Cards Stack -->
    <div class="process-cards-stack">

      <!-- Intro Card -->
      <div class="process-intro-card">
        <span class="tagline">Process Excellence</span>
        <h3 class="card-title-intro">
          {"From Lab to Blending Plant".split(' ').map(word => (
            <span class="cw">
              {word.split('').map(char => (
                <span class="cc cc-dark">{char}</span>
              ))}
            </span>
          ))}
        </h3>
        <p>Explore our end-to-end pharmaceutical formulation and engineering lifecycle—designed for efficacy, compliance, and industrial scale.</p>
        <div class="scroll-instruction">
          <span class="scroll-dot"></span>
          <span>Scroll down to explore our R&D solutions</span>
        </div>
      </div>

      <!-- Step Cards -->
      {steps.map((step, index) => (
        <div class="process-card" data-step-card={index}>

          <!-- Background Image -->
          <div class="card-image-wrapper">
            <img class="process-image" src={step.img} alt={step.title} loading="eager" />
            <div class="image-shade"></div>
          </div>

          <!-- Permanent Glassmorphism Content Panel -->
          <div class="card-glass">
            <!-- Top row: number + badge -->
            <div class="glass-toprow">
              <span class="glass-num">{step.num}</span>
              <span class="glass-badge">{step.badge}</span>
            </div>

            <!-- Animated Title -->
            <h3 class="step-title">
              {step.title.split(' ').map(word => (
                <span class="cw">
                  {word.split('').map(char => (
                    <span class="cc cc-white">{char}</span>
                  ))}
                </span>
              ))}
            </h3>

            <!-- Description -->
            <p class="glass-desc">{step.description}</p>

            <!-- CTA -->
            <a href="#contact" class="glass-action-btn">
              <span>Speak With Experts</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron-arrow">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </div>
      ))}

      <!-- Outro Card -->
      <div class="process-outro-card">
        <span class="outro-tag">Let's Collaborate</span>
        <h3 class="card-title-outro">
          {"Ready to start your synthesis?".split(' ').map(word => (
            <span class="cw">
              {word.split('').map(char => (
                <span class="cc cc-dark">{char}</span>
              ))}
            </span>
          ))}
        </h3>
        <p>Consult directly with Absar Khan to conduct a custom audit of your formulations, regulatory dossier gaps, and facility scale-up plans.</p>
        <a href="#contact" class="outro-cta-btn">
          <span>Book Formulation Audit</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .pharmaceuticals-process-sticky-section {
    background-color: #ffffff;
    position: relative;
    width: 100%;
    margin: 0;
    box-sizing: border-box;
  }

  .process-grid-container {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(40px, 5vw, 100px);
    width: 100%;
    margin: 0 auto;
    align-items: start;
    padding: 120px 5% 120px 5%;
    box-sizing: border-box;
  }

  .process-sidebar {
    position: sticky;
    top: 140px;
    height: auto;
    align-self: start;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process-eyebrow {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 5px;
    color: #2563eb;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .process-main-title {
    font-size: clamp(2.2rem, 3.5vw, 3.6rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    margin: 0 0 20px 0;
    letter-spacing: -0.03em;
  }

  .word-wrapper {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.28em;
  }

  .blue-char {
    display: inline-block;
    opacity: 0;
    color: #0f172a;
    -webkit-text-fill-color: #0f172a;
  }

  .process-subtitle {
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    color: #475569;
    line-height: 1.7;
    margin: 0;
  }

  .process-bullet-subs {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 18px;
    margin-bottom: 8px;
  }

  .sub-bullet {
    font-size: 0.95rem;
    font-weight: 600;
    color: #2563eb;
    margin: 0;
  }

  /* ============================================================
     BUTTON ROW TIMELINE (Desktop)
     ============================================================ */

  .process-timeline {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    width: calc(100% + 48px);
    margin-left: -24px;
    margin-right: -24px;
    border-top: 2px solid rgba(15, 23, 42, 0.08);
    box-sizing: border-box;
  }

  .timeline-step {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 10px 20px;
    cursor: pointer;
    border-bottom: 2px solid rgba(15, 23, 42, 0.08);
    background: transparent;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    z-index: 2;
    user-select: none;
    box-sizing: border-box;
  }

  .step-content {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .step-num {
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    font-weight: 800;
    color: #94a3b8;
    -webkit-text-fill-color: #94a3b8;
    opacity: 0.8;
    transition: all 0.35s ease;
  }

  .step-label {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(0.7rem, 0.9vw, 0.82rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #0f172a;
    -webkit-text-fill-color: #0f172a;
    transition: all 0.35s ease;
  }

  .step-arrow-box {
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.15);
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    margin-left: auto;
  }

  .step-arrow-icon {
    width: 12px;
    height: 12px;
    color: #ffffff;
  }

  .timeline-step:hover {
    background-color: var(--primary, #0968e5);
    padding-left: 28px;
  }

  .timeline-step:hover .step-num,
  .timeline-step:hover .step-label {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  .timeline-step:hover .step-arrow-box {
    opacity: 1;
    transform: translateX(0);
  }

  .timeline-step.active .step-num,
  .timeline-step.active .step-label {
    color: var(--primary, #0968e5) !important;
    -webkit-text-fill-color: var(--primary, #0968e5) !important;
  }

  .process-timeline:not(:hover) .timeline-step.active {
    background-color: var(--primary, #0968e5);
    padding-left: 28px;
  }

  .process-timeline:not(:hover) .timeline-step.active .step-num,
  .process-timeline:not(:hover) .timeline-step.active .step-label {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  .process-timeline:not(:hover) .timeline-step.active .step-arrow-box {
    opacity: 1;
    transform: translateX(0);
  }

  .process-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-bottom: 0;
  }

  .process-intro-card,
  .process-card,
  .process-outro-card {
    width: 100%;
    height: 520px;
    border-radius: 28px;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    border: 1px solid #edf0f4;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  }

  .process-intro-card {
    background: #f0f9ff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 52px 48px;
  }

  .process-intro-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(to right, #06b6d4, #2563eb);
  }

  .tagline {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: #2563eb;
    font-weight: 700;
    display: block;
    margin-bottom: 20px;
  }

  .cw {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.22em;
  }

  .cc {
    display: inline-block;
    opacity: 0;
  }

  .cc-white {
    color: #ffffff;
    -webkit-text-fill-color: #ffffff;
  }

  .cc-dark {
    color: #0f172a;
    -webkit-text-fill-color: #0f172a;
  }

  .process-intro-card h3 {
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .process-intro-card p {
    font-size: 1rem;
    color: #475569;
    line-height: 1.65;
    margin: 0 0 32px 0;
  }

  .scroll-instruction {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #475569;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .scroll-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #2563eb;
    flex-shrink: 0;
    animation: pharmaPulseGlow 1.8s ease infinite;
  }

  @keyframes pharmaPulseGlow {
    0%   { transform: scale(0.9); opacity: 0.6; box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.35); }
    70%  { transform: scale(1.2); opacity: 1;   box-shadow: 0 0 0 10px rgba(37, 99, 235, 0); }
    100% { transform: scale(0.9); opacity: 0.6; box-shadow: 0 0 0 0   rgba(37, 99, 235, 0); }
  }

  .card-image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .process-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    transition: transform 10s linear;
  }

  .image-shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      rgba(5, 10, 24, 0.0) 0%,
      rgba(5, 10, 24, 0.15) 40%,
      rgba(5, 10, 24, 0.65) 70%,
      rgba(5, 10, 24, 0.88) 100%
    );
  }

  .card-glass {
    position: absolute;
    left: 14px;
    bottom: 14px;
    width: calc(100% - 28px);
    max-width: 360px;
    z-index: 10;
    background: rgba(8, 15, 38, 0.48);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 16px;
    padding: 16px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .glass-toprow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .glass-num {
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
  }

  .glass-badge {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #ffffff;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.1);
    padding: 3px 9px;
    border-radius: 99px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    white-space: nowrap;
  }

  .step-title {
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .glass-desc {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.5;
    margin: 0;
  }

  .glass-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 5px 12px 5px 10px;
    border-radius: 99px;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.72rem;
    text-decoration: none;
    margin-top: 2px;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    flex-shrink: 0;
    letter-spacing: 0.01em;
  }

  .glass-action-btn:hover {
    background: rgba(255, 255, 255, 0.24);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }

  .chevron-arrow {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .glass-action-btn:hover .chevron-arrow {
    transform: translate(2px, -2px);
  }

  .process-outro-card {
    background: linear-gradient(150deg, #f0f9ff 0%, #fafbff 100%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 52px 48px;
    position: relative;
  }

  .process-outro-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(to right, #06b6d4, #2563eb);
  }

  .outro-tag {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: #2563eb;
    font-weight: 700;
    display: block;
    margin-bottom: 20px;
  }

  .process-outro-card h3 {
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .process-outro-card p {
    font-size: 1rem;
    color: #475569;
    line-height: 1.65;
    margin: 0 0 36px 0;
  }

  .outro-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: #2563eb;
    color: #ffffff;
    padding: 14px 28px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    align-self: flex-start;
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
    transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .outro-cta-btn:hover {
    background: #1d4ed8;
    box-shadow: 0 12px 30px rgba(37, 99, 235, 0.3);
    transform: translateY(-2px);
  }

  .cta-arrow {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .outro-cta-btn:hover .cta-arrow {
    transform: translate(3px, -3px);
  }

  @media (max-width: 991px) {
    .process-grid-container {
      display: flex;
      flex-direction: column;
      gap: 40px;
      padding: 60px 24px 80px;
    }

    .process-sidebar {
      position: static;
    }

    .process-timeline {
      display: none;
    }

    .process-cards-stack {
      gap: 28px;
      padding-bottom: 40px;
    }

    .process-intro-card,
    .process-card,
    .process-outro-card {
      height: 440px;
      border-radius: 22px;
    }

    .process-intro-card,
    .process-outro-card {
      padding: 36px 28px;
    }

    .process-intro-card h3,
    .process-outro-card h3,
    .step-title {
      font-size: 1.7rem;
    }

    .outro-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .process-grid-container {
      padding: 48px 16px 64px;
    }

    .process-intro-card,
    .process-card,
    .process-outro-card {
      height: 460px;
    }

    .process-intro-card,
    .process-outro-card {
      padding: 28px 24px;
    }

    .process-intro-card h3,
    .process-outro-card h3,
    .step-title {
      font-size: 1.5rem;
    }

    .glass-desc,
    .process-intro-card p,
    .process-outro-card p {
      font-size: 0.88rem;
    }
  }

  @media (max-height: 900px) and (min-width: 992px) {
    .process-grid-container {
      padding-top: 80px;
      padding-bottom: 80px;
    }
    .process-sidebar {
      top: 90px;
    }
    .process-main-title {
      margin-bottom: 12px;
      font-size: clamp(1.8rem, 2.5vw, 2.8rem);
    }
    .process-subtitle {
      font-size: 0.9rem;
      line-height: 1.5;
    }
    .process-bullet-subs {
      margin-top: 12px;
      margin-bottom: 4px;
      gap: 4px;
    }
    .sub-bullet {
      font-size: 0.85rem;
    }
    .process-timeline {
      margin-top: 20px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initPharmaceuticalsProcessDiagram() {
    const section = document.querySelector('.pharmaceuticals-process-sticky-section');
    if (!section) return;

    const mainTitleChars = document.querySelectorAll('.pharmaceuticals-process-sticky-section .blue-char');
    const introCardChars = document.querySelectorAll('.pharmaceuticals-process-sticky-section .process-intro-card .cc');
    const outroCardChars = document.querySelectorAll('.pharmaceuticals-process-sticky-section .process-outro-card .cc');

    const revealTrigger = ScrollTrigger.create({
      trigger: section,
      start: "top 75%",
      onEnter: () => {
        gsap.fromTo(mainTitleChars,
          { opacity: 0, x: -12, color: '#2563eb', webkitTextFillColor: '#2563eb' },
          {
            opacity: 1, x: 0,
            color: '#0f172a', webkitTextFillColor: '#0f172a',
            duration: 0.5, stagger: 0.015, ease: "power3.out"
          }
        );
      },
      once: true
    });

    const isMobile = window.innerWidth <= 991;
    if (isMobile) return;

    const cards = gsap.utils.toArray('.pharmaceuticals-process-sticky-section .process-card');
    const timelineSteps = gsap.utils.toArray('.pharmaceuticals-process-sticky-section .timeline-step');
    const progressBar = document.getElementById('pharmaceuticals-timeline-progress-bar');

    cards.forEach((card: any, index: number) => {
      const charElements = card.querySelectorAll('.cc');
      const stepTimeline = timelineSteps[index] as HTMLElement;

      ScrollTrigger.create({
        trigger: card,
        start: "top 55%",
        end: "bottom 55%",
        onEnter: () => {
          timelineSteps.forEach(s => s.classList.remove('active'));
          if (stepTimeline) stepTimeline.classList.add('active');
          if (stepTimeline) stepTimeline.scrollIntoView({ behavior: "smooth", block: "nearest" });

          gsap.fromTo(charElements,
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, duration: 0.45, stagger: 0.01, ease: 'power2.out' }
          );

          if (progressBar) {
            const progressPercent = (index / (cards.length - 1)) * 100;
            gsap.to(progressBar, { height: `${progressPercent}%`, duration: 0.4, ease: 'power2.out' });
          }
        },
        onEnterBack: () => {
          timelineSteps.forEach(s => s.classList.remove('active'));
          if (stepTimeline) stepTimeline.classList.add('active');
          if (stepTimeline) stepTimeline.scrollIntoView({ behavior: "smooth", block: "nearest" });

          if (progressBar) {
            const progressPercent = (index / (cards.length - 1)) * 100;
            gsap.to(progressBar, { height: `${progressPercent}%`, duration: 0.4, ease: 'power2.out' });
          }
        }
      });
    });

    ScrollTrigger.create({
      trigger: '.pharmaceuticals-process-sticky-section .process-intro-card',
      start: "top 55%",
      onEnter: () => {
        timelineSteps.forEach(s => s.classList.remove('active'));
        if (progressBar) gsap.to(progressBar, { height: "0%", duration: 0.3 });

        gsap.fromTo(introCardChars,
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.5, stagger: 0.012, ease: 'power2.out' }
        );
      }
    });

    ScrollTrigger.create({
      trigger: '.pharmaceuticals-process-sticky-section .process-outro-card',
      start: "top 55%",
      onEnter: () => {
        timelineSteps.forEach(s => s.classList.remove('active'));
        if (progressBar) gsap.to(progressBar, { height: "100%", duration: 0.3 });

        gsap.fromTo(outroCardChars,
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.5, stagger: 0.012, ease: 'power2.out' }
        );
      }
    });

    timelineSteps.forEach((step: any, index: number) => {
      step.addEventListener('click', () => {
        const targetCard = cards[index] as HTMLElement;
        if (targetCard) {
          const targetY = targetCard.getBoundingClientRect().top + window.scrollY - 120;
          gsap.to(window, { scrollTo: { y: targetY }, duration: 0.8, ease: 'power2.out' });
        }
      });
    });
  }

  window.addEventListener('load', initPharmaceuticalsProcessDiagram);
  document.addEventListener('astro:page-load', initPharmaceuticalsProcessDiagram);
</script>
