---
const steps = [
  {
    num: "01",
    title: "Brake & Parts Cleaner Formulations",
    img: "/images/auto/automotive_scroll_brake_cleaner.png",
    description: "Engineering of fast-evaporating, non-chlorinated solvent packages designed to aggressively solubilize grease, road grime, and brake fluid deposits while ensuring component compatibility.",
    badge: "Solvent Power"
  },
  {
    num: "02",
    title: "Penetrating Lubricants & Oils",
    img: "/images/auto/automotive_scroll_penetrating.png",
    description: "Formulation of high-capillary, low surface tension carrier systems combined with chemical anti-seize additives to penetrate rusted threads, displace moisture, and leave a durable film.",
    badge: "Capillary Flow"
  },
  {
    num: "03",
    title: "Carb & Throttle Body Solvents",
    img: "/images/auto/automotive_scroll_carb.png",
    description: "Developing aggressive, high-temperature cleaners targeting stubborn varnish, gum, and hard carbon deposits in internal combustion engines without damaging oxygen sensors or catalytic converters.",
    badge: "Carbon Removal"
  },
  {
    num: "04",
    title: "Valve & Swirl Optimization",
    img: "/images/auto/automotive_scroll_valve.png",
    description: "Selecting 360-degree continuous discharge valves, optimizing actuator spray patterns, and adjusting vapor tap ratios to ensure stable delivery across extreme engine bay angles.",
    badge: "Aerosol Mechanics"
  },
  {
    num: "05",
    title: "Eco-Friendly & Non-Flammable Propellants",
    img: "/images/auto/automotive_scroll_propellants.png",
    description: "Balancing carbon dioxide, nitrogen, and DME propellants to comply with regional VOC limitations and formulate non-flammable, safety-certified industrial shop sprays.",
    badge: "Propellant Safety"
  },
  {
    num: "06",
    title: "Commercial Scaling & Gassing House Setup",
    img: "/images/auto/automotive_scroll_scaleup.png",
    description: "Engineering custom plant layouts, selecting high-speed double-index filling lines, installing LPG/CO2 gassing houses, and setting up automated QC bath leak detectors.",
    badge: "Scale-Up & Plant Setup"
  }
];
---

<!-- 
  CRITICAL: Do NOT add overflow:hidden to .automotive-process-sticky-section or any ancestor.
  overflow:hidden breaks position:sticky on all child elements.
  The sticky sidebar REQUIRES a clear scroll context on the page body.
-->
<section class="automotive-process-sticky-section">
  <div class="process-grid-container">

    <!-- Left Column: Sticky Sidebar -->
    <div class="process-sidebar">
      <div class="sidebar-content">
        <span class="process-eyebrow">Engineering</span>
        <h2 class="process-main-title">
          {"Automotive Aerosol Technology".split(' ').map(word => (
            <span class="word-wrapper">
              {word.split('').map(char => (
                <span class="blue-char">{char}</span>
              ))}
            </span>
          ))}
        </h2>
        <p class="process-subtitle">
          Automotive aerosols integrate high-solvency hydrocarbons, specialized friction-reducing boundary additives, and precisely engineered propellant blends to deliver mechanical repairs, detailing, and maintenance sprays.
        </p>
        <div class="process-bullet-subs">
          <p class="sub-bullet">✦ Specialized cleaning & maintenance sprays</p>
          <p class="sub-bullet">✦ High-speed aerosol manufacturing design</p>
        </div>

        <!-- Horizontal Button Timeline (Desktop Only) -->
        <div class="process-timeline">
          {steps.map((step, index) => (
            <div class="timeline-step" data-step-index={index}>
              <div class="step-content">
                <span class="step-num">{step.num}</span>
                <span class="step-label">{step.title}</span>
              </div>
              <div class="step-arrow-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="step-arrow-icon">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Column: Scrolling Cards Stack -->
    <div class="process-cards-stack">

      <!-- Intro Card -->
      <div class="process-intro-card">
        <span class="tagline">Automotive Mastery</span>
        <h3 class="card-title-intro">
          {"From Concept to Filling".split(' ').map(word => (
            <span class="cw">
              {word.split('').map(char => (
                <span class="cc cc-dark">{char}</span>
              ))}
            </span>
          ))}
        </h3>
        <p>Explore a rigorous technical approach designed to build market-ready, high-performance automotive aerosol products.</p>
        <div class="scroll-instruction">
          <span class="scroll-dot"></span>
          <span>Scroll down to explore our engineering</span>
        </div>
      </div>

      <!-- Step Cards -->
      {steps.map((step, index) => (
        <div class="process-card" data-step-card={index}>

          <!-- Background Image -->
          <div class="card-image-wrapper">
            <img class="process-image" src={step.img} alt={step.title} loading="eager" />
            <div class="image-shade"></div>
          </div>

          <!-- Permanent Glassmorphism Content Panel -->
          <div class="card-glass">
            <!-- Top row: number + badge -->
            <div class="glass-toprow">
              <span class="glass-num">{step.num}</span>
              <span class="glass-badge">{step.badge}</span>
            </div>

            <!-- Animated Title -->
            <h3 class="step-title">
              {step.title.split(' ').map(word => (
                <span class="cw">
                  {word.split('').map(char => (
                    <span class="cc cc-white">{char}</span>
                  ))}
                </span>
              ))}
            </h3>

            <!-- Description -->
            <p class="glass-desc">{step.description}</p>

            <!-- CTA -->
            <a href="#contact" class="glass-action-btn">
              <span>Speak With Experts</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron-arrow">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </div>
      ))}

      <!-- Outro Card -->
      <div class="process-outro-card">
        <span class="outro-tag">Let's Collaborate</span>
        <h3 class="card-title-outro">
          {"Ready to scale your production?".split(' ').map(word => (
            <span class="cw">
              {word.split('').map(char => (
                <span class="cc cc-dark">{char}</span>
              ))}
            </span>
          ))}
        </h3>
        <p>Consult directly with Absar Khan to conduct a custom audit of your automotive formulations and filling setup.</p>
        <a href="#contact" class="outro-cta-btn">
          <span>Book Formulation Audit</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  /* ============================================================
     CRITICAL: No overflow:hidden on this section or its parents.
     overflow:hidden destroys position:sticky on all descendants.
     ============================================================ */

  .automotive-process-sticky-section {
    background-color: #ffffff;
    position: relative;
    width: 100%;
    margin: 0;
    box-sizing: border-box;
  }

  /* ============================================================
     GRID LAYOUT — Two columns, sticky left, scrolling right
     ============================================================ */

  .process-grid-container {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(40px, 5vw, 100px);
    width: 100%;
    margin: 0 auto;
    align-items: start;
    padding: 120px 5% 120px 5%;
    box-sizing: border-box;
  }

  /* ============================================================
     LEFT STICKY SIDEBAR
     ============================================================ */

  .process-sidebar {
    position: sticky;
    top: 140px;
    height: auto;
    align-self: start;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ============================================================
     SIDEBAR TYPOGRAPHY
     ============================================================ */

  .process-eyebrow {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 5px;
    color: var(--primary, #0968e5);
    font-weight: 700;
    margin-bottom: 14px;
  }

  .process-main-title {
    font-size: clamp(2.2rem, 3.5vw, 3.6rem);
    font-weight: 800;
    color: var(--text-primary, #0f172a);
    line-height: 1.1;
    margin: 0 0 20px 0;
    letter-spacing: -0.03em;
  }

  .word-wrapper {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.28em;
  }

  .blue-char {
    display: inline-block;
    opacity: 0;
    color: var(--text-primary, #0f172a);
    -webkit-text-fill-color: var(--text-primary, #0f172a);
  }

  .process-subtitle {
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    color: var(--text-muted, #475569);
    line-height: 1.7;
    margin: 0;
  }

  .process-bullet-subs {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 18px;
    margin-bottom: 8px;
  }

  .sub-bullet {
    font-size: 0.95rem;
    font-weight: 600;
    color: #0968e5;
    margin: 0;
  }

  /* ============================================================
     VERTICAL TIMELINE (Desktop)
     ============================================================ */

  /* ============================================================
     BUTTON ROW TIMELINE (Desktop)
     ============================================================ */

  .process-timeline {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    width: calc(100% + 48px);
    margin-left: -24px;
    margin-right: -24px;
    border-top: 2px solid rgba(15, 23, 42, 0.08);
    box-sizing: border-box;
  }

  .timeline-step {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 10px 20px;
    cursor: pointer;
    border-bottom: 2px solid rgba(15, 23, 42, 0.08);
    background: transparent;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    z-index: 2;
    user-select: none;
    box-sizing: border-box;
  }

  .step-content {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .step-num {
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    font-weight: 800;
    color: #94a3b8;
    -webkit-text-fill-color: #94a3b8;
    opacity: 0.8;
    transition: all 0.35s ease;
  }

  .step-label {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(0.7rem, 0.9vw, 0.82rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #0f172a;
    -webkit-text-fill-color: #0f172a;
    transition: all 0.35s ease;
  }

  .step-arrow-box {
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.15);
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    margin-left: auto;
  }

  .step-arrow-icon {
    width: 12px;
    height: 12px;
    color: #ffffff;
  }

  .timeline-step:hover {
    background-color: var(--primary, #0968e5);
    padding-left: 28px;
  }

  .timeline-step:hover .step-num,
  .timeline-step:hover .step-label {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  .timeline-step:hover .step-arrow-box {
    opacity: 1;
    transform: translateX(0);
  }

  .timeline-step.active .step-num,
  .timeline-step.active .step-label {
    color: var(--primary, #0968e5) !important;
    -webkit-text-fill-color: var(--primary, #0968e5) !important;
  }

  .process-timeline:not(:hover) .timeline-step.active {
    background-color: var(--primary, #0968e5);
    padding-left: 28px;
  }

  .process-timeline:not(:hover) .timeline-step.active .step-num,
  .process-timeline:not(:hover) .timeline-step.active .step-label {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  .process-timeline:not(:hover) .timeline-step.active .step-arrow-box {
    opacity: 1;
    transform: translateX(0);
  }

  /* ============================================================
     RIGHT CARDS STACK
     ============================================================ */

  .process-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-bottom: 0;
  }

  .process-intro-card,
  .process-card,
  .process-outro-card {
    width: 100%;
    height: 520px;
    border-radius: 28px;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    border: 1px solid #edf0f4;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  }

  /* ============================================================
     INTRO CARD
     ============================================================ */

  .process-intro-card {
    background: #f8fafc;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 52px 48px;
  }

  .process-intro-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(to right, var(--secondary, #00f2fe), var(--primary, #0968e5));
  }

  .tagline {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--primary, #0968e5);
    font-weight: 700;
    display: block;
    margin-bottom: 20px;
  }

  .cw {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.22em;
  }

  .cc {
    display: inline-block;
    opacity: 0;
  }

  .cc-white {
    color: #ffffff;
    -webkit-text-fill-color: #ffffff;
  }

  .cc-dark {
    color: var(--text-primary, #0f172a);
    -webkit-text-fill-color: var(--text-primary, #0f172a);
  }

  .process-intro-card h3 {
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    font-weight: 800;
    color: var(--text-primary, #0f172a);
    line-height: 1.2;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .process-intro-card p {
    font-size: 1rem;
    color: var(--text-muted, #475569);
    line-height: 1.65;
    margin: 0 0 32px 0;
  }

  .scroll-instruction {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-muted, #475569);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .scroll-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--primary, #0968e5);
    flex-shrink: 0;
    animation: automotivePulseGlow 1.8s ease infinite;
  }

  @keyframes automotivePulseGlow {
    0%   { transform: scale(0.9); opacity: 0.6; box-shadow: 0 0 0 0 rgba(9, 104, 229, 0.35); }
    70%  { transform: scale(1.2); opacity: 1;   box-shadow: 0 0 0 10px rgba(9, 104, 229, 0); }
    100% { transform: scale(0.9); opacity: 0.6; box-shadow: 0 0 0 0   rgba(9, 104, 229, 0); }
  }

  /* ============================================================
     STEP CARDS
     ============================================================ */

  .card-image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .process-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    transition: transform 10s linear;
  }

  .image-shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      rgba(5, 10, 24, 0.0) 0%,
      rgba(5, 10, 24, 0.15) 40%,
      rgba(5, 10, 24, 0.65) 70%,
      rgba(5, 10, 24, 0.88) 100%
    );
  }

  .card-glass {
    position: absolute;
    left: 14px;
    bottom: 14px;
    width: calc(100% - 28px);
    max-width: 360px;
    z-index: 10;
    background: rgba(8, 15, 38, 0.48);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 16px;
    padding: 16px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .glass-toprow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .glass-num {
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
  }

  .glass-badge {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #ffffff;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.1);
    padding: 3px 9px;
    border-radius: 99px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    white-space: nowrap;
  }

  .step-title {
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .glass-desc {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.5;
    margin: 0;
  }

  .glass-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 5px 12px 5px 10px;
    border-radius: 99px;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.72rem;
    text-decoration: none;
    margin-top: 2px;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    flex-shrink: 0;
    letter-spacing: 0.01em;
  }

  .glass-action-btn:hover {
    background: rgba(255, 255, 255, 0.24);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }

  .chevron-arrow {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .glass-action-btn:hover .chevron-arrow {
    transform: translate(2px, -2px);
  }

  /* ============================================================
     OUTRO CARD
     ============================================================ */

  .process-outro-card {
    background: linear-gradient(150deg, #f0f6ff 0%, #fafbff 100%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 52px 48px;
    position: relative;
  }

  .process-outro-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(to right, var(--primary, #0968e5), var(--secondary, #00f2fe));
  }

  .outro-tag {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--primary, #0968e5);
    font-weight: 700;
    display: block;
    margin-bottom: 20px;
  }

  .process-outro-card h3 {
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    font-weight: 800;
    color: var(--text-primary, #0f172a);
    line-height: 1.2;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .process-outro-card p {
    font-size: 1rem;
    color: var(--text-muted, #475569);
    line-height: 1.65;
    margin: 0 0 36px 0;
  }

  .outro-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: var(--primary, #0968e5);
    color: #ffffff;
    padding: 14px 28px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    align-self: flex-start;
    box-shadow: 0 8px 20px rgba(9, 104, 229, 0.2);
    transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .outro-cta-btn:hover {
    background: #0755c8;
    box-shadow: 0 12px 30px rgba(9, 104, 229, 0.3);
    transform: translateY(-2px);
  }

  .cta-arrow {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .outro-cta-btn:hover .cta-arrow {
    transform: translate(3px, -3px);
  }

  /* ============================================================
     MOBILE
     ============================================================ */

  @media (max-width: 991px) {
    .process-grid-container {
      display: flex;
      flex-direction: column;
      gap: 40px;
      padding: 60px 24px 80px;
    }

    .process-sidebar {
      position: static;
    }

    .process-timeline {
      display: none;
    }

    .process-cards-stack {
      gap: 28px;
      padding-bottom: 40px;
    }

    .process-intro-card,
    .process-card,
    .process-outro-card {
      height: 440px;
      border-radius: 22px;
    }

    .process-intro-card,
    .process-outro-card {
      padding: 36px 28px;
    }

    .process-intro-card h3,
    .process-outro-card h3,
    .step-title {
      font-size: 1.7rem;
    }

    .outro-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .process-grid-container {
      padding: 48px 16px 64px;
    }

    .process-intro-card,
    .process-card,
    .process-outro-card {
      height: 460px;
    }

    .process-intro-card,
    .process-outro-card {
      padding: 28px 24px;
    }

    .process-intro-card h3,
    .process-outro-card h3,
    .step-title {
      font-size: 1.5rem;
    }

    .glass-desc,
