    .process-outro-card p {
      font-size: 0.88rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import SplitType from "split-type";

  gsap.registerPlugin(ScrollTrigger);

  function initAutomotiveProcessParallax() {
    const isDesktop = window.innerWidth > 991;
    const section = document.querySelector(".automotive-process-sticky-section");
    if (!section) return;

    // Split text on main sidebar title
    const mainTitle = section.querySelector(".process-main-title");
    if (mainTitle && !mainTitle.querySelector(".blue-char")) {
      const words = (mainTitle.textContent || '').trim().split(' ');
      mainTitle.innerHTML = words.map(w => {
        return `<span class="word-wrapper">${w.split('').map(ch => `<span class="blue-char">${ch}</span>`).join('')}</span>`;
      }).join(' ');
    }

    // Clear old ScrollTrigger instances for safety
    ScrollTrigger.getAll().forEach((trigger) => {
      if (
        trigger.trigger === section ||
        (trigger.trigger as HTMLElement)?.classList?.contains("automotive-process-sticky-section")
      ) {
        trigger.kill();
      }
    });

    if (isDesktop) {
      // 1. Sidebar title text reveal
      const textRevealTl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 70%",
          toggleActions: "play none none reverse"
        }
      });

      textRevealTl.fromTo(".automotive-process-sticky-section .blue-char",
        { opacity: 0, x: -12, color: "#0968e5", webkitTextFillColor: "#0968e5" },
        {
          opacity: 1, x: 0,
          color: "#0968e5", webkitTextFillColor: "#0968e5",
          duration: 0.5, stagger: 0.015, ease: "power3.out"
        }
      )
      .to(".automotive-process-sticky-section .blue-char", {
        color: "#0f172a", webkitTextFillColor: "#0f172a",
        duration: 0.5, stagger: 0.015, ease: "power2.inOut"
      }, "-=0.25");

      // 2. Timeline Progress Bar Fill
      gsap.fromTo(
        "#automotive-timeline-progress-bar",
        { height: "0%" },
        {
          height: "100%",
          ease: "none",
          scrollTrigger: {
            trigger: ".process-cards-stack",
            start: "top 250px",
            end: "bottom bottom-=350px",
            scrub: true
          }
        }
      );

      // 3. Highlight timeline steps and trigger text-effects per card
      const stepCards = document.querySelectorAll(".process-card");
      const timelineSteps = document.querySelectorAll(".timeline-step");

      stepCards.forEach((card, idx) => {
        const title = card.querySelector(".step-title");
        const glass = card.querySelector(".card-glass");
        const img = card.querySelector(".process-image");

        let splitTitle: SplitType | null = null;
        if (title) {
          splitTitle = new SplitType(title as HTMLElement, { types: "words,chars" });
          gsap.set(splitTitle.chars, { opacity: 0, x: -10, color: "#00f2fe", webkitTextFillColor: "#00f2fe" });
        }

        gsap.set(glass, { opacity: 0.4, y: 15, scale: 0.98 });

        ScrollTrigger.create({
          trigger: card,
          start: "top 250px",
          end: "bottom 250px",
          onEnter: () => {
            timelineSteps.forEach(s => s.classList.remove("active"));
            timelineSteps[idx]?.classList.add("active");
            timelineSteps[idx]?.scrollIntoView({ behavior: "smooth", block: "nearest" });

            gsap.to(glass, { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: "power2.out" });
            if (splitTitle) {
              gsap.to(splitTitle.chars, { opacity: 1, x: 0, duration: 0.5, stagger: 0.015, ease: "power3.out" });
              gsap.to(splitTitle.chars, { color: "#ffffff", webkitTextFillColor: "#ffffff", duration: 0.5, stagger: 0.015, ease: "power2.inOut", delay: 0.15 });
            }
            if (img) gsap.to(img, { scale: 1, duration: 8, ease: "sine.out" });
          },
          onEnterBack: () => {
            timelineSteps.forEach(s => s.classList.remove("active"));
            timelineSteps[idx]?.classList.add("active");
            timelineSteps[idx]?.scrollIntoView({ behavior: "smooth", block: "nearest" });

            gsap.to(glass, { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: "power2.out" });
            if (splitTitle) {
              gsap.to(splitTitle.chars, { opacity: 1, x: 0, duration: 0.5, stagger: 0.015, ease: "power3.out" });
              gsap.to(splitTitle.chars, { color: "#ffffff", webkitTextFillColor: "#ffffff", duration: 0.5, stagger: 0.015, ease: "power2.inOut", delay: 0.15 });
            }
          },
          onLeave: () => {
            timelineSteps[idx]?.classList.remove("active");
            gsap.to(glass, { opacity: 0.4, y: 15, scale: 0.98, duration: 0.6, ease: "power2.out" });
            if (splitTitle) {
              gsap.to(splitTitle.chars, { opacity: 0, x: -10, duration: 0.4, ease: "power3.out" });
            }
            if (img) gsap.set(img, { scale: 1.05 });
          },
          onLeaveBack: () => {
            timelineSteps[idx]?.classList.remove("active");
            gsap.to(glass, { opacity: 0.4, y: 15, scale: 0.98, duration: 0.6, ease: "power2.out" });
            if (splitTitle) {
              gsap.to(splitTitle.chars, { opacity: 0, x: -10, duration: 0.4, ease: "power3.out" });
            }
            if (img) gsap.set(img, { scale: 1.05 });
          }
        });

        // Click on timeline steps to scroll directly to card
        timelineSteps[idx]?.addEventListener("click", () => {
          const y = card.getBoundingClientRect().top + window.scrollY - 110;
          window.scrollTo({ top: y, behavior: "smooth" });
        });
      });
    }

    ScrollTrigger.refresh();
  }

  // Load and transition handlers
  window.addEventListener("load", initAutomotiveProcessParallax);
  document.addEventListener("astro:page-load", initAutomotiveProcessParallax);
</script>
