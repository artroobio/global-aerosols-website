---
/**
 * Shared commercial "marketplace" block for product/component pages.
 * Renders: supply spec table (sizes/MOQ/lead time), certification badges,
 * a Request-a-Quote CTA, "industries we supply" links and related-product links.
 * Carries its own scoped styles so each product page stays lean.
 */
interface Col { header: string }
interface Props {
  eyebrow?: string;
  heading?: string;
  columns: string[];
  rows: string[][];
  note?: string;
  badges?: string[];
  ctaTitle?: string;
  ctaText?: string;
  industries?: { label: string; href: string }[];
  related?: { label: string; href: string }[];
}
const {
  eyebrow = 'Wholesale Supply',
  heading = 'Sizes, MOQ & Lead Times',
  columns,
  rows,
  note = 'MOQ and lead times are indicative — bulk, export and OEM terms available on request.',
  badges = [],
  ctaTitle = 'Get Bulk & Export Pricing',
  ctaText = 'Request a quote for wholesale supply — custom specs and contract filling included.',
  industries = [],
  related = [],
} = Astro.props as Props;
---

<section class="supply-block">
  <div class="supply-head">
    <span class="supply-eyebrow">{eyebrow}</span>
    <h2 class="supply-title">{heading}</h2>
    <div class="supply-bar"></div>
  </div>

  <div class="supply-table-wrap">
    <table class="supply-table">
      <thead>
        <tr>{columns.map(c => <th>{c}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map(r => <tr>{r.map(cell => <td>{cell}</td>)}</tr>)}
      </tbody>
    </table>
    <p class="supply-note">{note}</p>
  </div>

  {badges.length > 0 && (
    <div class="cert-badges">
      {badges.map(b => <span class="cert-badge">{b}</span>)}
    </div>
  )}

  <div class="quote-cta">
    <div class="quote-cta-text">
      <h3>{ctaTitle}</h3>
      <p>{ctaText}</p>
    </div>
    <a href="/contact/" class="quote-cta-btn">Request a Quote</a>
  </div>

  {industries.length > 0 && (
    <div class="supply-links-group">
      <span class="supply-eyebrow">Industries We Supply</span>
      <div class="supply-links">
        {industries.map(i => <a href={i.href}>{i.label}</a>)}
      </div>
    </div>
  )}

  {related.length > 0 && (
    <div class="supply-links-group">
      <span class="supply-eyebrow">Related Components</span>
      <div class="supply-links">
        {related.map(i => <a href={i.href}>{i.label}</a>)}
      </div>
    </div>
  )}
</section>

<style>
  .supply-block {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px 80px;
    font-family: 'Inter', 'Roboto', sans-serif;
    color: #0f172a;
  }
  .supply-head { text-align: center; margin-bottom: 40px; }
  .supply-eyebrow {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 3px;
    font-weight: 700; color: #0968e5; display: block; margin-bottom: 8px;
    font-family: 'Outfit', sans-serif;
  }
  .supply-title {
    font-family: 'Outfit', 'Montserrat', sans-serif; font-weight: 800;
    text-transform: uppercase; letter-spacing: -0.01em;
    font-size: clamp(1.6rem, 3vw, 2.3rem); color: #0f172a; margin: 0 0 16px;
  }
  .supply-bar { width: 60px; height: 4px; background: #0968e5; margin: 0 auto; border-radius: 2px; }

  .supply-table-wrap { overflow-x: auto; margin-bottom: 36px; }
  .supply-table {
    width: 100%; border-collapse: collapse; background: #fff;
    border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;
    font-size: 0.9rem; min-width: 640px;
  }
  .supply-table th {
    background: #0f172a; color: #fff; text-align: left; padding: 14px 18px;
    font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 0.78rem;
    text-transform: uppercase; letter-spacing: 0.5px;
  }
  .supply-table td { padding: 14px 18px; border-top: 1px solid #f1f5f9; color: #475569; }
  .supply-table tbody tr:hover { background: #f8fafc; }
  .supply-table td:first-child { font-weight: 700; color: #0f172a; }
  .supply-note { font-size: 0.8rem; color: #94a3b8; margin: 12px 4px 0; font-style: italic; }

  .cert-badges {
    display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-bottom: 44px;
  }
  .cert-badge {
    font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 0.78rem;
    color: #0968e5; background: rgba(9, 104, 229, 0.08);
    border: 1px solid rgba(9, 104, 229, 0.25); padding: 8px 16px; border-radius: 50px;
    text-transform: uppercase; letter-spacing: 0.5px;
  }

  .quote-cta {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    flex-wrap: wrap; background: #0f172a; border-radius: 16px; padding: 36px 40px;
    border-left: 6px solid #0968e5; margin-bottom: 44px;
  }
  .quote-cta-text h3 {
    font-family: 'Outfit', sans-serif; font-weight: 800; color: #fff;
    font-size: 1.4rem; margin: 0 0 6px; text-transform: uppercase;
  }
  .quote-cta-text p { color: #94a3b8; margin: 0; font-size: 0.95rem; max-width: 560px; }
  .quote-cta-btn {
    flex-shrink: 0; background: #0968e5; color: #fff; text-decoration: none;
    font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 0.9rem;
    text-transform: uppercase; letter-spacing: 1px; padding: 16px 32px;
    border-radius: 10px; transition: background 0.25s, transform 0.25s;
  }
  .quote-cta-btn:hover { background: #2563eb; transform: translateY(-2px); }

  .supply-links-group { text-align: center; margin-bottom: 28px; }
  .supply-links { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 12px; }
  .supply-links a {
    font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 0.85rem;
    color: #0f172a; text-decoration: none; background: #fff;
    border: 1px solid #e2e8f0; padding: 10px 18px; border-radius: 8px;
    transition: all 0.25s;
  }
  .supply-links a:hover { border-color: #0968e5; color: #0968e5; transform: translateY(-2px); }

  @media (max-width: 768px) {
    .supply-block { padding-left: 20px; padding-right: 20px; }
    .quote-cta { padding: 28px 24px; }
  }
</style>
