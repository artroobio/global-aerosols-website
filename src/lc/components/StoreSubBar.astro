---
interface Props {
  user?: {
    id: string;
    name: string;
    email: string;
    avatar_url: string | null;
  } | null;
  q?: string;
}
const { user, q = '' } = Astro.props;
---

<div class="store-sub-bar">

  <!-- E-Books label -->
  <a href="/store" class="sub-store-link">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 19.5A2.5 2.5 0 016.5 17H20"/>
      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>
    </svg>
    <div class="sub-text-stack">
      <span class="sub-label">Technical</span>
      <span class="sub-value">E-Books</span>
    </div>
  </a>

  <!-- Search -->
  <form class="sub-search-form" action="/store/search" method="get" role="search">
    <div class="sub-search-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" width="15" height="15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
      <input
        id="sub-search-input"
        type="search"
        name="q"
        value={q}
        placeholder="Search formulation handbooks..."
        autocomplete="off"
        spellcheck="false"
        class="sub-search-input"
      />
      <button type="submit" class="sub-search-btn">Search</button>
    </div>
    <ul class="sub-search-dropdown" id="sub-search-dropdown"></ul>
  </form>

  <!-- Account -->
  <div class="sub-divider"></div>
  <div class="sub-account">
    {user ? (
      <div class="sub-user-menu" id="sub-user-menu">
        <button class="sub-account-btn" id="sub-account-btn" type="button">
          {user.avatar_url
            ? <img src={user.avatar_url} alt={user.name} class="sub-avatar" />
            : <span class="sub-initial">{user.name[0].toUpperCase()}</span>
          }
          <div class="sub-text-stack">
            <span class="sub-label">My Account</span>
            <span class="sub-value">{user.name.split(' ')[0]}</span>
          </div>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="11" height="11" stroke-linecap="round" stroke-linejoin="round" class="sub-caret">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>
        <ul class="sub-dropdown" id="sub-user-dropdown">
          <li><a href="/dashboard">My Library</a></li>
          <li><a href="/store">Browse Books</a></li>
          <li class="sub-dropdown-sep"></li>
          <li>
            <form action="/api/auth/logout" method="POST">
              <button type="submit" class="sub-signout-btn">Sign Out</button>
            </form>
          </li>
        </ul>
      </div>
    ) : (
      <a href="/login" class="sub-account-btn sub-signin-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <div class="sub-text-stack">
          <span class="sub-label">Hello, Guest</span>
          <span class="sub-value">Sign In</span>
        </div>
      </a>
    )}
  </div>

  <!-- Cart -->
  <div class="sub-divider"></div>
  <a href="/cart" class="sub-cart" id="sub-cart-link">
    <div class="sub-cart-icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 11V7a4 4 0 00-8 0v4"/>
        <path d="M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span class="sub-cart-badge" id="sub-cart-badge">0</span>
    </div>
    <div class="sub-text-stack">
      <span class="sub-label" id="sub-cart-label">0 items</span>
      <span class="sub-value" id="sub-cart-total">₹0</span>
    </div>
  </a>

</div>

<script>
  function updateSubCart() {
    const cart: Array<{ price_inr: number }> = JSON.parse(localStorage.getItem('gf_cart') || '[]');
    const count = cart.length;
    const total = cart.reduce((sum, item) => sum + item.price_inr, 0);

    const badge   = document.getElementById('sub-cart-badge');
    const label   = document.getElementById('sub-cart-label');
    const totalEl = document.getElementById('sub-cart-total');
    const link    = document.getElementById('sub-cart-link');

    if (badge)   { badge.textContent = String(count); badge.classList.toggle('has-items', count > 0); }
    if (label)   label.textContent = `${count} item${count !== 1 ? 's' : ''}`;
    if (totalEl) totalEl.textContent = count > 0 ? `₹${(total / 100).toLocaleString('en-IN')}` : '₹0';
    if (link)    link.classList.toggle('has-items', count > 0);
  }

  updateSubCart();
  window.addEventListener('storage', updateSubCart);
  window.addEventListener('gf-cart-updated', updateSubCart);

  // ── Live search dropdown ────────────────────────────────────────────────────
  const searchInput    = document.getElementById('sub-search-input') as HTMLInputElement | null;
  const searchDropdown = document.getElementById('sub-search-dropdown');

  let debounceTimer: ReturnType<typeof setTimeout>;

  function closeDropdown() {
    searchDropdown?.classList.remove('open');
    if (searchDropdown) searchDropdown.innerHTML = '';
  }

  searchInput?.addEventListener('input', async () => {
    const q = searchInput.value.trim();
    if (q.length < 1) { closeDropdown(); return; }

    try {
        const res  = await fetch(`/api/books/search?q=${encodeURIComponent(q)}`);
        const books: Array<{ slug: string; title: string; cover_image: string | null; price_inr: number }> = await res.json();

        if (!searchDropdown) return;
        searchDropdown.innerHTML = '';

        if (books.length === 0) {
          searchDropdown.innerHTML = `<li class="sub-dd-empty">No results for "${q}"</li>`;
        } else {
          books.forEach(book => {
            const li  = document.createElement('li');
            const url = `/store/search?q=${encodeURIComponent(book.title)}`;
            const priceDisplay = `₹${(book.price_inr / 100).toLocaleString('en-IN')}`;
            const thumb = book.cover_image
              ? `<img src="${book.cover_image}" alt="" style="width:36px;height:36px;border-radius:5px;object-fit:cover;flex-shrink:0;" />`
              : `<div style="width:36px;height:36px;border-radius:5px;background:#EEF4FD;display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:700;color: #0968e5;flex-shrink:0;">GF</div>`;
            li.innerHTML = `<a href="${url}" style="display:flex;align-items:center;gap:12px;padding:10px 14px;text-decoration:none;color:#0A0A0A;">${thumb}<span style="flex:1;font-size:0.86rem;font-weight:600;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${book.title}</span><span style="font-size:0.8rem;font-weight:700;color: #0968e5;flex-shrink:0;">${priceDisplay}</span></a>`;
            searchDropdown.appendChild(li);
          });
        }

        searchDropdown.classList.add('open');
      } catch { /* silently ignore */ }
  });

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDropdown();
  });

  document.addEventListener('click', (e) => {
    if (searchDropdown && !searchDropdown.closest('form')?.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  // Account dropdown
  const accountBtn = document.getElementById('sub-account-btn');
  const userMenu   = document.getElementById('sub-user-menu');

  accountBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    userMenu?.classList.toggle('open');
  });

  document.addEventListener('click', (e) => {
    if (userMenu && !userMenu.contains(e.target as Node)) {
      userMenu.classList.remove('open');
    }
  });
</script>

<style>
  .store-sub-bar {
    position: sticky;
    top: 60px;
    z-index: 900;
    background: #fff;
    border-bottom: 1px solid #E4E4E0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    display: flex;
    align-items: center;
    height: 54px;
    padding: 0 max(4%, 24px);
    box-sizing: border-box;
  }

  /* ── Store label ── */
  .sub-store-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #0A0A0A;
    padding-right: 20px;
    flex-shrink: 0;
    height: 100%;
  }
  .sub-store-link svg { color: #0968e5; flex-shrink: 0; }
  .sub-store-link:hover .sub-value { color: #0968e5; }

  /* ── Search ── */
  .sub-search-form {
    flex: 1;
    min-width: 0;
    padding: 0 20px;
    position: relative;
  }
  .sub-search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #F7F7F5;
    border: 1.5px solid #E4E4E0;
    border-radius: 8px;
    padding: 0 6px 0 12px;
    height: 36px;
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
  }
  .sub-search-wrap:focus-within {
    border-color: #0968e5;
    box-shadow: 0 0 0 3px rgba(9, 104, 229,0.1);
    background: #fff;
  }
  .sub-search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    font-size: 0.88rem;
    color: #0A0A0A;
    outline: none;
    font-family: inherit;
  }
  .sub-search-input::placeholder { color: #9CA3AF; }
  .sub-search-btn {
    flex-shrink: 0;
    background: #0968e5;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 0.76rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    padding: 0 12px;
    height: 26px;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .sub-search-btn:hover { opacity: 0.88; }

  /* ── Search dropdown ── */
  .sub-search-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: #fff;
    border: 1px solid #E4E4E0;
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
    list-style: none;
    margin: 0;
    padding: 6px 0;
    z-index: 1000;
    display: none;
  }
  .sub-search-dropdown.open { display: block; }

  .sub-search-dropdown li a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    text-decoration: none;
    color: #0A0A0A;
    transition: background 0.12s;
  }
  .sub-search-dropdown li a:hover { background: #F4F4F2; }

  .sub-dd-thumb {
    width: 36px;
    height: 36px;
    border-radius: 5px;
    object-fit: cover;
    flex-shrink: 0;
    background: #EEF4FD;
  }
  .sub-dd-thumb-placeholder {
    width: 36px;
    height: 36px;
    border-radius: 5px;
    background: #EEF4FD;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 700;
    color: #0968e5;
    flex-shrink: 0;
  }
  .sub-dd-title {
    flex: 1;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.3;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sub-dd-price {
    font-size: 0.8rem;
    font-weight: 700;
    color: #0968e5;
    flex-shrink: 0;
  }
  .sub-dd-empty {
    padding: 14px 16px;
    font-size: 0.86rem;
    color: #9CA3AF;
    text-align: center;
  }

  /* ── Shared text stack ── */
  .sub-text-stack {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .sub-label {
    font-size: 0.67rem;
    color: #9CA3AF;
    white-space: nowrap;
  }
  .sub-value {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0A0A0A;
    white-space: nowrap;
  }

  /* ── Dividers ── */
  .sub-divider {
    width: 1px;
    height: 30px;
    background: #E4E4E0;
    flex-shrink: 0;
  }

  /* ── Account ── */
  .sub-account { position: relative; }

  .sub-account-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 54px;
    padding: 0 18px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    color: #0A0A0A;
    text-decoration: none;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .sub-account-btn:hover { background: #F7F7F5; }

  .sub-signin-link { display: flex; }

  .sub-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .sub-initial {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #0968e5;
    color: #fff;
    font-size: 0.76rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sub-caret {
    color: #9CA3AF;
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .sub-user-menu.open .sub-caret { transform: rotate(180deg); }

  /* Account dropdown */
  .sub-dropdown {
    position: absolute;
    top: calc(100% + 2px);
    right: 0;
    min-width: 185px;
    background: #fff;
    border: 1px solid #E4E4E0;
    border-radius: 10px;
    padding: 6px 0;
    list-style: none;
    margin: 0;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
    z-index: 200;
  }
  .sub-user-menu.open .sub-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .sub-dropdown a,
  .sub-signout-btn {
    display: block;
    width: 100%;
    padding: 9px 16px;
    font-size: 0.88rem;
    color: #374151;
    text-decoration: none;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    box-sizing: border-box;
    transition: background 0.15s;
  }
  .sub-dropdown a:hover { background: #F7F7F5; color: #0A0A0A; }
  .sub-signout-btn { color: #EF4444; }
  .sub-signout-btn:hover { background: #FEF2F2 !important; }
  .sub-dropdown-sep { height: 1px; background: #F0F0EE; margin: 4px 0; }

  /* ── Cart ── */
  .sub-cart {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 54px;
    padding: 0 0 0 18px;
    text-decoration: none;
    color: #0A0A0A;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .sub-cart:hover { background: #F7F7F5; }
  .sub-cart-icon-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .sub-cart-badge {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #D1D5DB;
    color: #6B7280;
    font-size: 0.58rem;
    font-weight: 700;
    min-width: 16px;
    height: 16px;
    border-radius: 8px;
    padding: 0 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid #fff;
    box-sizing: border-box;
    transition: background 0.2s, color 0.2s;
  }
  .sub-cart-badge.has-items { background: #0968e5; color: #fff; }
  .sub-cart.has-items .sub-value { color: #0968e5; }

  /* ── Mobile: hide on small screens ── */
  @media (max-width: 768px) {
    .store-sub-bar { display: none; }
  }
</style>
