---
const steps = [
  {
    num: "01",
    title: "Custom Adhesive & Sealant Formulation",
    img: "/images/adhesives/adhesives_scroll_formulation.webp",
    description: "Development of structural adhesives, silicone sealants, polyurethane systems, epoxy formulations, acrylic adhesives, and specialty bonding solutions tailored to automotive, construction, aerospace, and industrial applications.",
    badge: "Custom Formulation"
  },
  {
    num: "02",
    title: "Reverse Engineering & Benchmarking",
    img: "/images/adhesives/adhesives_scroll_reverse.webp",
    description: "Analysis of competitor adhesives and sealants including polymer composition, crosslinking chemistry, filler systems, rheology modifiers, adhesion promoters, and performance additive reconstruction.",
    badge: "Reverse Engineering"
  },
  {
    num: "03",
    title: "Performance Enhancement & Optimization",
    img: "/images/adhesives/adhesives_scroll_additives.webp",
    description: "Fine-tuning of rheology modifiers, adhesion promoters, plasticizers, UV stabilizers, catalysts, fillers, and crosslinking agents for maximum bond strength, flexibility, durability, and environmental resistance.",
    badge: "Performance Tuning"
  },
  {
    num: "04",
    title: "Private Label & Packaging Support",
    img: "/images/adhesives/adhesives_scroll_packaging.webp",
    description: "Complete manufacturing support including formulation specs, SDS & TDS creation, cartridge and tube packaging selection, dispensing systems, labeling, and regulatory compliance for construction, automotive, and industrial adhesives.",
    badge: "Private Label"
  },
  {
    num: "05",
    title: "Cost Optimization & Raw Material Substitution",
    img: "/images/adhesives/adhesives_scroll_cost.webp",
    description: "Reduce manufacturing cost by optimizing polymer selection, filler systems, plasticizer alternatives, and catalyst efficiency while maintaining or improving adhesion, cure time, and mechanical properties.",
    badge: "Cost Optimization"
  },
  {
    num: "06",
    title: "Scale-Up, Plant Setup & Production Transfer",
    img: "/images/adhesives/adhesives_scroll_scaleup.webp",
    description: "Guidance for mixing equipment selection, dispersion control, degassing systems, filling lines, QC parameters, and seamless transition from lab batch to commercial-scale adhesive and sealant production.",
    badge: "Scale-Up & Plant Setup"
  }
];
---

<!-- 
  CRITICAL: Do NOT add overflow:hidden to .paints-process-sticky-section or any ancestor.
  overflow:hidden breaks position:sticky on all child elements.
  The sticky sidebar REQUIRES a clear scroll context on the page body.
-->
<section class="paints-process-sticky-section">
  <div class="process-grid-container">

    <!-- Left Column: Sticky Sidebar -->
    <div class="process-sidebar">
      <div class="sidebar-content">
        <span class="process-eyebrow">Engineering</span>
        <h2 class="process-main-title">
          {"Advanced Adhesive & Sealant Technology Solutions".split(' ').map(word => (
            <span class="word-wrapper">
              {word.split('').map(char => (
                <span class="blue-char">{char}</span>
              ))}
            </span>
          ))}
        </h2>
        <p class="process-subtitle">
          Paints and coatings integrate resins, pigments, solvents, plasticizers, additives, and performance modifiers to deliver superior gloss, adhesion, durability, chemical resistance, corrosion protection, and long-lasting appearance across automotive, industrial, architectural, and specialty applications.
        </p>
        <div class="process-bullet-subs">
          <p class="sub-bullet">✦ Advanced formulation development</p>
          <p class="sub-bullet">✦ High-performance surface protection</p>
        </div>

        <!-- Vertical Interactive Timeline (Desktop Only) -->
        <div class="process-timeline">
          <div class="timeline-line">
            <div class="timeline-progress" id="timeline-progress-bar"></div>
          </div>
          {steps.map((step, index) => (
            <div class="timeline-step" data-step-index={index}>
              <div class="step-indicator">
                <span class="step-num-label">{step.num}</span>
              </div>
              <span class="step-label-title">{step.title}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Column: Scrolling Cards Stack -->
    <div class="process-cards-stack">

      <!-- Intro Card -->
      <div class="process-intro-card">
        <span class="tagline">Formulation Mastery</span>
        <h3 class="card-title-intro">
          {"From Lab to Market".split(' ').map(word => (
            <span class="cw">
              {word.split('').map(char => (
                <span class="cc cc-dark">{char}</span>
              ))}
            </span>
          ))}
        </h3>
        <p>Experience a systematic engineering approach built specifically for modern architectural, industrial, and automotive coatings.</p>
        <div class="scroll-instruction">
          <span class="scroll-dot"></span>
          <span>Scroll down to explore our engineering</span>
        </div>
      </div>

      <!-- Step Cards -->
      {steps.map((step, index) => (
        <div class="process-card" data-step-card={index}>

          <!-- Background Image (always crisp) -->
          <div class="card-image-wrapper">
            <img class="process-image" src={step.img} alt={step.title} loading="eager" />
            <div class="image-shade"></div>
          </div>

          <!-- Permanent Glassmorphism Content Panel -->
          <div class="card-glass">
            <!-- Top row: number + badge -->
            <div class="glass-toprow">
              <span class="glass-num">{step.num}</span>
              <span class="glass-badge">{step.badge}</span>
            </div>

            <!-- Animated Title -->
            <h3 class="step-title">
              {step.title.split(' ').map(word => (
                <span class="cw">
                  {word.split('').map(char => (
                    <span class="cc cc-white">{char}</span>
                  ))}
                </span>
              ))}
            </h3>

            <!-- Description -->
            <p class="glass-desc">{step.description}</p>

            <!-- CTA -->
            <a href="#contact" class="glass-action-btn">
              <span>Speak With Experts</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="chevron-arrow">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </div>
      ))}

      <!-- Outro Card -->
      <div class="process-outro-card">
        <span class="outro-tag">Let's Collaborate</span>
        <h3 class="card-title-outro">
          {"Ready to start your synthesis?".split(' ').map(word => (
            <span class="cw">
              {word.split('').map(char => (
                <span class="cc cc-dark">{char}</span>
              ))}
            </span>
          ))}
        </h3>
        <p>Consult directly with Absar Khan to conduct a custom audit of your formulations and production setup.</p>
        <a href="#contact" class="outro-cta-btn">
          <span>Book Formulation Audit</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  /* ============================================================
     CRITICAL: No overflow:hidden on this section or its parents.
     overflow:hidden destroys position:sticky on all descendants.
     ============================================================ */

  .paints-process-sticky-section {
    background-color: #ffffff;
    position: relative;
    width: 100%;
    margin: 0;
    box-sizing: border-box;
    /* NO overflow:hidden here - it breaks sticky positioning */
  }

  /* ============================================================
     GRID LAYOUT — Two columns, sticky left, scrolling right
     ============================================================ */

  .process-grid-container {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(40px, 5vw, 100px);
    width: 100%;
    margin: 0 auto;
    align-items: start; /* MUST be start for sticky to work, not center/stretch */
    padding: 120px 5% 120px 5%;
    box-sizing: border-box;
  }

  /* ============================================================
     LEFT STICKY SIDEBAR
     position:sticky requires:
       1. No overflow:hidden on any ancestor
       2. Parent must have align-items:start (not center)
       3. Parent must be taller than the sticky element
     ============================================================ */

  .process-sidebar {
    position: sticky;
    top: 140px; /* clears the ~80px navbar with breathing room */
    height: auto; /* NOT max-content — let it size naturally */
    align-self: start; /* override any inherited alignment */
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ============================================================
     SIDEBAR TYPOGRAPHY
     ============================================================ */

  .process-eyebrow {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 5px;
    color: var(--primary, #0968e5);
    font-weight: 700;
    margin-bottom: 14px;
  }

  .process-main-title {
    font-size: clamp(2.2rem, 3.5vw, 3.6rem);
    font-weight: 800;
    color: var(--text-primary, #0f172a);
    line-height: 1.1;
    margin: 0 0 20px 0;
    letter-spacing: -0.03em;
  }

  /* Character animation wrappers — matches site-wide title pattern */
  .word-wrapper {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.28em;
  }

  .blue-char {
    display: inline-block;
    opacity: 0;
    color: var(--text-primary, #0f172a);
    -webkit-text-fill-color: var(--text-primary, #0f172a);
  }

  .process-subtitle {
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    color: var(--text-muted, #475569);
    line-height: 1.7;
    margin: 0;
  }

  .process-bullet-subs {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 18px;
    margin-bottom: 8px;
  }

  .sub-bullet {
    font-size: 0.95rem;
    font-weight: 600;
    color: #0968e5;
    margin: 0;
  }

  /* ============================================================
     VERTICAL TIMELINE (Desktop)
     ============================================================ */

  .process-timeline {
    margin-top: 44px;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-left: 4px;
  }

  /* The vertical line track behind the dots */
  .timeline-line {
    position: absolute;
    left: 15px; /* centres behind the 24px dot circle */
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: #e8ecf0;
    border-radius: 99px;
    overflow: hidden;
    z-index: 1;
  }

  /* The fill that animates with scroll */
  .timeline-progress {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: linear-gradient(to bottom, var(--primary, #0968e5), var(--secondary, #00f2fe));
  }

    .timeline-step {
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    transition: transform 0.35s ease;
    position: relative;
    z-index: 2;
    user-select: none;
  }

  .timeline-step.active {
    transform: translateX(6px);
  }

  /* Fade text and indicator for inactive steps, keeping the step-indicator's background fully opaque white! */
  .timeline-step:not(.active) .step-indicator {
    border-color: rgba(209, 213, 219, 0.4);
  }

  .timeline-step:not(.active) .step-num-label {
    opacity: 0.4;
  }

  .timeline-step:not(.active) .step-label-title {
    opacity: 0.4;
  }

  /* Circle dot */
  .step-indicator {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #d1d5db;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    transition: border-color 0.35s ease, background 0.35s ease, box-shadow 0.35s ease;
  }

  .step-num-label {
    font-size: 0.6rem;
    font-weight: 800;
    color: #94a3b8;
    font-family: 'Outfit', sans-serif;
    transition: color 0.35s ease;
    line-height: 1;
  }

  .step-label-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #94a3b8;
    font-family: 'Outfit', sans-serif;
    transition: color 0.35s ease;
  }

  /* Active state overrides */
  .timeline-step.active .step-indicator {
    border-color: var(--primary, #0968e5);
    background: var(--primary, #0968e5);
    box-shadow: 0 0 0 4px rgba(9, 104, 229, 0.12);
  }

  .timeline-step.active .step-num-label {
    color: #ffffff;
  }

  .timeline-step.active .step-label-title {
    color: var(--text-primary, #0f172a);
    font-weight: 700;
  }

  /* ============================================================
     RIGHT CARDS STACK
     ============================================================ */

  .process-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-bottom: 0;
  }

  /* Shared card base */
  .process-intro-card,
  .process-card,
  .process-outro-card {
    width: 100%;
    height: 520px;
    border-radius: 28px;
    box-sizing: border-box;
    position: relative;
    overflow: hidden; /* OK on individual cards */
    border: 1px solid #edf0f4;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  }

  /* ============================================================
     INTRO CARD
     ============================================================ */

  .process-intro-card {
    background: #f8fafc;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 52px 48px;
  }

  .process-intro-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(to right, var(--secondary, #00f2fe), var(--primary, #0968e5));
  }

  .tagline {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--primary, #0968e5);
    font-weight: 700;
    display: block;
    margin-bottom: 20px;
  }

  /* Card title character-animation wrappers */
  .cw {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.22em;
  }

  .cc {
    display: inline-block;
    opacity: 0;
  }

  /* Dark-background cards: chars end white */
  .cc-white {
    color: #ffffff;
    -webkit-text-fill-color: #ffffff;
  }

  /* Light-background cards: chars end dark */
  .cc-dark {
    color: var(--text-primary, #0f172a);
    -webkit-text-fill-color: var(--text-primary, #0f172a);
  }

  .process-intro-card h3 {
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    font-weight: 800;
    color: var(--text-primary, #0f172a);
    line-height: 1.2;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .process-intro-card p {
    font-size: 1rem;
    color: var(--text-muted, #475569);
    line-height: 1.65;
    margin: 0 0 32px 0;
  }

  .scroll-instruction {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-muted, #475569);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .scroll-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--primary, #0968e5);
    flex-shrink: 0;
    animation: pulseGlow 1.8s ease infinite;
  }

  @keyframes pulseGlow {
    0%   { transform: scale(0.9); opacity: 0.6; box-shadow: 0 0 0 0 rgba(9, 104, 229, 0.35); }
    70%  { transform: scale(1.2); opacity: 1;   box-shadow: 0 0 0 10px rgba(9, 104, 229, 0); }
    100% { transform: scale(0.9); opacity: 0.6; box-shadow: 0 0 0 0   rgba(9, 104, 229, 0); }
  }

  /* ============================================================
     STEP CARDS — image always crisp, content in permanent glass panel
     ============================================================ */

  .card-image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .process-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05); /* slight zoom so it feels rich */
    transition: transform 10s linear; /* very slow passive drift — no hover state */
  }

  /* Gradient shade: lighter top, heavier bottom to contrast glass panel */
  .image-shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      rgba(5, 10, 24, 0.0)  0%,
      rgba(5, 10, 24, 0.15) 40%,
      rgba(5, 10, 24, 0.65) 70%,
      rgba(5, 10, 24, 0.88) 100%
    );
  }

  /* ============================================================
     PERMANENT GLASSMORPHISM CONTENT PANEL
     ============================================================ */

  .card-glass {
    position: absolute;
    left: 14px;
    bottom: 14px;
    width: calc(100% - 28px);
    max-width: 360px; /* less than half of the card width */
    z-index: 10;
    background: rgba(8, 15, 38, 0.48);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 16px;
    padding: 16px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  /* Top row: number on left, badge pill on right */
  .glass-toprow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .glass-num {
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
  }

  .glass-badge {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #ffffff;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.1);
    padding: 3px 9px;
    border-radius: 99px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    white-space: nowrap;
  }

  /* Step title inside glass panel */
  .step-title {
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* Description */
  .glass-desc {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.5;
    margin: 0;
  }

  /* CTA — compact inline pill */
  .glass-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 5px 12px 5px 10px;
    border-radius: 99px;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.72rem;
    text-decoration: none;
    margin-top: 2px;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    flex-shrink: 0;
    letter-spacing: 0.01em;
  }

  .glass-action-btn:hover {
    background: rgba(255, 255, 255, 0.24);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }

  .chevron-arrow {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .glass-action-btn:hover .chevron-arrow {
    transform: translate(2px, -2px);
  }

  /* ============================================================
     OUTRO CARD
     ============================================================ */

  .process-outro-card {
    background: linear-gradient(150deg, #f0f6ff 0%, #fafbff 100%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 52px 48px;
    position: relative;
  }

  .process-outro-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(to right, var(--primary, #0968e5), var(--secondary, #00f2fe));
  }

  .outro-tag {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--primary, #0968e5);
    font-weight: 700;
    display: block;
    margin-bottom: 20px;
  }

  .process-outro-card h3 {
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    font-weight: 800;
    color: var(--text-primary, #0f172a);
    line-height: 1.2;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .process-outro-card p {
    font-size: 1rem;
    color: var(--text-muted, #475569);
    line-height: 1.65;
    margin: 0 0 36px 0;
  }

  .outro-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: var(--primary, #0968e5);
    color: #ffffff;
    padding: 14px 28px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    align-self: flex-start;
    box-shadow: 0 8px 20px rgba(9, 104, 229, 0.2);
    transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .outro-cta-btn:hover {
    background: #0755c8;
    box-shadow: 0 12px 30px rgba(9, 104, 229, 0.3);
    transform: translateY(-2px);
  }

  .cta-arrow {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .outro-cta-btn:hover .cta-arrow {
    transform: translate(3px, -3px);
  }

  /* ============================================================
     MOBILE — Single column stack
     max-width: 991px
     ============================================================ */

  @media (max-width: 991px) {
    .process-grid-container {
      display: flex;
      flex-direction: column;
      gap: 40px;
      padding: 60px 24px 80px;
    }

    .process-sidebar {
      position: static; /* not sticky on mobile */
    }

    .process-timeline {
      display: none; /* hidden on mobile */
    }

    .process-cards-stack {
      gap: 28px;
      padding-bottom: 40px;
    }

    .process-intro-card,
    .process-card,
    .process-outro-card {
      height: 440px;
      border-radius: 22px;
    }

    .process-intro-card,
    .process-outro-card {
      padding: 36px 28px;
    }

    .card-front {
      padding: 28px 32px;
    }

    .card-glass-back {
      inset: 12px;
      padding: 22px 24px;
    }

    .process-intro-card h3,
    .process-outro-card h3,
    .step-title,
    .glass-title {
      font-size: 1.7rem;
    }

    .outro-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }

  /* ============================================================
     SMALL MOBILE — max-width: 480px
     ============================================================ */

  @media (max-width: 480px) {
    .process-grid-container {
      padding: 48px 16px 64px;
    }

    .process-intro-card,
    .process-card,
    .process-outro-card {
      height: 460px;
    }

    .process-intro-card,
    .process-outro-card {
      padding: 28px 24px;
    }

    .card-front {
      padding: 24px;
    }

    .card-glass-back {
      inset: 10px;
      padding: 18px 20px;
    }

    .process-intro-card h3,
    .process-outro-card h3,
    .step-title,
    .glass-title {
      font-size: 1.5rem;
    }

    .glass-desc,
    .process-intro-card p,
    .process-outro-card p {
      font-size: 0.88rem;
    }
  }

  @media (max-height: 900px) and (min-width: 992px) {
    .process-grid-container {
      padding-top: 80px;
      padding-bottom: 80px;
    }
    .process-sidebar {
      top: 90px;
    }
    .process-main-title {
      margin-bottom: 12px;
      font-size: clamp(1.8rem, 2.5vw, 2.8rem);
    }
    .process-subtitle {
      font-size: 0.9rem;
      line-height: 1.5;
    }
    .process-bullet-subs {
      margin-top: 12px;
      margin-bottom: 4px;
      gap: 4px;
    }
    .sub-bullet {
      font-size: 0.85rem;
    }
    .process-timeline {
      margin-top: 20px;
      gap: 14px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initProcessStickyScroll() {

    // ── 1. SIDEBAR ENTRANCE ANIMATIONS ──────────────────────────

    const section = document.querySelector(".paints-process-sticky-section");
    if (!section) return;

    // Eyebrow fade-up
    gsap.fromTo(
      section.querySelector(".process-eyebrow"),
      { opacity: 0, y: 16 },
      {
        opacity: 1, y: 0,
        duration: 0.7,
        ease: "power3.out",
        scrollTrigger: { trigger: section, start: "top 78%" }
      }
    );

    // Title: characters slide in as blue then transition to dark — matches every other section
    const titleTl = gsap.timeline({
      scrollTrigger: { trigger: section, start: "top 78%" }
    });
    titleTl
      .fromTo(
        section.querySelectorAll(".process-main-title .blue-char"),
        { opacity: 0, x: -12, color: "#0968e5", webkitTextFillColor: "#0968e5" },
        {
          opacity: 1, x: 0,
          color: "#0968e5",
          webkitTextFillColor: "#0968e5",
          duration: 0.65,
          stagger: 0.022,
          ease: "power3.out"
        }
      )
      .to(
        section.querySelectorAll(".process-main-title .blue-char"),
        {
          color: "#0f172a",
          webkitTextFillColor: "#0f172a",
          duration: 0.65,
          stagger: 0.022,
          ease: "power2.inOut"
        },
        0.35
      );

    // Subtitle + timeline fade-up after title
    gsap.fromTo(
      section.querySelectorAll(".process-subtitle, .process-timeline"),
      { opacity: 0, y: 20 },
      {
        opacity: 1, y: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "power2.out",
        delay: 0.4,
        scrollTrigger: { trigger: section, start: "top 78%" }
      }
    );

    // ── 2. CARD ENTRANCE + TITLE ANIMATIONS ──────────────────────

    // Helper: fire the blue-char animation for a set of chars, ending at finalColor
    function animateCardTitle(chars, finalColor, tl) {
      tl.fromTo(
        chars,
        { opacity: 0, x: -10, color: "#0968e5", webkitTextFillColor: "#0968e5" },
        {
          opacity: 1, x: 0,
          color: "#0968e5", webkitTextFillColor: "#0968e5",
          duration: 0.55,
          stagger: 0.018,
          ease: "power3.out"
        },
        0
      ).to(
        chars,
        {
          color: finalColor, webkitTextFillColor: finalColor,
          duration: 0.55,
          stagger: 0.018,
          ease: "power2.inOut"
        },
        0.28
      );
    }

    // Intro card
    const introCard = section.querySelector(".process-intro-card");
    if (introCard) {
      // Fade/slide up the card shell early
      gsap.fromTo(introCard,
        { opacity: 0, y: 44 },
        {
          opacity: 1, y: 0,
          duration: 0.7,
          ease: "power2.out",
          scrollTrigger: { trigger: introCard, start: "top 86%", toggleActions: "play none none none" }
        }
      );

      // Trigger the title character animation almost at the center of the screen
      const introTitleTl = gsap.timeline({
        scrollTrigger: { trigger: introCard, start: "top 55%", toggleActions: "play none none none" }
      });
      animateCardTitle(introCard.querySelectorAll(".cc"), "#0f172a", introTitleTl);
    }

    // Step cards (image bg → titles end white)
    const stepCards2 = section.querySelectorAll(".process-card");
    stepCards2.forEach((card) => {
      // Fade/slide up the card shell early
      gsap.fromTo(card,
        { opacity: 0, y: 44 },
        {
          opacity: 1, y: 0,
          duration: 0.7,
          ease: "power2.out",
          scrollTrigger: { trigger: card, start: "top 86%", toggleActions: "play none none none" }
        }
      );

      // Trigger the title character animation almost at the center of the screen
      const stepTitleTl = gsap.timeline({
        scrollTrigger: { trigger: card, start: "top 55%", toggleActions: "play none none none" }
      });
      animateCardTitle(card.querySelectorAll(".cc"), "#ffffff", stepTitleTl);
    });

    // Outro card
    const outroCard = section.querySelector(".process-outro-card");
    if (outroCard) {
      // Fade/slide up the card shell early
      gsap.fromTo(outroCard,
        { opacity: 0, y: 44 },
        {
          opacity: 1, y: 0,
          duration: 0.7,
          ease: "power2.out",
          scrollTrigger: { trigger: outroCard, start: "top 86%", toggleActions: "play none none none" }
        }
      );

      // Trigger the title character animation almost at the center of the screen
      const outroTitleTl = gsap.timeline({
        scrollTrigger: { trigger: outroCard, start: "top 55%", toggleActions: "play none none none" }
      });
      animateCardTitle(outroCard.querySelectorAll(".cc"), "#0f172a", outroTitleTl);
    }

    // ── 3. DESKTOP TIMELINE SYNC ─────────────────────────────────

    if (window.innerWidth < 992) return; // skip on mobile

    const stepCards    = section.querySelectorAll(".process-card");
    const timelineSteps = section.querySelectorAll(".timeline-step");
    const progressBar  = section.querySelector("#timeline-progress-bar");

    if (!stepCards.length || !timelineSteps.length) return;

    // Activate matching sidebar step when a card enters the viewport centre
    stepCards.forEach((card, i) => {
      ScrollTrigger.create({
        trigger: card,
        start: "top 60%",
        end:   "bottom 40%",
        onEnter()       { activateStep(i); },
        onEnterBack()   { activateStep(i); },
        // When a card leaves upwards, activate the previous step
        onLeave()       { if (i < stepCards.length - 1) activateStep(i + 1); },
        onLeaveBack()   { if (i > 0) activateStep(i - 1); else clearActive(); }
      });
    });

    function activateStep(index) {
      timelineSteps.forEach((s, i) => s.classList.toggle("active", i === index));
    }

    function clearActive() {
      timelineSteps.forEach(s => s.classList.remove("active"));
    }

    // Scrub the vertical progress bar line
    if (progressBar) {
      const cardsStack = section.querySelector(".process-cards-stack");
      gsap.fromTo(progressBar,
        { height: "0%" },
        {
          height: "100%",
          ease: "none",
          scrollTrigger: {
            trigger: cardsStack,
            start: "top 60%",
            end:   "bottom 60%",
            scrub: 0.5
          }
        }
      );
    }

    // Clickable timeline steps → smooth scroll to card
    timelineSteps.forEach((step, i) => {
      step.addEventListener("click", () => {
        const target = section.querySelector(`.process-card[data-step-card="${i}"]`);
        if (target) {
          const y = target.getBoundingClientRect().top + window.scrollY - 110;
          window.scrollTo({ top: y, behavior: "smooth" });
        }
      });
    });
  }

  // Run on load and after Astro page transitions
  window.addEventListener("load", initProcessStickyScroll);
  document.addEventListener("astro:page-load", initProcessStickyScroll);
</script>
