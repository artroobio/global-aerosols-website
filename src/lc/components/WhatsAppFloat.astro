---
// Site-wide floating WhatsApp button.
// On every page it appears at bottom-right. On the home page it stays hidden
// over the landing/hero section and only reveals once the user scrolls past it.
---
<a
  href="https://wa.me/919819548320"
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float"
  id="wa-float"
  aria-label="Chat with us on WhatsApp"
>
  <svg viewBox="0 0 24 24" fill="currentColor" width="30" height="30" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/>
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45), 0 2px 8px rgba(0, 0, 0, 0.2);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.85);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0.4s ease, box-shadow 0.25s ease;
  }

  .wa-float.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .wa-float:hover {
    transform: translateY(-3px) scale(1.06);
    box-shadow: 0 14px 32px rgba(37, 211, 102, 0.6), 0 4px 10px rgba(0, 0, 0, 0.25);
  }

  /* Gentle attention pulse ring */
  .wa-float::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.5);
    animation: wa-pulse 2.4s ease-out infinite;
    pointer-events: none;
  }

  @keyframes wa-pulse {
    0%   { transform: scale(1);   opacity: 0.7; }
    70%  { transform: scale(1.5); opacity: 0; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float::after { animation: none; }
  }

  @media (max-width: 600px) {
    .wa-float {
      bottom: 18px;
      right: 18px;
      width: 52px;
      height: 52px;
    }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('wa-float');
    if (!btn) return;

    var path = window.location.pathname;
    var isHome = path === '/' || path === '' || path === '/index.html';

    function show() { btn.classList.add('is-visible'); }
    function hide() { btn.classList.remove('is-visible'); }

    if (!isHome) {
      // Site-wide: visible right away on every non-home page
      requestAnimationFrame(show);
      return;
    }

    // Home page: stay hidden over the landing/hero, reveal once scrolled past it
    var hero = document.getElementById('ga-main-wrapper');

    if (hero && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          // When less than 40% of the hero is on screen, the user has left
          // the landing section — reveal the button.
          if (entry.intersectionRatio < 0.4) { show(); } else { hide(); }
        });
      }, { threshold: [0, 0.4, 1] });
      io.observe(hero);
      return;
    }

    // Fallback: scroll-position based
    function update() {
      var trigger = hero ? hero.offsetHeight * 0.6 : window.innerHeight * 0.6;
      if (window.scrollY > trigger) { show(); } else { hide(); }
    }
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();
</script>
