---
interface Props {
  // Optional custom classes or props
  class?: string;
}

const { class: className = "" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class={`site-footer ${className}`}>
  <div class="footer-container">
    {/* Premium CTA band */}
    <div class="footer-cta">
      <div class="footer-cta-text">
        <h2 class="footer-cta-title">Ready to formulate your next product?</h2>
        <p class="footer-cta-sub">Partner with specialist aerosol R&amp;D consultants for formulation, technology, and turnkey manufacturing.</p>
      </div>
      <a href="/contact/" class="footer-cta-btn">
        Start a project
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    {/* Grid Columns */}
    <div class="footer-grid">
      {/* Column 1: Brand Info */}
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo">
          <span class="logo-icon">G</span>
          <span class="logo-text">Global Aerosols</span>
        </a>
        <p class="brand-desc">
          World-class chemical R&D, advanced formulations, aerosol technology consultancy, and turnkey manufacturing engineering services. Pioneering industrial chemistry with premium, sustainable solutions.
        </p>
        <div class="social-links">
          <a href="https://www.linkedin.com/in/absar-khan-aerosol-consultant-and-formulator-78359b162" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn Profile">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a href="mailto:consulting@globalaerosols.com" class="social-icon" aria-label="Email Consultant">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </a>
          <a href="https://wa.me/919819548320" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="WhatsApp Direct">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </a>
        </div>
      </div>

      {/* Column 2: Formulations & Technology */}
      <div class="footer-col">
        <h3 class="col-title">Formulations</h3>
        <ul class="col-links">
          <li><a href="/household-and-industrial-cleaners/">Household &amp; Homecare</a></li>
          <li><a href="/paints-and-coatings/">Paints &amp; Coatings</a></li>
          <li><a href="/arts-and-crafts/">Arts &amp; Crafts</a></li>
          <li><a href="/automotive/">Automotive</a></li>
          <li><a href="/industrial/">Industrial</a></li>
          <li><a href="/adhesives-and-sealants/">Adhesives &amp; Sealants</a></li>
          <li><a href="/cosmetics-and-personal-care/">Personal Care</a></li>
          <li><a href="/cosmetics/">Cosmetics</a></li>
          <li><a href="/pharmaceuticals-and-health-care/">Pharmaceuticals</a></li>
        </ul>
      </div>

      {/* Column 3: Services */}
      <div class="footer-col">
        <h3 class="col-title">Services</h3>
        <ul class="col-links">
          <li><a href="/products/">All Products</a></li>
          <li><a href="/aerosol-contract-manufacturing-and-filling/">Contract Manufacturing</a></li>
          <li><a href="/services/product-formulation/">Product Formulation</a></li>
          <li><a href="/services/consulting-and-technical-support/">Consulting &amp; Support</a></li>
          <li><a href="/services/aerosol-machines-and-equipment/">Machines &amp; Equipment</a></li>
          <li><a href="/services/aerosol-cans/">Aerosol Cans</a></li>
          <li><a href="/services/aerosol-valves-caps-and-actuators/">Valves, Caps &amp; Actuators</a></li>
          <li><a href="/services/aerosol-caps/">Aerosol Caps</a></li>
          <li><a href="/services/canwrap-3d/">CanWrap 3D</a></li>
          <li><a href="/services/canwrap-3d-aluminium/">CanWrap 3D Aluminium</a></li>
        </ul>
      </div>

      {/* Column 4: Company */}
      <div class="footer-col">
        <h3 class="col-title">Company</h3>
        <ul class="col-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms-and-conditions/">Terms &amp; Conditions</a></li>
        </ul>
      </div>

      {/* Column 5: Contact */}
      <div class="footer-col contact-col">
        <h3 class="col-title">Contact</h3>
        <ul class="contact-list">
          <li>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <a href="mailto:globalaerosols@gmail.com">globalaerosols@gmail.com</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <a href="https://wa.me/919819548320" target="_blank" rel="noopener noreferrer">+91 98195 48320</a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="footer-bottom">
      <div class="bottom-left">
        <p class="copyright">&copy; {currentYear} Global Aerosols. All rights reserved.</p>
        <span class="bottom-separator">|</span>
        <p class="tagline">Specialist Aerosol R&D Consultancy - Absar Khan</p>
        <p class="credit">Designed &amp; Maintained by <a href="https://www.atelierevo.com" target="_blank" rel="noopener noreferrer" class="credit-link">Atelierevo</a></p>
      </div>
      <div class="bottom-links">
        <a href="/privacy-policy/" class="bottom-link">Privacy Policy</a>
        <a href="/terms-and-conditions/" class="bottom-link">Terms &amp; Conditions</a>
        <a href="/contact/" class="bottom-link">Contact</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Encapsulated, Premium Vanilla CSS styling */
  .site-footer {
    background-color: hsl(224, 71%, 4%); /* Sleek dark theme base */
    background-image:
      radial-gradient(circle at 10% 20%, rgba(0, 102, 204, 0.05) 0%, transparent 40%),
      radial-gradient(circle at 90% 80%, rgba(138, 43, 226, 0.04) 0%, transparent 40%);
    color: #94a3b8;
    padding: 80px 24px 40px;
    font-family: 'Inter', sans-serif;
    position: relative;
    overflow: hidden;
  }

  /* Animated gradient top border */
  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #0968e5, #38bdf8, #8a2be2, #0968e5);
    background-size: 300% 100%;
    animation: footer-border-flow 8s linear infinite;
    z-index: 3;
  }

  @keyframes footer-border-flow {
    0%   { background-position: 0% 50%; }
    100% { background-position: 300% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer::before { animation: none; }
  }

  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1.2fr;
    gap: 20px;
    margin-bottom: 56px;
  }

  /* Glass column cards */
  .footer-col {
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.045) 0%, rgba(255, 255, 255, 0.012) 100%);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    padding: 28px 24px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  /* Subtle top inner highlight for the glass edge */
  .footer-col::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
  }

  .footer-col:hover {
    border-color: rgba(9, 104, 229, 0.35);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -22px rgba(9, 104, 229, 0.5);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .site-footer {
      padding: 60px 16px 30px;
    }
    .footer-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 28px 24px;
    }
  }

  /* Logo & Brand Column */
  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .logo-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, #0968e5 0%, #074bb5 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 1.3rem;
    box-shadow: 0 4px 12px rgba(0, 102, 204, 0.3);
  }

  .logo-text {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 1.35rem;
    background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .brand-desc {
    font-size: 0.92rem;
    line-height: 1.65;
    color: #94a3b8;
    margin: 0;
  }

  /* Social Icons */
  .social-links {
    display: flex;
    gap: 12px;
  }

  .social-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-icon:hover {
    color: #ffffff;
    background: rgba(9, 104, 229, 0.2);
    border-color: rgba(56, 189, 248, 0.5);
    box-shadow: 0 0 20px rgba(9, 104, 229, 0.45), 0 0 6px rgba(56, 189, 248, 0.4);
    transform: translateY(-2px);
  }

  /* Footer Links columns */
  .col-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 24px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-size: 0.85rem;
    border-left: 2px solid var(--primary, #0066cc);
    padding-left: 10px;
  }

  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .col-links a {
    color: #94a3b8;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s ease, padding-left 0.2s ease;
    display: inline-block;
    position: relative;
  }

  .col-links a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--primary, #0066cc);
    transition: width 0.2s ease;
  }

  .col-links a:hover {
    color: #ffffff;
    padding-left: 4px;
  }

  .col-links a:hover::after {
    width: 100%;
  }

  /* Premium CTA band */
  .footer-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    padding: 36px 44px;
    margin-bottom: 56px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(9, 104, 229, 0.18) 0%, rgba(138, 43, 226, 0.12) 100%);
    border: 1px solid rgba(9, 104, 229, 0.25);
    position: relative;
    overflow: hidden;
  }

  .footer-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 85% 50%, rgba(56, 189, 248, 0.16), transparent 60%);
    pointer-events: none;
  }

  .footer-cta-text {
    position: relative;
    z-index: 1;
  }

  .footer-cta-title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(1.3rem, 2.4vw, 1.9rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .footer-cta-sub {
    font-size: 0.95rem;
    color: #cbd5e1;
    margin: 0;
    max-width: 540px;
    line-height: 1.55;
  }

  .footer-cta-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 12px;
    background: linear-gradient(135deg, #0968e5, #074bb5);
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    font-family: 'Outfit', sans-serif;
    white-space: nowrap;
    box-shadow: 0 8px 24px -8px rgba(9, 104, 229, 0.6);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .footer-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px -8px rgba(9, 104, 229, 0.85);
  }

  .footer-cta-btn svg {
    transition: transform 0.25s ease;
  }

  .footer-cta-btn:hover svg {
    transform: translateX(4px);
  }

  /* Contact column */
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: #94a3b8;
  }

  .contact-list svg {
    color: #38bdf8;
    flex-shrink: 0;
  }

  .contact-list a,
  .contact-list span {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
    word-break: break-word;
  }

  .contact-list a:hover {
    color: #ffffff;
  }

  /* Footer Bottom Bar */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .bottom-left {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .copyright, .tagline {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0;
  }

  .bottom-separator {
    color: rgba(255, 255, 255, 0.08);
    font-size: 0.85rem;
  }

  .credit {
    font-size: 0.82rem;
    color: #475569;
    margin: 0;
    width: 100%;
  }

  .credit-link {
    color: #0968e5;
    text-decoration: none;
    font-weight: 600;
    background: linear-gradient(135deg, #0968e5, #38bdf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transition: opacity 0.2s ease;
  }

  .credit-link:hover {
    opacity: 0.8;
  }

  .bottom-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .bottom-link {
    font-size: 0.85rem;
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .bottom-link:hover {
    color: #94a3b8;
  }

  @media (max-width: 900px) {
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .bottom-left {
      gap: 8px;
    }
    .bottom-separator {
      display: none;
    }
    .tagline {
      width: 100%;
    }
  }
</style>
