---
// src/lc/components/LifestyleShowcase.astro
---

<section class="lifestyle-showcase-section">
  <div class="showcase-container">
    <div class="showcase-content">
      <div class="content-header">
        <span class="eyebrow-accent">Precision Aerosol Systems</span>
        <h2 class="showcase-title">
          {"Where Science Meets Aerosol Sophistication".split(' ').map(word => (
            <span class="word-wrapper">
              {word.split('').map(char => (
                <span class="blue-char">{char}</span>
              ))}
            </span>
          ))}
        </h2>
      </div>
      
      <p class="showcase-description">
        We engineer the complete journey from propellant selection and active ingredient formulation to high-speed contract filling. Every project is grounded in rigorous gas dosing calculations, safety compliance, and custom valve engineering — built to perform across consumer, industrial, and pharmaceutical applications.
      </p>

      <div class="attributes-grid">
        <div class="attribute-item">
          <span class="attribute-num">500+</span>
          <span class="attribute-label">Aerosol Projects Delivered</span>
        </div>
        <div class="attribute-item">
          <span class="attribute-num">100%</span>
          <span class="attribute-label">Regulatory Compliance</span>
        </div>
      </div>

      <div class="btn-container">
        <a href="#contact" class="btn-luxury">
          <span>Start Your Project</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <div class="showcase-visual-wrapper">
      <div class="visual-card">
        <div class="visual-image-container">
          <img 
            src="https://cdn.globalaerosols.com/https://cdn.globalaerosols.com/images/aerosols/aerosols_hero.webp" 
            alt="Precision Aerosol Manufacturing and Contract Filling"
            class="visual-img" 
            loading="lazy"
          />
          <div class="visual-gradient-overlay"></div>
        </div>
        <div class="floating-luxury-badge">
          <span class="badge-ring"></span>
          <div class="badge-text">
            <span class="badge-title">Aerosol Grade</span>
            <span class="badge-subtitle">Precision Filling</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .lifestyle-showcase-section {
    width: 100%;
    padding: 120px 8%;
    background: #0a0a0c;
    color: #ffffff;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
  }

  /* Decorative glowing orb background */
  .lifestyle-showcase-section::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 80%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(9, 104, 229, 0.08) 0%, rgba(9, 104, 229, 0) 70%);
    z-index: 1;
    pointer-events: none;
  }

  .showcase-container {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1.2fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .showcase-content {
    max-width: 650px;
  }

  .eyebrow-accent {
    font-size: clamp(0.7rem, 1.5vw, 0.8rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: #0968e5;
    display: block;
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(15px);
    transition: all 0.8s ease-out;
  }

  .showcase-title {
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #ffffff;
    margin: 0 0 32px 0;
  }

  .word-wrapper {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.28em;
  }

  .blue-char {
    display: inline-block;
    opacity: 0;
    color: #ffffff;
    -webkit-text-fill-color: #ffffff;
  }

  .showcase-description {
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    font-weight: 300;
    line-height: 1.7;
    color: #a1a1aa;
    margin: 0 0 40px 0;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s ease-out 0.3s;
  }

  .attributes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-bottom: 48px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 32px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s ease-out 0.5s;
  }

  .attribute-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .attribute-num {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 300;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .attribute-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #71717a;
    font-weight: 600;
  }

  .btn-container {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s ease-out 0.7s;
  }

  .btn-luxury {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 16px 36px;
    border-radius: 9999px;
    background: #ffffff;
    color: #0a0a0c;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.25, 1, 0.3, 1);
    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
    border: 1px solid #ffffff;
  }

  .btn-luxury span {
    position: relative;
    z-index: 2;
  }

  .btn-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.3, 1);
    position: relative;
    z-index: 2;
  }

  .btn-luxury:hover {
    color: #ffffff;
    background: transparent;
    box-shadow: 0 15px 40px rgba(9, 104, 229, 0.25);
    border-color: #0968e5;
  }

  .btn-luxury:hover .btn-arrow {
    transform: translateX(6px);
  }

  /* Showcase Visual Styles */
  .showcase-visual-wrapper {
    width: 100%;
    position: relative;
  }

  .visual-card {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 13;
    border-radius: 32px;
    background: #18181b;
    overflow: visible;
  }

  .visual-image-container {
    width: 100%;
    height: 100%;
    border-radius: 32px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
    transform: scale(0.9);
    opacity: 0;
    transition: all 1.5s cubic-bezier(0.25, 1, 0.3, 1);
  }

  .visual-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.15);
    transition: transform 1.5s cubic-bezier(0.25, 1, 0.3, 1);
  }

  .visual-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 10, 12, 0.4) 0%,
      rgba(10, 10, 12, 0) 50%
    );
    z-index: 2;
    pointer-events: none;
  }

  .visual-card:hover .visual-img {
    transform: scale(1.08);
  }

  /* Floating luxury badge */
  .floating-luxury-badge {
    position: absolute;
    left: -40px;
    bottom: 50px;
    z-index: 10;
    background: rgba(24, 24, 27, 0.85);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 16px 28px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    opacity: 0;
    transform: translateX(-30px);
    transition: all 1s cubic-bezier(0.25, 1, 0.3, 1) 0.6s;
  }

  .badge-ring {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #0968e5;
    position: relative;
    box-shadow: 0 0 15px #0968e5;
  }

  .badge-ring::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid rgba(9, 104, 229, 0.4);
    animation: ring-pulse 2s infinite ease-out;
  }

  @keyframes ring-pulse {
    0% { transform: scale(0.8); opacity: 1; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  .badge-text {
    display: flex;
    flex-direction: column;
  }

  .badge-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.05em;
  }

  .badge-subtitle {
    font-size: 0.65rem;
    color: #a1a1aa;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 2px;
  }

  /* GSAP Active States */
  .lifestyle-showcase-section.active .eyebrow-accent,
  .lifestyle-showcase-section.active .showcase-description,
  .lifestyle-showcase-section.active .attributes-grid,
  .lifestyle-showcase-section.active .btn-container {
    opacity: 1;
    transform: translateY(0);
  }

  .lifestyle-showcase-section.active .visual-image-container {
    opacity: 1;
    transform: scale(1);
  }

  .lifestyle-showcase-section.active .visual-image-container .visual-img {
    transform: scale(1.03);
  }

  .lifestyle-showcase-section.active .floating-luxury-badge {
    opacity: 1;
    transform: translateX(0);
  }

  /* Responsiveness */
  @media (max-width: 1024px) {
    .showcase-container {
      grid-template-columns: 1fr;
      gap: 64px;
    }
    
    .showcase-content {
      max-width: 100%;
    }
    
    .floating-luxury-badge {
      left: 20px;
      bottom: -20px;
    }
    
    .visual-card {
      aspect-ratio: 16 / 11;
    }
  }

  @media (max-width: 768px) {
    .lifestyle-showcase-section {
      padding: 80px 24px;
    }
    
    .visual-card {
      aspect-ratio: 4 / 3;
    }
    
    .floating-luxury-badge {
      display: none; /* Hide floating elements on mobile for pure screen utilization */
    }
    
    .attributes-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('load', () => {
    const section = document.querySelector('.lifestyle-showcase-section');
    if (!section) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top 75%',
        onEnter: () => {
          section.classList.add('active');
        }
      }
    });

    // Character titles animation, matching the aesthetic of the rest of the pages
    tl.fromTo(".lifestyle-showcase-section .blue-char", 
      { opacity: 0, x: -12, color: "#0968e5", webkitTextFillColor: "#0968e5" },
      {
        opacity: 1,
        x: 0,
        color: "#0968e5",
        webkitTextFillColor: "#0968e5",
        duration: 0.6,
        stagger: 0.02,
        ease: "power3.out"
      }
    )
    .to(".lifestyle-showcase-section .blue-char", {
      color: "#ffffff",
      webkitTextFillColor: "#ffffff",
      duration: 0.6,
      stagger: 0.02,
      ease: "power2.inOut"
    }, 0.3);
  });
</script>
