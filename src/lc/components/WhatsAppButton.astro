---
// src/lc/components/WhatsAppButton.astro
// Premium sticky rectangular WhatsApp button with HSL-green gradient and micro-animations.
---

<a 
  href="https://wa.me/919819548320"
  class="whatsapp-sticky-btn" 
  target="_blank" 
  rel="noopener noreferrer" 
  aria-label="Message Absar Khan on WhatsApp"
>
  <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
    <path d="M12.012 2c-5.506 0-9.98 4.47-9.98 9.98 0 1.76.46 3.47 1.33 4.98L2 22l5.21-1.37c1.47.8 3.12 1.22 4.8 1.22 5.51 0 9.99-4.47 9.99-9.98 0-2.67-1.04-5.18-2.92-7.06C17.18 3.04 14.68 2 12.012 2zm5.71 14.11c-.25.7-1.44 1.3-1.99 1.4-.49.1-1.12.2-3.26-.67-2.73-1.11-4.49-3.9-4.63-4.08-.14-.19-1.12-1.49-1.12-2.84 0-1.35.7-2.01.95-2.28.25-.26.54-.33.72-.33.18 0 .36 0 .52.01.17 0 .4.01.61.5.21.5.73 1.79.79 1.92.06.13.1.28.01.46-.09.18-.18.3-.36.5-.18.21-.38.46-.54.62-.18.17-.37.36-.16.73.21.36.94 1.55 2.01 2.5 1.38 1.23 2.54 1.61 2.91 1.79.37.18.59.15.8-.09.21-.24.91-1.06 1.15-1.42.24-.36.49-.3.8-.18.32.12 2.02.95 2.37 1.12.35.17.58.25.66.4.08.14.08.82-.17 1.52z"/>
  </svg>
  <span class="whatsapp-text">Message on WhatsApp</span>
</a>

<style>
  .whatsapp-sticky-btn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 9999;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 50px;
    padding: 0 28px 0 24px;
    border-radius: 8px;
    background: linear-gradient(95deg, #58c77e 0%, #328c73 100%);
    color: #ffffff;
    text-decoration: none;
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    box-shadow: 
      0 10px 30px rgba(50, 140, 115, 0.28), 
      0 4px 12px rgba(0, 0, 0, 0.08);
    transition: 
      transform 0.4s cubic-bezier(0.25, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.25, 1, 0.3, 1),
      background 0.4s ease;
    will-change: transform;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .whatsapp-icon {
    flex-shrink: 0;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.3, 1);
  }

  .whatsapp-text {
    line-height: 1;
    user-select: none;
  }

  /* Hover micro-animations */
  .whatsapp-sticky-btn:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 
      0 15px 35px rgba(50, 140, 115, 0.42), 
      0 6px 18px rgba(0, 0, 0, 0.12);
    background: linear-gradient(95deg, #62d188 0%, #389b80 100%);
  }

  .whatsapp-sticky-btn:hover .whatsapp-icon {
    transform: scale(1.1) rotate(5deg);
  }

  .whatsapp-sticky-btn:active {
    transform: translateY(-1px) scale(0.98);
  }

  /* Safe area inset for modern smartphones/notched devices in landscape */
  @media (max-width: 768px) {
    .whatsapp-sticky-btn {
      bottom: 20px;
      right: 20px;
      padding: 0 20px 0 16px;
      height: 46px;
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      gap: 8px;
    }
  }
</style>
