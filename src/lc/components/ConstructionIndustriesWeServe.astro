---
// src/lc/components/ConstructionIndustriesWeServe.astro
// Construction Chemicals — "Industries We Serve" interactive radial diagram.
const leftPills = [
  "Concrete Admixtures",
  "Waterproofing Systems",
  "Tile Adhesives & Grouts",
  "Repair Mortars & Grouts",
  "Industrial Flooring",
  "Joint Sealants"
];
const rightPills = [
  "Surface Pretreatments",
  "Protective Coatings",
  "Anchoring & Grouting",
  "Curing & Sealing Compounds",
  "Self-Leveling Underlayments",
  "Specialty Mortars"
];
---

<section class="industries-section">
  <div class="industries-inner">

    <!-- Main Title -->
    <div class="industries-header">
      <h2 class="industries-title">
        {"Industries We Serve".split(' ').map(word => (
          <span class="word-wrapper">
            {word.split('').map(char => (
              <span class="blue-char">{char}</span>
            ))}
          </span>
        ))}
      </h2>
    </div>

    <!-- Diagram Area -->
    <div class="diagram-container" id="diagram-area">

      <!-- SVG for connector lines -->
      <svg class="absolute-svg" id="lines-svg"></svg>

      <!-- Center Ring -->
      <div class="center-ring" id="center-element">
        <div class="center-text">Construction<br>Chemicals</div>
      </div>

      <!-- Left Side Pills -->
      {leftPills.map((label, i) => (
        <div class="pill-container pop-effect" data-index={i} data-side="left">
          <div class="pill-content pill-content-left">
            <span class="pill-text pill-text-left" set:html={label}></span>
            <div class="number-badge badge-left">{String(i + 1).padStart(2, '0')}</div>
          </div>
        </div>
      ))}

      <!-- Right Side Pills -->
      {rightPills.map((label, i) => (
        <div class="pill-container pop-effect" data-index={i + 6} data-side="right">
          <div class="pill-content pill-content-right">
            <div class="number-badge badge-right">{String(i + 7).padStart(2, '0')}</div>
            <span class="pill-text pill-text-right" set:html={label}></span>
          </div>
        </div>
      ))}

    </div>
  </div>

  <!-- Premium gradient bottom line -->
  <div class="bottom-accent-line"></div>
</section>

<style>
  .industries-section {
    --accent-orange: #f97316;
    --accent-amber: #f59e0b;
    --accent-rust: #ea580c;
    --accent-steel: #0284c7;
    --accent-cyan: #06b6d4;

    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    box-sizing: border-box;
    padding: 40px 5% 36px;
    background: radial-gradient(circle at center, #11254e 0%, #081126 45%, #02040b 100%);
    color: #ffffff;
    overflow: hidden;
    font-family: 'Montserrat', sans-serif;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
  }

  .industries-inner {
    position: relative;
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    min-height: 0;
  }

  /* ── Header ── */
  .industries-header {
    text-align: center;
    margin-bottom: 16px;
    z-index: 20;
    flex-shrink: 0;
  }

  .industries-eyebrow {
    font-size: 0.75rem;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    margin: 0 0 8px 0;
    font-weight: 600;
    opacity: 0;
  }

  .industries-title {
    font-size: clamp(1.875rem, 5vw, 3rem);
    line-height: 1.15;
    margin: 0;
    font-weight: 700;
    letter-spacing: 2px;
    filter: drop-shadow(0 10px 8px rgba(0, 0, 0, 0.2));
  }

  .word-wrapper {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.28em;
  }

  .blue-char {
    display: inline-block;
    opacity: 0;
    color: #ffffff;
    -webkit-text-fill-color: #ffffff;
  }

  /* ── Diagram ── */
  .diagram-container {
    position: relative;
    width: 100%;
    max-width: 1100px;
    flex: 1;
    min-height: 0;
    margin: 0 auto;
    opacity: 0; /* revealed by GSAP */
  }

  .absolute-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* Central core ring */
  .center-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 210px;
    height: 210px;
    border-radius: 50%;
    background: rgba(8, 14, 30, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 2px solid #f97316;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    box-shadow:
      0 0 60px rgba(249, 115, 22, 0.35),
      0 0 60px rgba(6, 182, 212, 0.35),
      inset 0 0 30px rgba(249, 115, 22, 0.25),
      inset 0 0 30px rgba(6, 182, 212, 0.25);
    z-index: 5;
    transition: all 0.5s ease;
  }

  .center-ring:hover {
    border-color: #ffaa00;
    box-shadow:
      0 0 85px rgba(249, 115, 22, 0.5),
      0 0 85px rgba(6, 182, 212, 0.5),
      inset 0 0 45px rgba(249, 115, 22, 0.4),
      inset 0 0 45px rgba(6, 182, 212, 0.4);
  }

  .center-ring::before {
    content: '';
    position: absolute;
    top: -3px; left: -3px; right: -3px; bottom: -3px;
    border-radius: 50%;
    border: 3px solid transparent;
    background: linear-gradient(90deg, #f97316, #f59e0b, #06b6d4, #0284c7, #f97316) border-box;
    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: rotateGlow 2.2s linear infinite;
  }

  @keyframes rotateGlow {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .center-text {
    text-align: center;
    color: #f8fafc;
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.4;
    z-index: 10;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .pill-container {
    position: absolute;
    display: flex;
    align-items: center;
    width: 300px;
    transform-origin: center;
    z-index: 10;
    /* Only transition transform (used by hover). Never transition top/left,
       or the pills would slide whenever they're (re)positioned. */
    transition: transform 0.5s ease;
  }

  .pill-content {
    border-radius: 40px;
    padding: 10px 18px;
    display: flex;
    align-items: center;
    position: relative;
    cursor: pointer;
    width: 100%;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.1);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .pill-content-left {
    padding-right: 50px;
    justify-content: flex-end;
    border: 1.5px solid rgba(249, 115, 22, 0.4);
    background: linear-gradient(135deg, rgba(8,14,30,0.92) 0%, rgba(249,115,22,0.48) 50%, rgba(8,14,30,0.92) 100%);
    background-size: 200% 200%;
    animation: shimmerLeft 6s ease infinite;
  }

  .pill-content-right {
    padding-left: 50px;
    justify-content: flex-start;
    border: 1.5px solid rgba(6, 182, 212, 0.4);
    background: linear-gradient(135deg, rgba(8,14,30,0.92) 0%, rgba(6,182,212,0.42) 50%, rgba(8,14,30,0.92) 100%);
    background-size: 200% 200%;
    animation: shimmerRight 6s ease infinite;
  }

  @keyframes shimmerLeft {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  @keyframes shimmerRight {
    0% { background-position: 100% 50%; }
    50% { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
  }

  .pill-container[data-side="left"].pop-effect:hover .pill-content {
    border-color: #ffaa00;
    box-shadow: 0 0 35px rgba(249, 115, 22, 0.75), inset 0 0 18px rgba(249, 115, 22, 0.45);
    background: linear-gradient(135deg, rgba(8,14,30,0.3) 0%, rgba(249,115,22,0.88) 50%, rgba(8,14,30,0.3) 100%);
    background-size: 200% 200%;
  }

  .pill-container[data-side="right"].pop-effect:hover .pill-content {
    border-color: #22d3ee;
    box-shadow: 0 0 35px rgba(6, 182, 212, 0.75), inset 0 0 18px rgba(6, 182, 212, 0.45);
    background: linear-gradient(135deg, rgba(8,14,30,0.3) 0%, rgba(6,182,212,0.82) 50%, rgba(8,14,30,0.3) 100%);
    background-size: 200% 200%;
  }

  .pop-effect {
    /* Hover pop only — must not transition top/left (set via JS positioning). */
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .pop-effect:hover {
    transform: scale(1.08) translateY(-2px);
    z-index: 50;
  }

  .pill-text {
    color: #e2e8f0;
    font-weight: 500;
    font-size: 0.85rem;
    line-height: 1.3;
    letter-spacing: 0.5px;
  }

  .pill-text-left { text-align: right; }
  .pill-text-right { text-align: left; }

  .number-badge {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: 700;
    font-size: 0.9rem;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    z-index: 2;
    color: white;
    text-shadow: 0 1px 2px rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.2);
  }

  .badge-left {
    background: linear-gradient(135deg, var(--accent-amber), var(--accent-orange));
    right: -19px;
  }

  .badge-left::after {
    content: '';
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 6px solid var(--accent-orange);
  }

  .badge-right {
    background: linear-gradient(135deg, var(--accent-steel), var(--accent-cyan));
    left: -19px;
  }

  .badge-right::after {
    content: '';
    position: absolute;
    left: -6px;
    top: 50%;
    transform: translateY(-50%);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-right: 6px solid var(--accent-cyan);
  }

  .connector-line {
    transition: stroke 0.3s ease, stroke-width 0.3s ease, filter 0.3s ease;
  }

  /* Bottom accent line — pinned to the bottom of this section */
  .bottom-accent-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(to right, var(--accent-orange), var(--accent-amber), var(--accent-steel), var(--accent-cyan));
    z-index: 100;
    box-shadow: 0 -2px 15px rgba(249, 115, 22, 0.25), 0 -2px 15px rgba(6, 182, 212, 0.25);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .industries-section {
      height: auto;
      min-height: auto;
      overflow: visible;
      padding: 56px 20px 72px;
    }
    .industries-inner { flex: none; }

    /* Radial diagram → readable vertical stack. A 240px pill cannot fit
       radially in a ~340px column, so pills become full-width rows instead. */
    .diagram-container {
      flex: none;
      height: auto;
      max-width: 460px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    /* Connector lines are meaningless once stacked */
    .absolute-svg { display: none; }

    /* Center ring becomes a centered header above the list */
    .center-ring {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      width: 150px;
      height: 150px;
      margin: 0 auto 20px;
    }
    .center-text { font-size: 0.9rem; }

    /* Pills flow as full-width rows; !important neutralizes the absolute
       coordinates the desktop JS may have set before a resize down to mobile. */
    .pill-container {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
    }

    /* One consistent row style: badge on the left, text left-aligned */
    .pill-content-left,
    .pill-content-right {
      justify-content: flex-start;
      padding-left: 52px;
      padding-right: 20px;
    }
    .pill-text-left,
    .pill-text-right { text-align: left; }
    .pill-text { font-size: 0.82rem; }

    /* Both badges sit on the left edge; flip the green arrow to point inward */
    .badge-left,
    .badge-right { left: -16px; right: auto; }
    .badge-right::after {
      left: auto;
      right: -6px;
      border-right: none;
      border-left: 6px solid var(--accent-cyan);
    }
  }

  @media (max-width: 480px) {
    .center-ring { width: 132px; height: 132px; }
    .center-text { font-size: 0.85rem; }
    .pill-text { font-size: 0.78rem; }
    .number-badge { width: 32px; height: 32px; font-size: 0.75rem; }
    .pill-content-left,
    .pill-content-right { padding-left: 48px; }
    .badge-left,
    .badge-right { left: -14px; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Don't refresh/recalculate on mobile address-bar show/hide (a height-only
  // "resize" fired during scroll) — that's what made the pills drift.
  ScrollTrigger.config({ ignoreMobileResize: true });

  function initIndustriesDiagram() {
    const section = document.querySelector('.industries-section');
    if (!section) return;

    const diagramArea = document.getElementById('diagram-area');
    const svg = document.getElementById('lines-svg');
    const centerRing = document.getElementById('center-element');
    const pills = document.querySelectorAll('.industries-section .pill-container');

    // Keep pills + connector lines hidden until the scroll-reveal entrance plays.
    gsap.set(pills, { opacity: 0 });
    if (svg) gsap.set(svg, { opacity: 0 });

    // Staggered entrance: left pills 1→6 (top→bottom) and right pills 12→7
    // (bottom→top) appear simultaneously, so each pair pops in together.
    const revealPills = () => {
      const leftOrder = Array.from(pills)
        .filter(p => (p as HTMLElement).dataset.side === 'left')
        .sort((a, b) => Number((a as HTMLElement).dataset.index) - Number((b as HTMLElement).dataset.index));
      const rightOrder = Array.from(pills)
        .filter(p => (p as HTMLElement).dataset.side === 'right')
        .sort((a, b) => Number((a as HTMLElement).dataset.index) - Number((b as HTMLElement).dataset.index));

      gsap.fromTo(leftOrder, { opacity: 0 }, { opacity: 1, duration: 0.3, stagger: 0.03, ease: 'power2.out' });
      gsap.fromTo(rightOrder, { opacity: 0 }, { opacity: 1, duration: 0.3, stagger: 0.03, ease: 'power2.out' });
      if (svg) gsap.to(svg, { opacity: 1, duration: 0.5, delay: 0.1, ease: 'power1.out' });
    };

    const positionPillsAndDrawLines = () => {
      if (!diagramArea || !svg || !centerRing || !pills.length) return;

      svg.innerHTML = '';

      // Mobile renders a CSS vertical stack — skip absolute positioning + lines.
      if (window.innerWidth <= 768) return;

      const containerWidth = diagramArea.clientWidth;
      const containerHeight = diagramArea.clientHeight;
      const centerX = containerWidth / 2;
      const centerY = containerHeight / 2;

      const isMobile = window.innerWidth <= 768;

      // Pill width must match the CSS breakpoints.
      const pillWidth = isMobile ? 240 : 300;

      // Clamp horizontal radius so wide pills never overflow the section.
      const maxSafeRadiusX = Math.max(100, centerX - pillWidth - 10);
      const baseRadiusX = isMobile ? containerWidth * 0.30 : containerWidth * 0.29;
      const radiusX = Math.min(baseRadiusX, maxSafeRadiusX);

      const ringRadius = (centerRing.getBoundingClientRect().width / 2) + 8;

      const leftPills = Array.from(pills).filter(p => (p as HTMLElement).dataset.side === 'left');
      const rightPills = Array.from(pills).filter(p => (p as HTMLElement).dataset.side === 'right');

      // Shared vertical grid: derive padding from the TALLEST pill so every
      // pill sits on the same rows. (Otherwise a 2-line pill like "Electronic &
      // Electrical Coatings" would land on a different row than a 1-line pill.)
      const maxPillHeight = Math.max(44, ...Array.from(pills).map(p => (p as HTMLElement).offsetHeight || 44));
      const gridVPad = maxPillHeight / 2 + 6;
      const gridTop = gridVPad;
      const gridBottom = containerHeight - gridVPad;

      const setupHoverInteraction = (pillElement: HTMLElement, lineElement: SVGElement, dotElement: SVGElement, side: string) => {
        const highlightColor = side === 'left' ? '#f59e0b' : '#22d3ee';

        pillElement.addEventListener('mouseenter', () => {
          lineElement.setAttribute('stroke', highlightColor);
          lineElement.setAttribute('stroke-width', '2.5');
          lineElement.style.filter = `drop-shadow(0 0 8px ${highlightColor})`;
          dotElement.setAttribute('fill', highlightColor);
          dotElement.setAttribute('r', '5');
        });

        pillElement.addEventListener('mouseleave', () => {
          const defaultLineColor = side === 'left' ? 'rgba(249, 115, 22, 0.28)' : 'rgba(6, 182, 212, 0.28)';
          const defaultDotColor = side === 'left' ? 'rgba(249, 115, 22, 0.5)' : 'rgba(6, 182, 212, 0.5)';
          lineElement.setAttribute('stroke', defaultLineColor);
          lineElement.setAttribute('stroke-width', '1');
          lineElement.style.filter = 'none';
          dotElement.setAttribute('fill', defaultDotColor);
          dotElement.setAttribute('r', '2.5');
        });
      };

      const drawConnector = (pill: Element, i: number, total: number, startAngle: number, endAngle: number, side: string) => {
        const pillHtml = pill as HTMLElement;
        const pillHeight = pillHtml.offsetHeight || 44;

        const t = total > 1 ? i / (total - 1) : 0.5;

        // Vertical: place this pill's CENTER on the shared row grid, so left
        // and right pills at the same step line up exactly (e.g. 06 ↔ 12).
        const y = gridTop + t * (gridBottom - gridTop);

        // Horizontal: cosine of the arc fans the pills out — middle pills reach
        // furthest from center, end pills tuck in, all staying on their own side.
        const angle = startAngle + t * (endAngle - startAngle);
        const x = centerX + radiusX * Math.cos(angle);

        if (side === 'left') {
          pillHtml.style.left = `${x - pillWidth}px`;
        } else {
          pillHtml.style.left = `${x}px`;
        }
        pillHtml.style.top = `${y - (pillHeight / 2)}px`;

        requestAnimationFrame(() => {
          const badge = pill.querySelector('.number-badge');
          if (!badge) return;

          const diagramRect = diagramArea.getBoundingClientRect();
          const badgeRect = badge.getBoundingClientRect();

          let startX = badgeRect.left - diagramRect.left + (badgeRect.width / 2);
          const startY = badgeRect.top - diagramRect.top + (badgeRect.height / 2);

          if (side === 'left') startX += 12; else startX -= 12;

          const dx = startX - centerX;
          const dy = startY - centerY;
          const lineAngle = Math.atan2(dy, dx);

          const endX = centerX + Math.cos(lineAngle) * ringRadius;
          const endY = centerY + Math.sin(lineAngle) * ringRadius;

          const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          line.setAttribute('x1', startX.toString());
          line.setAttribute('y1', startY.toString());
          line.setAttribute('x2', endX.toString());
          line.setAttribute('y2', endY.toString());
          line.setAttribute('stroke', side === 'left' ? 'rgba(249, 115, 22, 0.28)' : 'rgba(6, 182, 212, 0.28)');
          line.setAttribute('stroke-width', '1');
          line.setAttribute('class', 'connector-line');
          svg.appendChild(line);

          const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          dot.setAttribute('cx', endX.toString());
          dot.setAttribute('cy', endY.toString());
          dot.setAttribute('r', '2.5');
          dot.setAttribute('fill', side === 'left' ? 'rgba(249, 115, 22, 0.5)' : 'rgba(6, 182, 212, 0.5)');
          dot.setAttribute('class', 'connector-line');
          svg.appendChild(dot);

          setupHoverInteraction(pillHtml, line, dot, side);
        });
      };

      leftPills.forEach((pill, i) => drawConnector(pill, i, leftPills.length, Math.PI * 1.25, Math.PI * 0.75, 'left'));
      rightPills.forEach((pill, i) => drawConnector(pill, i, rightPills.length, Math.PI * 0.25, -Math.PI * 0.25, 'right'));
    };

    setTimeout(positionPillsAndDrawLines, 200);

    // Only reposition on a real width change. Mobile browsers fire `resize`
    // when the address bar hides/shows during scroll (height-only change),
    // which would otherwise make the pills jump around as you scroll.
    let lastWidth = window.innerWidth;
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(positionPillsAndDrawLines, 100);
    });

    // Scroll reveal
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 85%",
        toggleActions: "play none none none"
      }
    });

    tl.fromTo(".industries-eyebrow",
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.4, ease: 'power3.out' }
    )
    // Title chars reveal left-to-right (Signature Blue → White), matching home page titles
    .fromTo(".industries-section .blue-char",
      { opacity: 0, x: -12, color: "#0968e5", webkitTextFillColor: "#0968e5" },
      {
        opacity: 1, x: 0,
        color: "#0968e5", webkitTextFillColor: "#0968e5",
        duration: 0.45, stagger: 0.015, ease: "power3.out"
      },
      '-=0.25'
    )
    .to(".industries-section .blue-char", {
      color: "#ffffff", webkitTextFillColor: "#ffffff",
      duration: 0.45, stagger: 0.015, ease: "power2.inOut"
    }, '-=0.5')
    .fromTo(".diagram-container",
      { opacity: 0, scale: 0.97 },
      {
        opacity: 1, scale: 1, duration: 0.35, ease: 'power2.out',
        onStart: () => {
          positionPillsAndDrawLines();
          revealPills();
        }
      },
      '-=0.35'
    );
  }

  window.addEventListener('load', initIndustriesDiagram);
  document.addEventListener('astro:page-load', initIndustriesDiagram);
</script>
