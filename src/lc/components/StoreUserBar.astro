---
interface Props {
  user?: {
    id: string;
    name: string;
    email: string;
    avatar_url: string | null;
  };
}
const { user } = Astro.props;
---

<div class="store-user-bar">
  {user ? (
    <div class="user-info">
      {user.avatar_url
        ? <img src={user.avatar_url} alt={user.name} class="user-avatar" />
        : <span class="user-initial">{user.name[0]}</span>
      }
      <div class="user-details">
        <span class="user-name">{user.name.split(' ')[0]}</span>
        <span class="user-email">{user.email}</span>
      </div>
      <div class="user-actions">
        <a href="/dashboard" class="action-link">My Library</a>
        <form action="/api/auth/logout" method="POST">
          <button type="submit" class="signout-btn">Sign Out</button>
        </form>
      </div>
    </div>
  ) : (
    <a href="/login" class="signin-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/>
      </svg>
      Sign In
    </a>
  )}
</div>

<style>
  .store-user-bar {
    position: fixed;
    top: 70px;
    right: 20px;
    z-index: 800;
  }

  /* ── Signed in ── */
  .user-info {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #E4E4E0;
    border-radius: 40px;
    padding: 6px 14px 6px 6px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }

  .user-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .user-initial {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #0968e5;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .user-details {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .user-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0A0A0A;
  }

  .user-email {
    font-size: 0.7rem;
    color: #9CA3AF;
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .user-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: 4px;
    padding-left: 10px;
    border-left: 1px solid #F0F0EE;
  }

  .action-link {
    font-size: 0.78rem;
    font-weight: 600;
    color: #0968e5;
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 6px;
    white-space: nowrap;
    transition: background 0.15s;
  }

  .action-link:hover { background: #EEF4FD; }

  .signout-btn {
    font-size: 0.78rem;
    font-weight: 600;
    color: #9CA3AF;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    font-family: inherit;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }

  .signout-btn:hover { background: #FEF2F2; color: #EF4444; }

  /* ── Not signed in ── */
  .signin-btn {
    display: flex;
    align-items: center;
    gap: 7px;
    background: #0968e5;
    color: #fff;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 40px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.12);
    transition: opacity 0.15s, transform 0.15s;
  }

  .signin-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  @media (max-width: 600px) {
    .store-user-bar { display: none; }
  }
</style>
