---
import Layout from '../lc/layouts/Layout.astro';
import CleanersIndustriesWeServe from '../lc/components/CleanersIndustriesWeServe.astro';
import TripleRevealCleaners from '../lc/components/TripleRevealCleaners.astro';
import CleanersProcessParallax from '../lc/components/CleanersProcessParallax.astro';
import ContactFormVideo from '../lc/components/ContactFormVideo.astro';
---

<Layout title="Household and Homecare Aerosol Technology & Formulations | Global Formulation" description="Household and homecare aerosol product formulation and technology — room fresheners, disinfectant sprays, foam cleaners, and specialized pressurized home products. R&D and scale-up support.">
  <section class="split-hero cleaners-hero">
    <!-- Full-screen Background Image with Dark Overlay -->
    <div class="hero-bg-wrapper">
      <img 
        src="/images/cleaners/cleaners_hero.png" 
        alt="Premium Household & Homecare Aerosols Formulation Background" 
        class="gf-hero-bg-image" 
        loading="eager"
        decoding="async"
      />
      <div class="hero-dark-overlay"></div>
    </div>

    <div class="split-container hero-full-content">
      <!-- Elegant Content Block in a centered/contained column -->
      <div class="hero-content-block">
        <span class="category-tag">Aerosol Formulations & Technology</span>
        <h1 class="hero-title">
          <span class="hero-title__line hero-title__line--primary">
            {"Household & Homecare".split(' ').map(word => (
              <span class="word-wrapper">
                {word.split('').map(char => (
                  <span class="blue-char">{char}</span>
                ))}
              </span>
            ))}
          </span>
          <span class="hero-title__line">
            {"Aerosol Products".split(' ').map(word => (
              <span class="word-wrapper">
                {word.split('').map(char => (
                  <span class="blue-char">{char}</span>
                ))}
              </span>
            ))}
          </span>
        </h1>
        
        <p class="hero-subtitle">
          Delivering high-performance household and homecare aerosol solutions designed for modern living. Formulated with optimized propellants, solvents, active ingredients, and valves to deliver perfect spray patterns, stable foams, and maximum efficacy for air care, surface disinfection, and specialized home applications.
        </p>
        
        <div class="hero-actions">
          <a href="/contact" class="gf-button">
            <span class="button-text">Consult Specialist</span>
            <span class="arrow">➤</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CleanersIndustriesWeServe />
  <TripleRevealCleaners />
  <CleanersProcessParallax />
  <ContactFormVideo /><style>
  .split-hero.cleaners-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    width: 100%;
    background: #080a12; /* Sleek dark theme base */
    display: flex;
    align-items: center;
    padding: 90px max(5%, env(safe-area-inset-left)) 50px max(5%, env(safe-area-inset-right));
    overflow: hidden;
  }

  /* Full-Screen Background Image and Overlay Styling */
  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .gf-hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.03); /* Subtle zoom for premium feel */
    transition: transform 10s ease-out;
  }

  /* Dark Cinematic Overlay with gradient to highlight text legibility */
  .hero-dark-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(8, 10, 18, 0.70) 0%,
      rgba(8, 10, 18, 0.45) 50%,
      rgba(8, 10, 18, 0.20) 100%
    );
    z-index: 2;
  }

  .split-container.hero-full-content {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: flex-start; /* Keep text aligned to the left for a high-end corporate editorial feel */
    position: relative;
    z-index: 3;
  }

  .hero-content-block {
    width: 100%;
    max-width: 680px; /* Perfect reading and typographic width */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Radial backdrop highlight - adjusted for dark full-screen layout to add depth */
  .split-hero.cleaners-hero::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 20%;
    transform: translate(-50%, -50%);
    width: clamp(300px, 50vw, 800px);
    height: clamp(300px, 50vw, 800px);
    background: radial-gradient(circle, rgba(9, 104, 229, 0.15) 0%, rgba(9, 104, 229, 0) 70%);
    pointer-events: none;
    z-index: 2;
  }

  /* Override global Navbar to remain highly visible on dark background */
  :global(.navbar) {
    background: rgba(8, 10, 18, 0.8) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
  }

  /* Category tag styling */
  .category-tag {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: #3b82f6; /* Brighter blue for contrast against dark bg */
    display: inline-block;
    margin-bottom: 18px;
    opacity: 0;
    transform: translateY(15px);
  }

  /* Typography Styles on Dark Background */
  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 20px;
    color: #ffffff; /* Clean high-contrast white */
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    font-family: 'Outfit', sans-serif;
  }

  .hero-title__line {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.25em;
    max-width: 100%;
  }

  .hero-title__line--primary {
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    line-height: 1.05;
    letter-spacing: -1px;
  }

  .word-wrapper {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.25em;
  }

  .blue-char {
    display: inline-block;
    opacity: 0;
    color: #ffffff;
    -webkit-text-fill-color: #ffffff;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    color: #cbd5e1; /* Light gray for high legibility on dark overlay */
    font-weight: 400;
    line-height: 1.65;
    margin-bottom: 24px;
    max-width: 600px;
    opacity: 0;
    transform: translateY(20px);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  .hero-actions {
    opacity: 0;
    transform: translateY(20px);
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .split-hero.cleaners-hero {
      padding: 140px max(5%, env(safe-area-inset-left)) 60px max(5%, env(safe-area-inset-right));
      text-align: center;
    }

    .split-container.hero-full-content {
      justify-content: center;
    }

    .hero-content-block {
      align-items: center;
    }

    .hero-title {
      align-items: center;
      margin-bottom: 24px;
    }

    .hero-title__line {
      justify-content: center;
    }

    .hero-subtitle {
      margin-bottom: 30px;
    }
  }

  @media (max-width: 480px) {
    .split-hero.cleaners-hero {
      padding-top: 120px;
      padding-bottom: 40px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // No video interaction needed - photorealistic cleaners hero image active

  // GSAP Cinematic Reveal animation for Hero Section
  const heroChars = document.querySelectorAll('.hero-title .blue-char');
  const subtitle = document.querySelector('.hero-subtitle');
  const actions = document.querySelector('.hero-actions');
  const tag = document.querySelector('.category-tag');

  const startAnimation = () => {
    const tl = gsap.timeline();

    // 1. Reveal Category Tag
    tl.to(tag, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power3.out'
    });

    // 2. Reveal Title chars left-to-right (Signature Blue → Solid White #ffffff)
    tl.fromTo(heroChars,
      { opacity: 0, x: -12, color: '#0968e5', webkitTextFillColor: '#0968e5' },
      {
        opacity: 1,
        x: 0,
        duration: 0.7,
        stagger: 0.02,
        ease: 'power3.out',
        color: '#0968e5',
        webkitTextFillColor: '#0968e5'
      },
      '-=0.4'
    )
    .to(heroChars, {
      color: '#ffffff',
      webkitTextFillColor: '#ffffff',
      duration: 0.7,
      stagger: 0.02,
      ease: 'power2.inOut'
    }, '-=0.4');

    // 3. Reveal Subtitle
    tl.to(subtitle, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power3.out'
    }, '-=0.6');

    // 4. Reveal Actions
    tl.to(actions, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power3.out'
    }, '-=0.4');
  };

  // Run animation instantly
  startAnimation();

</script>
