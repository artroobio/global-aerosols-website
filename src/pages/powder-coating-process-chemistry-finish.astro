              <tr><td>Polyester-Epoxy Hybrid</td><td>Carboxyl polyester + epoxy</td><td>Epoxy (self-curing blend)</td><td>170–190°C</td><td>Moderate</td><td>Interior appliances, shelving, general metal</td></tr>
              <tr><td>Polyurethane</td><td>Hydroxyl polyester</td><td>Blocked isocyanate</td><td>180–200°C</td><td>Excellent</td><td>Premium exterior, automotive OEM, decorative architectural</td></tr>
              <tr><td>Low-cure Polyester/HAA</td><td>Reactive carboxyl polyester</td><td>HAA (reactive grade)</td><td>140–160°C</td><td>Good</td><td>MDF furniture, pre-assembled components, heat-sensitive parts</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Diagram image -->
      <img 
        class="article-img" 
        src={`https://cdn.globalformulation.com/images/${slug}/${slug}-diagram.webp`} 
        alt="powder coating curing oven — glowing industrial cure oven interior with heat elements and coated metal panel silhouette | Global Formulation diagram" 
