// 6. FAQPage Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the primary function of transformer oil in power transformers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Transformer oil performs three simultaneous functions: it acts as a liquid dielectric insulator to prevent electrical discharge between HV and LV windings; it transfers heat generated by I²R losses and core losses to the tank walls and radiators via convection; and it quenches electrical arcs during switching or fault events. All three roles degrade if the oil's condition deteriorates, which is why regular testing and maintenance are critical."
      }
    },
    {
      "@type": "Question",
      "name": "What is the BDV test and what values are acceptable for transformer oil?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Breakdown Voltage (BDV) test, standardised under IEC 60156, measures the voltage at which transformer oil fails dielectrically under controlled conditions. Oil is placed between two electrodes separated by a 2.5 mm gap, and voltage is raised at a defined rate until electrical breakdown occurs. For new oil, IEC 60296 requires a minimum BDV of 30 kV (measured as the average of six breakdowns). For oil in service, a BDV below 30 kV typically triggers immediate degassing and drying treatment; below 20 kV requires oil change or full regeneration."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between inhibited and uninhibited transformer oil?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Inhibited transformer oil contains a synthetic antioxidant — typically DBPC (2,6-di-tert-butyl-para-cresol) at defined treat levels — that interrupts the free-radical chain oxidation mechanism that degrades hydrocarbon oil molecules. Uninhibited oil relies solely on the natural antioxidant properties of the naphthenic base oil without added inhibitor. Inhibited oils offer significantly longer service life in sealed or nitrogen-blanketed transformers where oxidation is the primary aging mechanism, while uninhibited oils are sometimes specified for free-breathing transformers where oxidation byproduct solvency is the priority."
      }
    },
    {
      "@type": "Question",
      "name": "What is Dissolved Gas Analysis (DGA) and why is it important?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dissolved Gas Analysis (DGA) involves extracting and quantifying the individual combustible gases — hydrogen (H2), methane (CH4), acetylene (C2H2), ethylene (C2H4), ethane (C2H6), carbon monoxide (CO), and carbon dioxide (CO2) — dissolved in transformer oil. These gases are generated as specific thermal and electrical fault types thermally decompose both the oil and the cellulose insulation paper inside the transformer. By comparing gas ratios against the IEC 60599 standard Duval Triangle or IEEE C57.104 interpretation tables, maintenance engineers can identify fault type (hot spot, partial discharge, arcing) and severity without opening the transformer."
      }
    },
    {
      "@type": "Question",
      "name": "What does acidity in transformer oil indicate and how is it measured?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rising acidity in transformer oil is a direct indicator of oil oxidation. As naphthenic hydrocarbons react with dissolved oxygen at elevated temperatures, they progressively oxidise to form peroxides, aldehydes, ketones, and ultimately carboxylic acids. These acidic species attack cellulose insulation paper, promoting chain scission and embrittlement — a primary mechanism of accelerated transformer aging. Acidity is measured as the Neutralisation Number (or Acid Number), reported in mg KOH per gram of oil, standardised under IEC 62021 or ASTM D974. A value above 0.1 mg KOH/g indicates the oil requires regeneration or replacement."
      }
    },
    {
      "@type": "Question",
      "name": "How is transformer oil regenerated or reconditioned on-site?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Transformer oil can be reconditioned through several methods depending on the degree of degradation. For moisture and dissolved gas contamination, hot oil vacuum filtration circuits are used — the oil is heated, passed through a vacuum chamber to remove dissolved water and gases, then filtered through fine-grade filter elements before being returned to the transformer. For oxidation products (acids, sludge, and colour bodies), the oil is circulated through activated bleaching earth (Fuller's earth) columns, which adsorb polar oxidation byproducts and restore the oil's interfacial tension, acidity, and colour to near-new condition."
      }
    }
  ]
};

