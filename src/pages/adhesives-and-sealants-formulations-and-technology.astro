            <span>By <strong>Absar Khan</strong></span>
          </div>
          <span style="width: 4px; height: 4px; border-radius: 50%; background-color: var(--border);"></span>
          <span>Published: <strong>May 18, 2026</strong></span>
          <span style="width: 4px; height: 4px; border-radius: 50%; background-color: var(--border);"></span>
          <span>Reading Time: <strong>18 min read</strong></span>
          <span style="width: 4px; height: 4px; border-radius: 50%; background-color: var(--border);"></span>
          <span style="background: #e0f2fe; color: #0369a1; padding: 2px 10px; border-radius: 50px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Adhesives &amp; Polymer Care</span>
        </div>
      </header>

      <!-- Primary Scientific Graphic -->
      <div class="image-slot">
        <img 
          loading="eager" 
          src="https://assets.zyrosite.com/AGBzPMBJDQiwDGny/worker_applying_adhesive_inside_a_car_cabin-5p1NpA68c0SC4pd7.jpeg" 
          alt="Precision industrial adhesive application inside an automotive structural cabin frame showing advanced polyurethane dispensing" 
        />
