          </div>
          <span style="width: 4px; height: 4px; border-radius: 50%; background-color: var(--border);"></span>
          <span>Published: <strong>April 10, 2026</strong></span>
          <span style="width: 4px; height: 4px; border-radius: 50%; background-color: var(--border);"></span>
          <span>Reading Time: <strong>15 min read</strong></span>
          <span style="width: 4px; height: 4px; border-radius: 50%; background-color: var(--border);"></span>
          <span style="background: #e0f2fe; color: #0369a1; padding: 2px 10px; border-radius: 50px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Lubricants &amp; Tribology</span>
        </div>
      </header>

      <!-- Primary Featured Image -->
      <div class="image-slot">
        <img 
          src="https://assets.zyrosite.com/AGBzPMBJDQiwDGny/grease-manufacturing-reactor-ARFZKXQQI3itAfbF.png" 
