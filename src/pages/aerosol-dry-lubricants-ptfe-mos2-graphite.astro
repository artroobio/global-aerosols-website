      <a href="https://www.globalaerosols.com/blog" target="_top">Blog</a>
    </p>
  </footer>

  <!-- SCROLLSPY -->
  <script>
    (function () {
      const links = document.querySelectorAll('.toc-sidebar ol li a');
      const sections = Array.from(links)
        .map(a => document.querySelector(a.getAttribute('href')))
        .filter(Boolean);

      if (!sections.length) return;

      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              links.forEach(a => a.classList.remove('toc-active'));
              const active = document.querySelector(
                '.toc-sidebar ol li a[href="#' + entry.target.id + '"]'
              );
              if (active) active.classList.add('toc-active');
            }
          });
        },
        { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
      );

      sections.forEach(s => observer.observe(s));
    })();
  </script>
  </div>
