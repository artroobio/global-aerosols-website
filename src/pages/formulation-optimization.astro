---
import Layout from '../lc/layouts/Layout.astro';
import ServicePageAnimations from '../lc/components/ServicePageAnimations.astro';

const disciplines = [
  'Root cause analysis of formulation failures and performance gaps',
  'Ingredient substitution with verified performance equivalence',
  'Cost-per-litre and cost-per-dose reduction without quality regression',
  'SVHC, REACH, and restricted substance replacement',
  'Stability enhancement — physical, chemical, and microbiological',
  'Rheology and viscosity profile adjustment for application conditions',
  'Sensory profile modification — texture, odour, colour, skin feel',
  'VOC reduction and waterborne conversion strategies',
  'Scale-up discrepancy diagnosis and process-level correction',
  'Shelf-life extension for new markets or distribution requirements',
];

const steps = [
  {
    n: '01',
    t: 'Diagnostic Assessment',
    d: 'We analyse your existing formulation, test data, and failure history to identify the root cause before suggesting any change. A misdiagnosis at this stage is expensive — we don\'t skip it.',
  },
  {
    n: '02',
    t: 'Redesign & Substitution',
    d: 'Targeted modifications only — ingredient substitutions, ratio adjustments, or process changes that address the root cause without creating new problems elsewhere in the formulation.',
  },
  {
    n: '03',
    t: 'Comparative Testing',
    d: 'Side-by-side testing of original versus optimised formulation across every critical parameter: performance, stability, sensory, regulatory, and cost. No improvements claimed without data.',
  },
  {
    n: '04',
    t: 'Validated Handover',
    d: 'Updated specification with full change rationale, comparative test data, regulatory impact assessment, and amended manufacturing notes — ready for immediate production use.',
  },
];

const scenarios = [
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>',
    name: 'Cost Reduction',
    desc: 'Lower raw material cost without compromising performance, sensory profile, or consumer perception of quality.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>',
    name: 'Regulatory Compliance',
    desc: 'Replace SVHC, REACH-listed, or newly restricted ingredients before compliance deadlines create a production stop.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 7h16M4 12h16M4 17h10"/><path d="M19 15l2 2-2 2"/></svg>',
    name: 'Raw Material Substitution',
    desc: 'Adapt swiftly to supplier discontinuations, global shortages, or price spikes — with verified performance equivalence.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12h1M20 12h1M12 3v1M12 20v1"/><circle cx="12" cy="12" r="4"/><path d="M6.34 6.34l.7.7M17 17l.7.7M6.34 17.66l.7-.7M17 7l.7-.7"/></svg>',
    name: 'Stability Improvement',
    desc: 'Resolve phase separation, oxidative rancidity, microbial growth, viscosity drift, or colour change in storage.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>',
    name: 'Performance Enhancement',
    desc: 'Improve viscosity, adhesion, gloss, cleaning efficacy, spreading, or skin feel where the current formulation falls short.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10Z"/><path d="M12 11v4M10 13h4"/></svg>',
    name: 'VOC & Sustainability',
    desc: 'Reduce solvent content, convert to waterborne systems, or reformulate for green certification without performance regression.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>',
    name: 'Scale-Up Discrepancy',
    desc: 'Diagnose and correct formulations that pass every lab test but fail consistently at production-scale manufacturing.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.5 10c-.83 0-1.5-.67-1.5-1.5v-5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5Z"/><path d="M20.5 10H19V8.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5Z"/><path d="M9.5 14c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5S8 21.33 8 20.5v-5c0-.83.67-1.5 1.5-1.5Z"/><path d="M3.5 14H5v1.5c0 .83-.67 1.5-1.5 1.5S2 16.33 2 15.5 2.67 14 3.5 14Z"/><path d="M14 14.5c0-.83.67-1.5 1.5-1.5h5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5h-5c-.83 0-1.5-.67-1.5-1.5Z"/><path d="M15.5 19H14v1.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5-.67-1.5-1.5-1.5Z"/><path d="M10 9.5C10 8.67 9.33 8 8.5 8h-5C2.67 8 2 8.67 2 9.5S2.67 11 3.5 11h5c.83 0 1.5-.67 1.5-1.5Z"/><path d="M8.5 5H10V3.5C10 2.67 9.33 2 8.5 2S7 2.67 7 3.5 7.67 5 8.5 5Z"/></svg>',
    name: 'Sensory Optimisation',
    desc: 'Adjust texture, odour, colour, or in-use feel to match a new target market without altering functional efficacy.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01"/></svg>',
    name: 'Shelf Life Extension',
    desc: 'Achieve the longer stability windows required for new export markets, retail channels, or extended distribution cycles.',
  },
];

const deliverables = [
  'Updated formulation specification with per-change rationale and change history',
  'Side-by-side comparative test data: original formulation versus optimised',
  'Root cause analysis report detailing the source of the original problem',
  'Updated raw material list with approved alternatives where substitutions were made',
  'Regulatory impact assessment for any ingredient-level changes',
  'Amended QC test methods and acceptance criteria reflecting the new specification',
  'Manufacturing process amendments — mixing sequence, temperature, or timing changes',
];

const splitWords = (s: string) => s.split(' ');
---

<Layout
  title="Formulation Optimization | Global Formulation"
  description="Improve existing formulations for better performance, lower cost, enhanced stability, or regulatory compliance — root-cause diagnosis, targeted redesign, validated output."
  canonical="/formulation-optimization"
>

  <!-- ══════════ S1 HERO [DARK] ══════════ -->
  <section class="fo-hero" id="fo-s1">
    <div class="fo-hero-inner">
      <span class="fo-eyebrow-c reveal">Formulation Optimization</span>
      <h1 class="fo-hero-h1">
        {splitWords('Your best formulation').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
        <br class="br-d" />
        {splitWords('is one iteration away').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
      </h1>
      <p class="fo-hero-sub reveal">
        We diagnose underperforming formulations, identify the root cause, and redesign
        with surgical precision — improving performance, cutting cost, or achieving
        compliance without tearing up what already works.
      </p>
      <div class="fo-hero-ctas reveal">
        <a href="/contact" class="fo-btn-primary">Start an Optimization</a>
        <a href="#fo-process" class="fo-btn-ghost">See the process</a>
      </div>
    </div>
  </section>

  <!-- ══════════ S2 OVERVIEW [LIGHT] ══════════ -->
  <section class="fo-section fo-light fo-split" id="fo-s2">
    <div class="fo-split-inner">
      <div class="fo-split-text">
        <span class="fo-eyebrow-l reveal">What We Do</span>
        <h2 class="fo-h2-l">
          {splitWords('Fix what is broken.').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
          <br class="br-d" />
          {splitWords('Improve what works.').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
        </h2>
        <p class="fo-body-l reveal">
          Most formulation problems have a specific cause — the wrong thickener grade,
          an incompatible preservative pair, a surfactant that loses its cloud point at
          storage temperature, a pigment that flocculates under shear. What they rarely
          have is a simple fix. Changing one ingredient shifts the balance of ten others,
          and optimisation that ignores the whole system creates new problems as fast as
          it solves old ones.
        </p>
        <p class="fo-body-l reveal">
          Our approach is diagnostic first. We review your existing specification, test
          data, and failure history to build a clear picture of the root cause before
          we propose any change. Every modification we recommend is tested side-by-side
          against the original, across every parameter that matters — performance,
          stability, sensory, regulatory, and cost. You receive a validated, updated
          specification, not a theory.
        </p>
        <ul class="fo-points">
          {[
            'Diagnosis-led — root cause identified before any reformulation begins',
            'Targeted changes only — no unnecessary ingredient churn',
            'Side-by-side validated testing: original vs optimised',
            'Outcomes across cost, performance, stability, and compliance',
          ].map(p => (
            <li class="fo-point reveal">
              <span class="fo-point-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="5 12 10 17 19 7"/></svg>
              </span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="fo-split-media reveal">
        <!-- IMAGE 1 PLACEHOLDER -->
        <img 
          src="/images/services/formulation-optimization-review.webp" 
          alt="Laboratory analyst reviewing existing product test data — printed stability reports and sample jars arranged on a clean desk, with two product variants side by side for comparison. Warm neutral editorial lighting. No people, no visible screen text, no logos." 
          width="900" 
          height="700" 
          class="fo-img"
          style="width: 100%; border-radius: var(--fo-radius, 16px); object-fit: cover; aspect-ratio: 900/700;"
        />
      </div>
    </div>
  </section>

  <!-- ══════════ S3 CAPABILITIES [DARK] ══════════ -->
  <section class="fo-section fo-dark fo-split fo-split-rev" id="fo-s3">
    <div class="fo-split-inner">
      <div class="fo-split-media reveal">
        <!-- IMAGE 2 PLACEHOLDER -->
        <img 
          src="/images/services/formulation-optimization-stability-oven.webp" 
          alt="Close-up of a laboratory stability testing oven with rows of sample bottles               arranged on internal shelves — clean, orderly, scientific. Cool blue-white               overhead lighting casting sharp shadows. No people, no labels,               no text visible in frame." 
          width="900" 
          height="700" 
          class="fo-img"
          style="width: 100%; border-radius: var(--fo-radius, 16px); object-fit: cover; aspect-ratio: 900/700;"
        />
      </div>

      <div class="fo-split-text">
        <span class="fo-eyebrow-d reveal">Technical Scope</span>
        <h2 class="fo-h2-d">
          {splitWords('Performance optimization').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
          ))}
          <br class="br-d" />
          {splitWords('at molecular level').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
          ))}
        </h2>
        <p class="fo-body-d reveal">
          Our optimization services systematically identify and resolve the chemical, physical, and economic inefficiencies in your current formulations. We analyze ingredient interactions, surfactant synergy, and rheological profiles to cut raw material costs, improve performance, and ensure absolute stability.
        </p>
        <ul class="fo-cap-grid reveal">
          {disciplines.map(c => (
            <li>
              <span class="fo-cap-dot"></span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════ S4 PROCESS [LIGHT] ══════════ -->
  <section class="fo-section fo-light fo-process" id="fo-process">
    <div class="fo-process-head">
      <span class="fo-eyebrow-l reveal">How We Work</span>
      <h2 class="fo-h2-l fo-centered">
        {splitWords('Our performance optimization approach').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
        ))}
      </h2>
      <p class="fo-process-sub reveal">
        Four phases that audit, model, reformulate, and systematically validate your chemical products to unlock maximum margin and performance.
      </p>
    </div>
    <div class="fo-steps">
      {steps.map(s => (
        <div class="fo-step reveal">
          <span class="fo-step-n">{s.n}</span>
          <span class="fo-step-rule"></span>
          <h3 class="fo-step-t">{s.t}</h3>
          <p class="fo-step-d">{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════ S5 SPECIALIZATION [DARK] ══════════ -->
  <section class="fo-section fo-dark fo-scenarios" id="fo-s5">
    <div class="fo-tech-head">
      <span class="fo-eyebrow-c reveal">Optimization Scenarios</span>
      <h2 class="fo-h2-d fo-centered">
        {splitWords('Common challenges').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
        <br class="br-d" />
        {splitWords('we resolve').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
      </h2>
      <p class="fo-tech-sub reveal">
        From immediate cost reduction targets to raw material supply disruptions and compliance modernization.
      </p>
    </div>
    <div class="fo-tech-grid">
      {scenarios.map((t, idx) => (
        <div class="fo-tech-tile reveal" style={`--d:${idx * 0.055}s`}>
          <span class="fo-tech-ico" set:html={t.icon}></span>
          <h3 class="fo-tech-name">{t.name}</h3>
          <p class="fo-tech-desc">{t.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════ S6 DELIVERABLES [LIGHT] ══════════ -->
  <section class="fo-section fo-light fo-split" id="fo-s6">
    <div class="fo-split-inner fo-split-inner-rev">
      <div class="fo-split-text">
        <span class="fo-eyebrow-l reveal">Deliverables</span>
        <h2 class="fo-h2-l">
          {splitWords('Clean comparison &').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
          <br class="br-d" />
          {splitWords('empirical validation').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
        </h2>
        <p class="fo-body-l reveal">
          Optimization requires empirical proof. We supply complete side-by-side performance analytics, rheological comparative graphs, raw material cost saving reports, and GHS-compliant regulatory checklists, showing the direct yield improvements and cost reductions of your optimized formulation.
        </p>
        <ul class="fo-points">
          {deliverables.map(d => (
            <li class="fo-point reveal">
              <span class="fo-point-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="5 12 10 17 19 7"/></svg>
              </span>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="fo-split-media reveal">
        <!-- IMAGE 3 PLACEHOLDER -->
        <img 
          src="/images/services/formulation-optimization-comparison.webp" 
          alt="Two identical product containers side by side on a clean laboratory surface               — one labelled "original", one "optimised" — with test measurement               instruments and printed data sheets nearby. Clean white-grey backdrop,               directional editorial lighting. No people, no visible screen text." 
          width="900" 
          height="700" 
          class="fo-img"
          style="width: 100%; border-radius: var(--fo-radius, 16px); object-fit: cover; aspect-ratio: 900/700;"
        />
      </div>
    </div>
  </section>

  <!-- ══════════ S7 CTA [DARK] ══════════ -->
  <section class="fo-section fo-dark fo-cta" id="fo-s7">
    <div class="fo-cta-card reveal">
      <span class="fo-eyebrow-c" style="margin-bottom: 20px; display: block;">Get Started</span>
      <h2 class="fo-cta-h2">
        {splitWords('Optimize your product').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
        <br class="br-d" />
        {splitWords('margins today.').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
      </h2>
      <p class="fo-cta-sub reveal">
        Whether you're designing a process from scratch, troubleshooting a scale-up
        failure, or preparing a safety analysis for a regulatory submission — we can help.
      </p>
      <form class="fo-cta-form reveal" action="/contact" method="get">
        <input type="email" name="email" placeholder="Enter your email to get started…" aria-label="Email address" required />
        <button type="submit">Discuss Your Process</button>
      </form>
      <p class="fo-cta-alt reveal">
        Need a call first?&nbsp;
        <a href="/contact">Book a consultation →</a>
      </p>
    </div>
  </section>

  <ServicePageAnimations />
</Layout>

<style>
  /* --- HERO SECTION --- */
  .fo-hero {
    background: linear-gradient(135deg, #0b0f19 0%, #111827 100%);
    padding: 140px 24px 100px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .fo-hero-inner {
    max-width: 880px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }
  .fo-eyebrow-c {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #3b82f6;
    margin-bottom: 24px;
    display: inline-block;
  }
  .fo-hero-h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 24px;
    font-family: 'Outfit', sans-serif;
  }
  .fo-hero-sub {
    font-size: 1.2rem;
    color: #9ca3af;
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  .fo-hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .fo-btn-primary {
    background: #2563eb;
    color: #ffffff;
    padding: 14px 32px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .fo-btn-primary:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
  }
  .fo-btn-ghost {
    background: transparent;
    color: #ffffff;
    padding: 14px 32px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.2s ease;
  }
  .fo-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* --- SECTION BASE --- */
  .fo-section {
    padding: 100px 24px;
    position: relative;
  }
  .fo-light {
    background: #ffffff;
    color: #1f2937;
  }
  .fo-dark {
    background: #0b0f19;
    color: #f3f4f6;
  }

  /* --- SPLIT LAYOUT --- */
  .fo-split-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .fo-split-inner-rev {
    grid-template-columns: 1fr 1.2fr;
  }
  @media (max-width: 1024px) {
    .fo-split-inner, .fo-split-inner-rev {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  .fo-split-text {
    display: flex;
    flex-direction: column;
  }
  .fo-split-media {
    position: relative;
    width: 100%;
  }
  .fo-eyebrow-l {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #2563eb;
    margin-bottom: 20px;
    display: inline-block;
  }
  .fo-eyebrow-d {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #60a5fa;
    margin-bottom: 20px;
    display: inline-block;
  }
  .fo-h2-l {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    color: #111827;
    margin-bottom: 24px;
    font-family: 'Outfit', sans-serif;
  }
  .fo-h2-d {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: 24px;
    font-family: 'Outfit', sans-serif;
  }
  .fo-body-l {
    font-size: 1.05rem;
    color: #4b5563;
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .fo-body-d {
    font-size: 1.05rem;
    color: #9ca3af;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  /* --- POINTS LIST --- */
  .fo-points {
    list-style: none;
    padding: 0;
    margin: 32px 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .fo-point {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .fo-point-ico {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fo-point-ico svg {
    width: 14px;
    height: 14px;
  }
  .fo-point span {
    font-size: 1rem;
    color: #374151;
    line-height: 1.5;
  }

  /* --- CAPABILITIES GRID --- */
  .fo-cap-grid {
    list-style: none;
    padding: 0;
    margin: 32px 0 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 32px;
  }
  @media (max-width: 640px) {
    .fo-cap-grid {
      grid-template-columns: 1fr;
    }
  }
  .fo-cap-grid li {
