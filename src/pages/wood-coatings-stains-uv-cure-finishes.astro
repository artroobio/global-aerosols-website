          </div>
          <span style="width: 4px; height: 4px; border-radius: 50%; background-color: var(--border);"></span>
          <span>Published: <strong>June 11, 2026</strong></span>
          <span style="width: 4px; height: 4px; border-radius: 50%; background-color: var(--border);"></span>
          <span>Reading Time: <strong>11 min read</strong></span>
          <span style="width: 4px; height: 4px; border-radius: 50%; background-color: var(--border);"></span>
          <span style="background: #e0f2fe; color: #0369a1; padding: 2px 10px; border-radius: 50px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Paints &amp; Coatings</span>
        </div>
      </header>

      <!-- Primary Featured Image -->
      <div class="image-slot" style="margin-bottom: 30px; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border);">
        <img 
          src="https://cdn.globalformulation.com/images/wood-coatings-stains-uv-cure-finishes/wood-coatings-stains-uv-cure-finishes-hero.webp" 
