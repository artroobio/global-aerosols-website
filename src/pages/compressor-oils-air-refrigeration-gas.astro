    <aside class="toc-sidebar">
      <nav aria-label="Table of Contents">
        <div class="toc-heading">In This Article</div>
        <ol>
          <li><a href="#compressor-types" target="_top">Compressor Types &amp; Demands</a></li>
          <li><a href="#air-compressor-oils" target="_top">Air Compressor Oils</a></li>
          <li><a href="#refrigeration-lubricants" target="_top">Refrigeration Lubricants</a></li>
          <li><a href="#comparison-table" target="_top">Compressor Oils Compared</a></li>
