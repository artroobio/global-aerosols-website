---
import Layout from '../lc/layouts/Layout.astro';
import IndustriesWeServe from '../lc/components/IndustriesWeServe.astro';
import TripleRevealPaints from '../lc/components/TripleRevealPaints.astro';
import PaintsProcessParallax from '../lc/components/PaintsProcessParallax.astro';
import ContactFormVideo from '../lc/components/ContactFormVideo.astro';
---

<Layout title="Paints & Coatings Formulations | Global Formulation" description="Expert paints and coatings formulation services — alkyd, acrylic, epoxy, polyurethane, and specialty coatings. R&D, reverse engineering, and scale-up support for manufacturers and brands.">
  <section class="split-hero">
    <div class="split-container">
      
      <!-- LEFT COLUMN: Premium interactive video player -->
      <div class="split-left">
        <div class="gf-video-wrapper">
          <video id="heroVid" autoplay muted loop playsinline preload="auto">
            <source src="https://assets.zyrosite.com/AGBzPMBJDQiwDGny/colorful-art-design-gallery-intro-video-8wbdf71UV4Va80Kl.mp4" type="video/mp4">
          </video>
          <!-- HOVER CONTROLS -->
          <div class="gf-video-controls">
            <button id="playBtn" aria-label="Play/Pause">⏸️</button>
            <button id="restartBtn" aria-label="Restart">🔁</button>
            <button id="soundBtn" aria-label="Toggle Sound">🔈</button>
          </div>
        </div>
      </div>
      
      <!-- RIGHT COLUMN: Elegant Title and Subtitle with exact Home Page Typography -->
      <div class="split-right">
        <div class="hero-content-block">
          <span class="category-tag">Formulations & Technology</span>
          <h1 class="hero-title">
            <span class="hero-title__line hero-title__line--primary">
              {"Paints and".split(' ').map(word => (
                <span class="word-wrapper">
                  {word.split('').map(char => (
                    <span class="blue-char">{char}</span>
                  ))}
                </span>
              ))}
            </span>
            <span class="hero-title__line hero-title__line--primary">
              <span class="word-wrapper">
                {"Coatings".split('').map(char => (
                  <span class="blue-char">{char}</span>
                ))}
              </span>
            </span>
            <span class="hero-title__line">
              <span class="word-wrapper">
                {"Formulations".split('').map(char => (
                  <span class="blue-char">{char}</span>
                ))}
              </span>
            </span>
          </h1>
          
          <p class="hero-subtitle">
            Delivering high-performance paints and coatings through advanced resin technology, controlled pigment dispersion, and application-driven durability engineering.
          </p>
          
          <div class="hero-actions">
            <a href="/contact" class="gf-button">
              <span class="button-text">Consult Specialist</span>
              <span class="arrow">➤</span>
            </a>
          </div>
        </div>
      </div>
      
    </div>
  </section>

  <IndustriesWeServe />
  <TripleRevealPaints />
  <PaintsProcessParallax />
  <ContactFormVideo />
</Layout>

<style>
  .split-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    width: 100%;
    background: #ffffff; /* Premium solid white background */
    display: flex;
    align-items: center;
    padding: 120px max(5%, env(safe-area-inset-left)) 80px max(5%, env(safe-area-inset-right));
    overflow: hidden;
  }

  .split-container {
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 5vw, 90px);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* Split Columns styling */
  .split-left {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .split-right {
    width: 100%;
    display: flex;
    justify-content: flex-start;
  }

  .hero-content-block {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Glowing Radial backdrop highlight for soft white page */
  .split-hero::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 20%;
    transform: translate(-50%, -50%);
    width: clamp(300px, 50vw, 800px);
    height: clamp(300px, 50vw, 800px);
    background: radial-gradient(circle, rgba(9, 104, 229, 0.05) 0%, rgba(9, 104, 229, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  /* Override global Navbar to remain highly visible on light page background */
  :global(.navbar) {
    background: rgba(10, 10, 10, 0.9) !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
  }

  /* Tag style */
  .category-tag {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: #0968e5;
    display: inline-block;
    margin-bottom: 18px;
    opacity: 0;
    transform: translateY(15px);
  }

  /* Exact Home Page Typography Styles - Adjusted for White Background */
  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 30px;
    color: #0f172a; /* Premium dark slate */
    text-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
    font-family: 'Outfit', sans-serif;
  }

  .hero-title__line {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.25em;
    max-width: 100%;
  }

  .hero-title__line--primary {
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    line-height: 1.05;
    letter-spacing: -1px;
  }

  .word-wrapper {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.25em;
  }

  .blue-char {
    display: inline-block;
    opacity: 0;
    color: #0f172a;
    -webkit-text-fill-color: #0f172a;
  }

  .hero-subtitle {
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    color: #475569; /* Rich charcoal gray for maximum legibility */
    font-weight: 400;
    line-height: 1.6;
    margin-bottom: 36px;
    max-width: 500px;
    opacity: 0;
    transform: translateY(20px);
  }

  .hero-actions {
    opacity: 0;
    transform: translateY(20px);
  }

  /* PREMIUM VIDEO WRAPPER WITH ANIMATED SHIFT BORDER */
  .gf-video-wrapper {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    border: 3px solid transparent;
    background: linear-gradient(135deg, #0968e5, #00ffcc, #0968e5);
    background-size: 200% 200%;
    animation: gradientShift 8s ease infinite;
    padding: 3px;
    box-shadow: 
      0 25px 60px -15px rgba(15, 23, 42, 0.2),
      0 0 30px rgba(9, 104, 229, 0.1);
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.3, 1);
  }

  .gf-video-wrapper:hover {
    transform: translateY(-4px) scale(1.01);
    box-shadow: 
      0 35px 70px -15px rgba(15, 23, 42, 0.28),
      0 0 45px rgba(9, 104, 229, 0.2);
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .gf-video-wrapper::before {
    content: "";
    display: block;
    padding-top: 56.25%; /* 16:9 ratio */
  }

  .gf-video-wrapper video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
    border-radius: 13px;
    transition: filter 0.5s ease;
  }

  .gf-video-wrapper.paused video {
    filter: blur(8px) brightness(0.7);
  }

  /* PREMIUM NEON GLOW CONTROLS */
  .gf-video-controls {
    position: absolute;
    bottom: 24px;
    right: 24px;
    display: flex;
    gap: 12px;
    opacity: 0;
    transition: opacity 0.4s cubic-bezier(0.25, 1, 0.3, 1), transform 0.4s cubic-bezier(0.25, 1, 0.3, 1);
    transform: translateY(8px);
    z-index: 10;
  }

  .gf-video-wrapper:hover .gf-video-controls {
    opacity: 1;
    transform: translateY(0);
  }

  .gf-video-controls button {
    background: rgba(10, 10, 10, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #00ffff;
    border: 1px solid rgba(0, 255, 255, 0.4);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.3, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
  }

  .gf-video-controls button:hover {
    background: rgba(0, 255, 255, 0.2);
    border-color: #00ffff;
    box-shadow: 
      0 0 15px rgba(0, 255, 255, 0.5),
      inset 0 1px 1px rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .gf-video-controls button:active {
    transform: scale(0.95);
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .split-hero {
      padding: 140px max(5%, env(safe-area-inset-left)) 60px max(5%, env(safe-area-inset-right));
    }

    .split-container {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .split-left {
      order: 1; /* Video on top on tablet/mobile */
      max-width: 720px;
      margin: 0 auto;
    }

    .split-right {
      order: 2;
      justify-content: center;
      text-align: center;
    }

    .hero-content-block {
      align-items: center;
    }

    .hero-title {
      align-items: center;
      margin-bottom: 24px;
    }

    .hero-title__line {
      justify-content: center;
    }

    .hero-subtitle {
      margin-bottom: 30px;
    }
  }

  @media (max-width: 480px) {
    .split-hero {
      padding-top: 120px;
      padding-bottom: 40px;
    }
    
    .gf-video-controls {
      bottom: 16px;
      right: 16px;
      opacity: 1; /* Always visible on touch viewports */
      transform: translateY(0);
    }

    .gf-video-controls button {
      width: 38px;
      height: 38px;
      font-size: 14px;
    }
  }

</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Video interactive controls
  const video = document.getElementById("heroVid") as HTMLVideoElement;
  const playBtn = document.getElementById("playBtn");
  const restartBtn = document.getElementById("restartBtn");
  const soundBtn = document.getElementById("soundBtn");
  const wrapper = document.querySelector(".gf-video-wrapper");

  if (video && playBtn && restartBtn && soundBtn && wrapper) {
    playBtn.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        wrapper.classList.remove("paused");
        playBtn.textContent = "⏸️";
      } else {
        video.pause();
        wrapper.classList.add("paused");
        playBtn.textContent = "▶️";
      }
    });

    restartBtn.addEventListener('click', () => {
      video.currentTime = 0;
      video.play();
      wrapper.classList.remove("paused");
      playBtn.textContent = "⏸️";
    });

    soundBtn.addEventListener('click', () => {
      if (video.muted) {
        video.muted = false;
        soundBtn.textContent = "🔊";
      } else {
        video.muted = true;
        soundBtn.textContent = "🔈";
      }
    });

    video.addEventListener('pause', () => {
      wrapper.classList.add("paused");
      playBtn.textContent = "▶️";
    });

    video.addEventListener('play', () => {
      wrapper.classList.remove("paused");
      playBtn.textContent = "⏸️";
    });
  }

  // GSAP Cinematic Reveal animation for Hero Section
  const heroChars = document.querySelectorAll('.hero-title .blue-char');
  const subtitle = document.querySelector('.hero-subtitle');
  const actions = document.querySelector('.hero-actions');
  const tag = document.querySelector('.category-tag');

  const startAnimation = () => {
    const tl = gsap.timeline();

    // 1. Reveal Category Tag
    tl.to(tag, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power3.out'
    });

    // 2. Reveal Title chars left-to-right (Signature Blue → Solid Dark Slate #0f172a)
    tl.fromTo(heroChars,
      { opacity: 0, x: -12, color: '#0968e5', webkitTextFillColor: '#0968e5' },
      {
        opacity: 1,
        x: 0,
        duration: 0.7,
        stagger: 0.02,
        ease: 'power3.out',
        color: '#0968e5',
        webkitTextFillColor: '#0968e5'
      },
      '-=0.4'
    )
    .to(heroChars, {
      color: '#0f172a',
      webkitTextFillColor: '#0f172a',
      duration: 0.7,
      stagger: 0.02,
      ease: 'power2.inOut'
    }, '-=0.4');

    // 3. Reveal Subtitle
    tl.to(subtitle, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power3.out'
    }, '-=0.6');

    // 4. Reveal Actions
    tl.to(actions, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power3.out'
    }, '-=0.4');
  };

  // Run animation instantly
  startAnimation();

</script>
