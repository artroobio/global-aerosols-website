<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const initReveal = () => {
    gsap.registerPlugin(ScrollTrigger);

    // ── CHARACTER REVEAL FOR HERO TEXT ──
    const tl = gsap.timeline();
    tl.to('.ind-hero .ind-hero-badge', { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' });
    tl.fromTo('.ind-hero .ac',
      { opacity: 0, x: -8, color: '#0968e5', webkitTextFillColor: '#0968e5' },
      { opacity: 1, x: 0, color: '#0968e5', webkitTextFillColor: '#0968e5', duration: 0.5, stagger: 0.012, ease: 'power3.out' },
      '-=0.2'
    ).to('.ind-hero .ac', { clearProps: 'color,webkitTextFillColor', duration: 0.45, stagger: 0.012, ease: 'power2.inOut' }, '-=0.45');
    tl.to('.ind-hero .ind-subtitle', { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.4');
    tl.to('.ind-hero .ind-hero-desc', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3');
    tl.to('.hero-media', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3');

    // ── GENERIC SCROLL REVEALS ──
    const fadeUp = (targets: gsap.TweenTarget, delay = 0, stagger = 0) =>
      gsap.to(targets, { opacity: 1, y: 0, duration: 0.6, stagger, delay, ease: 'power2.out' });

    const section = (sel: string, opts: { bodyDelay?: number; stagger?: number } = {}) => {
      const el = document.querySelector(sel);
      if (!el) return;
      
      ScrollTrigger.create({
        trigger: sel,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          if (el.classList.contains('reveal')) {
            fadeUp(el, opts.bodyDelay ?? 0.1);
          }
          const reveals = el.querySelectorAll('.reveal');
          if (reveals.length > 0) {
            fadeUp(reveals, opts.bodyDelay ?? 0.1, opts.stagger ?? 0.08);
          }
        }
      });
    };

    section('.whatis-section', { stagger: 0.1 });
    section('.capabilities-section', { stagger: 0.05 });
    section('.products-section', { stagger: 0.05 });
    section('.dossier-section', { stagger: 0.06 });
    section('.timeline-section', { stagger: 0.06 });
    section('.resource-section', { stagger: 0.06 });
    section('.cta-banner', { stagger: 0.1 });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReveal);
  } else {
    initReveal();
  }
  document.addEventListener('astro:page-load', initReveal);
</script>
