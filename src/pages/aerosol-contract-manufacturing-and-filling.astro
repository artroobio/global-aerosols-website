---
import Layout from '../lc/layouts/Layout.astro';
import ContactFormVideo from '../lc/components/ContactFormVideo.astro';

const capabilities = [
  {
    num: '01',
    title: 'Product Concept Validation',
    desc: 'Evaluating formulation thermodynamics, pressure feasibility, propellant chemistry, and safety profiles.',
    img: 'https://cdn.globalaerosols.com/images/contract/capabilities/concept_validation.webp'
  },
  {
    num: '02',
    title: 'Custom Formulation Development',
    desc: 'Engineering stable active ingredients, solvent blends, and propellant dispersion ratios.',
    img: 'https://cdn.globalaerosols.com/images/contract/capabilities/formulation_development.webp'
  },
  {
    num: '03',
    title: 'Lab-Scale & Pilot Trials',
    desc: 'Creating prototype batches to validate canister pressure, discharge rate, and spray morphology.',
    img: 'https://cdn.globalaerosols.com/images/contract/capabilities/pilot_trials.webp'
  },
  {
    num: '04',
    title: 'Bulk Manufacturing',
    desc: 'High-precision mixing and chemical compounding in reaction vessels under controlled temperatures.',
    img: 'https://cdn.globalaerosols.com/images/contract/capabilities/bulk_manufacturing.webp'
  },
  {
    num: '05',
    title: 'Aerosol Filling & Gassing',
    desc: 'Under-the-cup and through-the-valve filling lines with high-speed automated propellant charging.',
    img: 'https://cdn.globalaerosols.com/images/contract/capabilities/filling_gassing.webp'
  },
  {
    num: '06',
    title: 'Component Selection',
    desc: 'Selecting optimal can coatings, mounting cup gaskets, dip tubes, valves, and specialized actuators.',
    img: 'https://cdn.globalaerosols.com/images/contract/capabilities/component_selection.webp'
  },
  {
    num: '07',
    title: 'Crimp & Pressure Testing',
    desc: 'Electronic crimp dimension measurement, gross-weight verification, and water bath leak detection.',
    img: 'https://cdn.globalaerosols.com/images/contract/capabilities/pressure_testing.webp'
  },
  {
    num: '08',
    title: 'Labeling & Packaging',
    desc: 'Automated shrink-sleeving, inline printing, batch coding, and dangerous goods cartoning.',
    img: 'https://cdn.globalaerosols.com/images/contract/capabilities/labeling_packaging.webp'
  },
  {
    num: '09',
    title: 'Logistics & Warehousing',
    desc: 'Specialized DG storage, regulatory transport documentation, and global export support.',
    img: 'https://cdn.globalaerosols.com/images/contract/capabilities/logistics_warehousing.webp'
  }
];

const productCategories = [
  {
    num: '01',
    title: 'Automotive Aerosols',
    img: 'https://cdn.globalaerosols.com/images/contract/automotive_cans.webp',
    items: [
      'Brake & Parts Cleaners',
      'Carburetor & Throttle Body Cleaners',
      'Fuel Injector Cleaners',
      'Penetrating Oils & Chain Lubricants',
      'Engine Degreasers & Detailers',
      'Rust Converters & Protectants',
      'Tire Foams & Dashboard Shiners',
      'Glass & Windshield Cleaners',
      'AC Deodorizing & Sanitizing Sprays'
    ]
  },
  {
    num: '02',
    title: 'Industrial Aerosols',
    img: 'https://cdn.globalaerosols.com/images/contract/filling_line.webp',
    items: [
      'Mold Release Sprays (Silicone/Lecithin)',
      'Weld Anti-Spatter Barrier Sprays',
      'Electrical Contact Cleaners (Fast Dry)',
      'PTFE & Dry Film Lubricants',
      'Cold Galvanizing Zinc Rich Primers',
      'Heavy-Duty Degreasers & Solvents',
      'Rust Removers & Shielding Sprays',
      'Surface Preparation Aerosols'
    ]
  },
  {
    num: '03',
    title: 'Household & FMCG',
    img: 'https://cdn.globalaerosols.com/images/contract/valve_spray.webp',
    items: [
      'Air Fresheners & Room Deodorizers',
      'Fabric & Upholstery Fresheners',
      'Insect Control & Repellent Sprays',
      'Multi-Surface Cleaners',
      'Kitchen & Bathroom Specialty Cleaners',
      'Stain Removers & Spot Cleaners',
      'Window & Glass Polishing Sprays'
    ]
  },
  {
    num: '04',
    title: 'Coatings & Specialty',
    img: 'https://cdn.globalaerosols.com/images/contract/hero_paint.webp',
    items: [
      'Industrial & Decorative Spray Paints',
      'Anti-Corrosion Structural Coatings',
      'Heat-Resistant Silicone Coatings',
      'Silicone Lubricant Sprays',
      'Temporary & Line Marking Paints',
      'Pressure-Sensitive Adhesive Sprays',
      'Clear Coats, Sealers & Varnishes'
    ]
  },
  {
    num: '05',
    title: 'Cosmetics & Personal Care',
    img: 'https://cdn.globalaerosols.com/images/contract/hero_cosmetic.webp',
    items: [
      'Deodorant Body Sprays & Antiperspirants',
      'Perfume Body Mists & Colognes',
      'Hair Styling Sprays & Mousses',
      'Dry Shampoos & Volumizers',
      'Shaving Foams, Gels & Aftershaves',
      'Aerosol Sunscreens & Body Shimmers',
      'Foot Deodorizing & Cooling Sprays'
    ]
  }
];

const executionTimeline = [
  {
    step: '1',
    title: 'Requirement Discussion & NDA',
    desc: 'We sign mutual NDAs to protect your intellectual property and align on initial product performance metrics, packaging type, and target market guidelines.'
  },
  {
    step: '2',
    title: 'Product Benchmarking & Feasibility',
    desc: 'Our technical teams audit formulation viscosity, active ingredient solubility, propellant pressure requirements, and container coating compatibility.'
  },
  {
    step: '3',
    title: 'Lab Trials & Sample Approval',
    desc: 'We prepare lab-scale pilot batches, test spray patterns, calculate discharge rates, and send verified samples for your review and laboratory verification.'
  },
  {
    step: '4',
    title: 'Costing & Commercial Finalization',
    desc: 'Once samples are approved, we finalize the commercial structure: raw materials sourcing, valve and can costs, MOQ levels, and packaging dimensions.'
  },
  {
    step: '5',
    title: 'Component Procurement & Setup',
    desc: 'Cans are manufactured/printed, valve assemblies with specified gaskets are prepared, and filling lines are configured with custom tooling for your specific SKU.'
  },
  {
    step: '6',
    title: 'Bulk Production & Automated Filling',
    desc: 'Bulk compounding is performed under strict GMP conditions. Automated lines fill the liquid concentrate, crimp the valves, and charge the LPG/DME/CO₂ propellant.'
  },
  {
    step: '7',
    title: 'Quality Control, Packaging & Dispatch',
    desc: 'Each can undergoes 100% water-bath leak detection, gross weight verification, and inkjet batch coding before packing into UN-certified dangerous goods cartons.'
  }
];

const splitWords = (s: string) => s.split(' ');
---

<Layout 
  title="Aerosol Contract Manufacturing & Filling Services | Global Aerosols" 
  description="End-to-end aerosol contract manufacturing and filling services for automotive, industrial, FMCG, cosmetics and specialty products. Private label, custom formulations, low MOQs, PAN-India & export support by Global Aerosols."
  canonical="https://www.globalaerosols.com/aerosol-contract-manufacturing-and-filling"
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Global Aerosols",
    "url": "https://www.globalaerosols.com",
    "logo": "https://www.globalaerosols.com/assets/logo.png",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+91-9819548320",
      "contactType": "customer service",
      "areaServed": "IN",
      "availableLanguage": ["English"]
    },
    "sameAs": []
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Aerosol Contract Manufacturing and Filling",
    "provider": {
      "@type": "Organization",
      "name": "Global Aerosols"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "India"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Aerosol Manufacturing Services",
      "itemListElement": [
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Private Label Aerosol Manufacturing"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Aerosol Filling & Gassing"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Custom Aerosol Formulation Development"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Export-Oriented Aerosol Production"}}
      ]
    }
  }
  </script>

  <div class="industrial-light-wrapper" id="contract-filling-service">
    
    <!-- ════════════ BREADCRUMBS ════════════ -->
    <div class="ind-breadcrumbs">
      <a href="/" target="_top">Home</a> <span>/</span> <span class="curr-page">Contract Manufacturing</span>
    </div>

    <!-- ════════════ HERO ════════════ -->
    <section class="ind-hero">
      <div class="ind-hero-inner">
        <span class="ind-hero-badge">Turnkey Private Label & Filling</span>
        <h1 class="ind-title">
          {splitWords('Aerosol Contract Manufacturing & Filling').map(word => (
            <span class="aw">{word.split('').map(c => <span class="ac">{c}</span>)}</span>
          ))}
        </h1>
        <p class="ind-subtitle reveal">End-to-End Production for Global Brands</p>
        <p class="ind-hero-desc reveal">
          At Global Aerosols, we provide complete contract manufacturing and filling solutions, from custom formulation support to commercial-scale production and market-ready packaging. We deliver reliable, compliant, and cost-efficient aerosol manufacturing under your private label.
        </p>

        <div class="hero-media reveal">
          <img src="https://cdn.globalaerosols.com/images/contract/hero_filling.webp" alt="Industrial aerosol filling line" loading="eager" width="350" height="240" />
          <img src="https://cdn.globalaerosols.com/images/contract/hero_paint.webp" alt="Premium spray paint aerosol cans" loading="eager" width="350" height="240" />
          <img src="https://cdn.globalaerosols.com/images/contract/hero_cosmetic.webp" alt="Elegant cosmetic aerosol cans" loading="eager" width="350" height="240" />
        </div>
      </div>
    </section>

    <!-- ════════════ WHAT IS SECTION ════════════ -->
    <section class="ind-container whatis-section">
      <div class="two-col-layout reveal">
        <div class="col-text">
          <span class="section-eyebrow">Production Outsourcing</span>
          <h2>What Is Aerosol Contract Manufacturing?</h2>
          <p>Aerosol contract manufacturing allows brands to outsource the entire aerosol production process—including formulation, filling, crimping, gassing, labeling, and packing—without owning manufacturing infrastructure.</p>
          <p>Because aerosols involve pressurized systems, flammable propellants, and regulated transport, contract filling demands specialized infrastructure such as explosion-proof zones, controlled propellant storage, crimping systems, leak detection equipment, and trained operators. These requirements make aerosol filling a regulated industrial activity rather than a simple packaging service.</p>
          <p><strong>You focus on sales and branding — we manage the chemistry, pressure physics, production compliance, and logistics.</strong></p>
        </div>
        <div class="col-list-card">
          <div class="gradient-line"></div>
          <h3>Operational Advantages</h3>
          <ul class="clean-list">
            <li>
              <span class="icon-check">✓</span>
              <div>
                <strong>Scale & Velocity</strong>
                <span>Instant access to semi-automatic & fully automatic high-speed filling lines.</span>
              </div>
            </li>
            <li>
              <span class="icon-check">✓</span>
              <div>
                <strong>Regulatory Conformity</strong>
                <span>PESO-certified, flameproof, and safety-compliant production environment.</span>
              </div>
            </li>
            <li>
              <span class="icon-check">✓</span>
              <div>
                <strong>Quality Assured</strong>
                <span>Rigorous in-process batch control, water-bath tests, and crimp validation.</span>
              </div>
            </li>
            <li>
              <span class="icon-check">✓</span>
              <div>
                <strong>Go-To-Market Speed</strong>
                <span>Bypass heavy capital investment, construction delays, and licensing processes.</span>
              </div>
            </li>
            <li>
              <span class="icon-check">✓</span>
              <div>
                <strong>Capital Efficiency</strong>
                <span>Directly allocate resources to sales, marketing, and distribution.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ════════════ CAPABILITIES ════════════ -->
    <section class="ind-container capabilities-section">
      <div class="grid-header reveal">
        <span class="grid-eyebrow">Integrated Services</span>
        <h2 class="grid-title">End-to-End Aerosol Capabilities</h2>
        <div class="grid-line-bar"></div>
      </div>

      <div class="z-scroll-container">
        {capabilities.map((cap, idx) => (
          <div class={`z-item reveal ${idx % 2 === 1 ? 'is-reversed' : ''}`} data-index={idx}>
            <div class="z-image-zone">
              <img src={cap.img} alt={cap.title} loading="lazy" width="600" height="400" />
            </div>
            <div class="z-text-zone">
              <span class="z-num">{cap.num}</span>
              <h3>{cap.title}</h3>
              <p>{cap.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════════ PRODUCTS WE MANUFACTURE ════════════ -->
    <section class="ind-container products-section">
      <div class="grid-header reveal">
        <span class="grid-eyebrow">Formulations</span>
        <h2 class="grid-title">Aerosol Products We Manufacture</h2>
        <div class="grid-line-bar"></div>
      </div>

      <div class="products-grid">
        {productCategories.map((cat, idx) => (
          <div class="prod-cat-card reveal" data-index={idx}>
            <div class="cat-img-zone">
              <img src={cat.img} alt={cat.title} loading="lazy" width="360" height="180" />
            </div>
            <div class="cat-header">
              <span class="cat-num">{cat.num}</span>
              <h3>{cat.title}</h3>
            </div>
            <ul class="cat-prod-list">
              {cat.items.map(item => (
                <li>
                  <span class="bullet">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════════ TECHNICAL SPECIFICATIONS DOSSIER (DARK) ════════════ -->
    <section class="tech-dossier dossier-section">
      <div class="dossier-container">
        <div class="dossier-head reveal">
          <span class="dossier-eyebrow">Dossier & Specifications</span>
          <h2 class="dossier-title">Technical Dossier & Operations</h2>
          <div class="dossier-line"></div>
        </div>

        <div class="dossier-grid">
          <div class="dossier-card reveal">
            <h3>1. Filling Infrastructure</h3>
            <p>Our manufacturing facility is equipped with automated and semi-automated aerosol filling lines capable of handling diverse liquid product formulations. We run dedicated liquid, powder, and gel filling systems alongside multi-stage gas dosing chambers.</p>
            <ul class="dossier-list">
              <li>High-speed automatic rotary filling, valve crimping, and propellant charging lines.</li>
              <li>Propellant compatibility: Liquefied Petroleum Gas (LPG/Propane-Butane), Dimethyl Ether (DME), Carbon Dioxide (CO₂), and Nitrogen (N₂).</li>
              <li>Ex-proof and ATEX-compliant filling zones with flame detectors and air exchange systems.</li>
            </ul>
          </div>

          <div class="dossier-card reveal">
            <h3>2. Custom Formulation & Reverse Engineering</h3>
            <p>We provide chemical formulation and engineering assistance. We help brands bench-test active ingredients, adjust pressure curves, and select appropriate solvent blends to prevent post-launch chemical failures.</p>
            <ul class="dossier-list">
              <li>Reverse engineering of existing benchmark market products.</li>
              <li>Viscosity optimization for smooth spray morphology.</li>
              <li>Propellant ratio calculations to achieve target drop size distributions.</li>
              <li>Accelerated stability and packaging corrosion testing.</li>
            </ul>
          </div>

          <div class="dossier-card reveal">
            <h3>3. Private Labeling & Intellectual Property</h3>
            <p>Our private label service is structured to bring your product lineup to market with total compliance. We operate under strict NDAs, securing your formulas and trade secrets.</p>
            <ul class="dossier-list">
              <li>Turnkey branding: we handle can printing, shrink sleeves, and label integration.</li>
              <li>IP protection: All customer formulations are segregated and secured in encrypted databases.</li>
              <li>Flexible scheduling: support for low pilot batch sizes up to full-scale commercial launches.</li>
            </ul>
          </div>

          <div class="dossier-card reveal">
            <h3>4. Quality Control & Safety Standards</h3>
            <p>Aerosols are pressurized vessels, making quality control a legal requirement. We enforce strict in-process metrics from initial material checks to outbound logistics packaging validation.</p>
            <ul class="dossier-list">
              <li>Incoming material inspection (can pressure ratings, valve gaskets, active purity).</li>
              <li>Crimp inspection: continuous validation of crimp depth and diameter.</li>
              <li>100% water-bath testing or electronic micro-leak checking to guarantee seal integrity.</li>
              <li>MSDS, TDS, and dangerous goods transport compliance support.</li>
            </ul>
          </div>

          <div class="dossier-card reveal">
            <h3>5. Component & Packaging Support</h3>
            <p>Aerosol compatibility depends on the precise union of metal, plastic, rubber, and gas. We assist in matching these components based on chemical compatibility data.</p>
            <ul class="dossier-list">
              <li>Containers: Tinplate steel (52mm, 57mm, 65mm) and monobloc aluminium cans (35mm, 45mm, 53mm).</li>
              <li>Valves: 1-inch mounting cups, male/female stems, specialized gaskets (Neoprene, Buna, Viton).</li>
              <li>Actuators: Swirl inserts, MBUs, extension tubes, trigger sprayers, and tamper-evident caps.</li>
            </ul>
          </div>

          <div class="dossier-card reveal">
            <h3>6. MOQs & Scalability</h3>
            <p>Minimum Order Quantities (MOQs) are dependent on container size, formulation complexity, and packaging styles. We balance setup costs with order sizes to optimize unit economics.</p>
            <ul class="dossier-list">
              <li>Support for small-run pilot trials to test market feasibility.</li>
              <li>Turnkey scaling pipelines to smoothly transition from startup SKUs to industrial volumes.</li>
              <li>Flexible warehouse dispatch schedules for domestic and export projects.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════ EXECUTION FLOW TIMELINE ════════════ -->
    <section class="ind-container timeline-section">
      <div class="grid-header reveal">
        <span class="grid-eyebrow">Methodology</span>
        <h2 class="grid-title">Typical Project Execution Flow</h2>
        <div class="grid-line-bar"></div>
      </div>

      <div class="timeline-container">
        {executionTimeline.map((item, idx) => (
          <div class="timeline-item reveal" data-index={idx}>
            <div class="timeline-circle"></div>
            <div class="timeline-content">
              <h3>{item.step}. {item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════════ WHY BRANDS CHOOSE US / WHO WE SERVE ════════════ -->
    <section class="resource-section">
      <div class="resource-head reveal">
        <span class="resource-eyebrow">Strategic Partnership</span>
        <h2 class="heading-font">Why Brands Choose <span class="highlight">Global Aerosols</span></h2>
        <p class="resource-subtitle-text">We serve FMCG conglomerates, automotive distributors, industrial suppliers, D2C startups, and international exporters.</p>
      </div>

      <div class="resource-grid">
        <div class="resource-card reveal">
          <h3 class="resource-title">Deep Formulation Expertise</h3>
          <p class="resource-p">We don't just fill cans. Our lead chemists and process engineers support you in formulation design, solvent compatibility, and chemical safety metrics.</p>
        </div>
        <div class="resource-card reveal">
          <h3 class="resource-title">Multi-Industry Coverage</h3>
          <p class="resource-p">From high-pressure industrial cold-galvanizing primers to delicate cosmetic body sprays, we fill formulations across diverse markets.</p>
        </div>
        <div class="resource-card reveal">
          <h3 class="resource-title">Strict Confidentiality</h3>
          <p class="resource-p">Your formulas are protected by mutual NDAs and strict internal security protocols. We guarantee full intellectual property custody.</p>
        </div>
        <div class="resource-card reveal">
          <h3 class="resource-title">Pan-India & Export Ready</h3>
          <p class="resource-p">We ensure all packaging, labeling, and shipping documents are fully compliant with international maritime and air dangerous goods standards.</p>
        </div>
      </div>
    </section>

    <!-- ════════════ CTA BOX (BLUE GRADIENT) ════════════ -->
    <section class="cta-banner reveal">
      <div class="cta-inner">
        <h2>Get Your Aerosol Product Manufactured Today</h2>
        <p>Partner with Global Aerosols to formulate, test, fill, and package your product range. We provide turnkey compliance, low MOQs, and professional support for domestic and international export projects.</p>
        
        <div class="cta-info-box">
          <div class="cta-contact-item">
            <strong>Email:</strong> <a href="mailto:globalaerosols@gmail.com">globalaerosols@gmail.com</a>
          </div>
          <div class="cta-contact-item">
            <strong>Phone / WhatsApp:</strong> <a href="tel:+919819548320">+91-9819548320</a>
          </div>
          <div class="cta-contact-item">
            <strong>Location Support:</strong> PAN-India & Export Shipments
          </div>
        </div>
      </div>
    </section>

  </div>

  <ContactFormVideo />
</Layout>

<style>
  /* ════════════ 1. THEME VARIABLES ════════════ */
  :root {
    --light-bg: #f8fafc;       
    --light-card: #ffffff;     
    --light-text-main: #0f172a; 
    --light-text-sub: #475569;  
    --light-border: #e2e8f0;   
    --brand-blue: #0968e5;  
    --brand-blue-hover: #2563eb;
    --dossier-bg: #0f172a;
    --dossier-card: #1e293b;
    --dossier-text: #cbd5e1;
    --grid-line: rgba(203, 213, 225, 0.25);
  }

  .industrial-light-wrapper * { 
    box-sizing: border-box; 
  }

  .industrial-light-wrapper {
    font-family: 'Inter', sans-serif;
    background-color: var(--light-bg);
    color: var(--light-text-main);
    padding-bottom: 0px; 
    /* Blueprint Technical Grid Background */
    background-image: 
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 50px 50px;
    position: relative;
    overflow: hidden;
  }

  /* Typography overrides */
  .heading-font, h1, h2, h3, .prod-name, .resource-title, .dossier-title {
    font-family: 'Outfit', 'Montserrat', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  /* GSAP initial reveal state */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
  }

  /* Animated heading structures */
  .aw { 
    display: inline-block; 
    white-space: nowrap; 
    margin-right: 0.24em; 
  }
  .ac { 
    display: inline-block; 
    opacity: 0; 
    color: var(--brand-blue); 
    -webkit-text-fill-color: var(--brand-blue); 
  }

  /* ════════════ 2. BREADCRUMBS ════════════ */
  .ind-breadcrumbs {
    max-width: 1400px;
    margin: 0 auto;
    padding: 75px 30px 0; /* Nav offset */
    font-size: 0.72rem;
    color: var(--light-text-sub);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 2px;
  }
  .ind-breadcrumbs a {
    text-decoration: none;
    color: var(--light-text-sub);
    transition: color 0.25s ease;
  }
  .ind-breadcrumbs a:hover {
    color: var(--brand-blue);
  }
  .ind-breadcrumbs span {
    color: #94a3b8;
    margin: 0 8px;
  }
  .ind-breadcrumbs .curr-page {
    color: var(--light-text-main);
  }

  /* ════════════ 3. HERO SECTION ════════════ */
  .ind-hero {
    background: #ffffff;
    border-bottom: 6px solid var(--brand-blue);
    padding: 40px 30px 50px;
    text-align: center;
    position: relative;
    box-shadow: 0 4px 30px rgba(15, 23, 42, 0.03);
    margin-bottom: 60px;
    overflow: hidden;
  }

  .ind-hero::after {
    content: '';
    position: absolute;
    bottom: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
