                            <tr>
                                <td><strong>Chemical Compatibility</strong></td>
                                <td>Long-term chemical compatibility with formulations and propellants</td>
                            </tr>
                            <tr>
                                <td><strong>Mechanical Integrity</strong></td>
                                <td>Mechanical integrity under pressure and temperature variation</td>
                            </tr>
                            <tr>
                                <td><strong>Manufacturing</strong></td>
                                <td>Filling line compatibility and crimp reliability</td>
                            </tr>
                            <tr>
                                <td><strong>Economics</strong></td>
                                <td>Total cost of ownership, not just per-can price</td>
                            </tr>
                        </tbody>
