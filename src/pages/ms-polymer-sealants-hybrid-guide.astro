          width="1200"
          height="630"
          loading="eager"
        />
      </div>
      </div>
    </div>
  </div>

  <!-- TWO-COLUMN BODY -->
  <div class="page-body">

    <aside class="toc-sidebar">
      <nav aria-label="Table of Contents">
        <div class="toc-heading">In This Article</div>
        <ol>
          <li><a href="#what-is-ms-polymer" target="_top">What Are MS Polymer Sealants?</a></li>
          <li><a href="#cure-mechanism" target="_top">Silyl-Terminated Polymer Cure</a></li>
          <li><a href="#vs-comparison" target="_top">MS vs Silicone vs Polyurethane</a></li>
          <li><a href="#formulation" target="_top">Formulation Components</a></li>
          <li><a href="#applications" target="_top">Construction &amp; Industrial Uses</a></li>
          <li><a href="#regulatory" target="_top">Regulatory Advantages</a></li>
          <li><a href="#faq" target="_top">Frequently Asked Questions</a></li>
        </ol>
      </nav>
    </aside>

