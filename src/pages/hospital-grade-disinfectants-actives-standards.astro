              <tr><td>Hydrogen peroxide</td><td>H₂O₂ (stabilised)</td><td>Oxidation (free radicals)</td><td>Broad; sporicidal at high concentration</td><td>EN 1276, EN 14476</td><td>Bleaches fabrics; high concentration required for spores</td></tr>
              <tr><td>Glutaraldehyde</td><td>Glutaraldehyde 2%</td><td>Protein alkylation</td><td>Very broad; high-level disinfectant/sterilant</td><td>EN 1276</td><td>Toxic, occupational sensitiser, slow action (up to 3 h for sporicidal)</td></tr>
