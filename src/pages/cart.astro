---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
---

<Layout title="Your Cart — Global Formulation" description="Review your selected e-books." robots="noindex, nofollow">
  <div class="cart-page">
    <div class="cart-inner">
      <h1>Your Cart</h1>
      <div id="cart-items">
        <p class="empty-msg">Your cart is empty.</p>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  function renderCart() {
    const cart  = JSON.parse(localStorage.getItem('gf_cart') || '[]');
    const el    = document.getElementById('cart-items');
    if (!el) return;

    if (cart.length === 0) {
      el.innerHTML = '<p class="empty-msg">Your cart is empty. <a href="/store">Browse e-books →</a></p>';
      return;
    }

    el.innerHTML = cart.map(item => `
      <div class="cart-item" data-slug="${item.slug}">
        <div class="cart-item-info">
          <h2>${item.title}</h2>
          <div class="cart-item-price">
            ₹${(item.price_inr / 100).toLocaleString('en-IN')}
            <span>$${(item.price_usd / 100).toFixed(2)}</span>
          </div>
        </div>
        <div class="cart-item-actions">
          <a href="/checkout/${item.slug}" class="checkout-btn">Buy Now</a>
          <button class="remove-btn" onclick="removeItem('${item.slug}')">Remove</button>
        </div>
      </div>
    `).join('');
  }

  window.removeItem = function(slug) {
    const cart    = JSON.parse(localStorage.getItem('gf_cart') || '[]');
    const updated = cart.filter(i => i.slug !== slug);
    localStorage.setItem('gf_cart', JSON.stringify(updated));
    window.dispatchEvent(new CustomEvent('gf-cart-updated'));
    renderCart();
  };

  renderCart();
</script>

<style>
  .cart-page {
    min-height: 100vh;
    background: #F9F9F7;
    padding: 56px 24px 96px;
  }

  .cart-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    color: #0A0A0A;
    margin-bottom: 32px;
  }

  .empty-msg {
    color: #6B7280;
    font-size: 1rem;
  }

  .empty-msg a { color: #0968e5; }

  .cart-item {
    background: #fff;
    border: 1px solid #E4E4E0;
    border-radius: 10px;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }

  .cart-item-info h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #0A0A0A;
    margin: 0 0 6px;
  }

  .cart-item-price {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0A0A0A;
  }

  .cart-item-price span {
    font-size: 0.82rem;
    color: #9CA3AF;
    font-weight: 400;
    margin-left: 8px;
  }

  .cart-item-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .checkout-btn {
    background: #0968e5;
    color: #fff;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .remove-btn {
    background: none;
    border: none;
    color: #9CA3AF;
    font-size: 0.82rem;
    cursor: pointer;
    padding: 4px;
    transition: color 0.15s;
  }

  .remove-btn:hover { color: #EF4444; }

  @media (max-width: 560px) {
    .cart-item { flex-wrap: wrap; }
  }
</style>
