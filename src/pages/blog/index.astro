const categories = ["All", "Aerosol Technology & Engineering", "Aerosol Propellants & Valves", "Industrial & Specialty Aerosols", "Personal Care & Cosmetic Aerosols", "Aerosol Regulatory & Safety", "Paints & Coatings", "Lubricants & Tribology", "Lubricants", "Household & Industrial Cleaners", "Industrial Cleaners", "Household", "Cosmetics & Personal Care", "Adhesives & Sealants", "Adhesives & Polymer Care", "Pharmaceuticals & Healthcare", "Aerosols & Gas Dosing", "Construction Chemicals", "Agrochemicals", "Green Chemistry", "MaaS & Strategy", "Formulation Chemistry"];

const listPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Global Aerosols Insights & Articles",
  "url": "https://www.globalaerosols.com/blog",
  "description": "Insights, technical guides, formulations, and advanced research in industrial cleaners, aerosols, and green chemical engineering."
};
---

<Layout
  title="Industrial Chemical Formulations & Technology Blog | Global Aerosols"
  description="Explore technical insights, chemical formulation guides, aerosol technologies, and sustainable chemical engineering articles from specialist consultant Absar Khan."
  canonical="https://www.globalaerosols.com/blog/"
  ogImage="https://cdn.globalaerosols.com/images/blog/industrial-cleaners-product-range-3WfzvDb7jHzmb5rd.webp"
  schemaJson={listPageSchema}
>

  <!-- ── Hero ── -->
  <section class="blog-hero">
    <div class="blog-hero-inner">
      <span class="blog-eyebrow">Research &amp; Insights Hub</span>
      <h1 class="blog-title">
        Chemical Formulation<br class="br-desk" /> &amp; Technology Insights
      </h1>
      <p class="blog-subtitle">
        Deep-dives into surfactant science, industrial process engineering, aerosol gas dosing,
        and GHS-compliant green formulation techniques — written by practising specialists.
      </p>
      <div class="blog-stats">
        <div class="stat"><span class="stat-n">{allPosts.length}+</span><span class="stat-l">Articles</span></div>
        <div class="stat-div"></div>
        <div class="stat"><span class="stat-n">15+</span><span class="stat-l">Industries</span></div>
        <div class="stat-div"></div>
        <div class="stat"><span class="stat-n">Expert</span><span class="stat-l">Authors</span></div>
      </div>
    </div>
  </section>

  <!-- ── Body: sidebar + grid ── -->
  <div class="blog-body">
    <div class="blog-body-inner">

      <!-- ── Left sidebar ── -->
      <aside class="blog-sidebar">

        <!-- Search -->
        <div class="sidebar-search-wrap">
          <svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            type="text"
            id="blog-search-input"
            placeholder="Search articles…"
            autocomplete="off"
          />
        </div>

        <p class="sidebar-label">Categories</p>

        <!-- Category filters — vertically stacked -->
        <div id="category-filter-container">
          {categories.map((cat) => (
            <button
              class={`fpill${cat === 'All' ? ' fpill-active' : ''}`}
              data-category={cat}
            >{cat}</button>
          ))}
        </div>

      </aside>

      <!-- ── Main grid ── -->
      <main class="blog-main">

        <p class="results-count" id="results-count">{allPosts.length} articles</p>

        <div id="no-results-message" style="display:none;" class="no-results">
          No articles matched your search. Try a different keyword or reset the filter.
        </div>

        <div id="blogs-grid" class="blog-grid">
          {allPosts.map((post, idx) => (
            <a
              href={post.url}
              class="bcard"
              data-category={post.category}
              data-tags={post.tags.join(',')}
              data-title={post.title.toLowerCase()}
              data-description={post.description.toLowerCase()}
            >
              <!-- Image -->
              <div class="bcard-img-wrap">
                <img
                  src={post.coverImage}
                  alt={post.title}
                  loading={idx < 6 ? "eager" : "lazy"}
                  decoding="async"
                />
                <span class="bcard-cat">{post.category}</span>
              </div>

              <!-- Body -->
              <div class="bcard-body">
                <div class="bcard-meta">
                  <span>{post.publishDate}</span>
                  <span class="meta-dot"></span>
                  <span>{post.readingTime} read</span>
                </div>
                <h2 class="bcard-title">{post.title}</h2>
                <p class="bcard-desc">{post.description}</p>
                <div class="bcard-footer">
                  <div class="bcard-tags">
                    {post.tags.slice(0, 3).map(tag => (
                      <span class="btag">#{tag}</span>
                    ))}
                  </div>
                  <span class="bcard-read">
                    Read
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>

      </main>

    </div>
  </div>

</Layout>

<style>
  /* ── HERO ── */
  .blog-hero {
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(9, 104, 229,0.07) 0%, transparent 65%),
      #f8fafc;
    padding: 130px max(6%, env(safe-area-inset-left)) 80px;
    box-sizing: border-box;
    border-bottom: 1px solid #e2e8f0;
  }
  .blog-hero-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .blog-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: #0968e5;
    margin-bottom: 20px;
  }
  .blog-title {
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin: 0 0 20px 0;
    font-family: 'Outfit', sans-serif;
  }
  .br-desk { display: none; }
  @media (min-width: 640px) { .br-desk { display: inline; } }
  .blog-subtitle {
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    color: #64748b;
    line-height: 1.7;
    max-width: 640px;
    margin: 0 auto 36px;
  }
  .blog-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }
  .stat { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .stat-n { font-size: 1.6rem; font-weight: 800; color: #0f172a; font-family: 'Outfit', sans-serif; line-height: 1; }
  .stat-l { font-size: 0.72rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 2px; font-weight: 600; }
  .stat-div { width: 1px; height: 32px; background: #e2e8f0; }

  /* ── BODY LAYOUT ── */
  .blog-body {
    background: #f1f5f9;
    padding: 48px max(5%, env(safe-area-inset-right)) 100px;
    box-sizing: border-box;
  }
  .blog-body-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 224px 1fr;
    gap: 36px;
    align-items: start;
  }

  /* ── SIDEBAR ── */
  .blog-sidebar {
    position: sticky;
    top: 84px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px 16px 24px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Search inside sidebar */
  .sidebar-search-wrap {
    position: relative;
    margin-bottom: 16px;
  }
  .search-ico {
    position: absolute;
    left: 11px;
    top: 50%;
    transform: translateY(-50%);
    width: 14px; height: 14px;
    color: #94a3b8;
    pointer-events: none;
  }
  #blog-search-input {
    width: 100%;
    box-sizing: border-box;
    padding: 9px 12px 9px 34px;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #0f172a;
    font-size: 0.85rem;
    outline: none;
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  #blog-search-input::placeholder { color: #94a3b8; }
  #blog-search-input:focus {
    border-color: #0968e5;
    box-shadow: 0 0 0 3px rgba(9, 104, 229,0.1);
    background: #fff;
  }

  /* Sidebar section label */
  .sidebar-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: #94a3b8;
    margin: 6px 0 8px 4px;
    padding: 0;
  }

  /* Category filter buttons */
  .fpill {
    display: block;
    width: 100%;
    text-align: left;
    padding: 8px 10px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: #475569;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: background 0.15s ease, color 0.15s ease;
    font-family: inherit;
    line-height: 1.4;
  }
  .fpill:hover { background: #eff6ff; color: #0968e5; }
  .fpill-active {
    background: #eff6ff;
    color: #0968e5;
    font-weight: 700;
    border-left: 3px solid #0968e5;
    padding-left: 7px;
  }

  /* ── MAIN ── */
  .blog-main {
    min-height: 60vh;
  }
  .results-count {
    font-size: 0.82rem;
    color: #94a3b8;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin: 0 0 24px 0;
  }
  .no-results {
    text-align: center;
    padding: 80px 24px;
    border: 1px dashed #cbd5e1;
    border-radius: 16px;
    color: #94a3b8;
    font-size: 1rem;
    background: #fff;
  }

  /* ── GRID ── */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  @media (max-width: 1280px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px)  { .blog-grid { grid-template-columns: 1fr; gap: 16px; } }

  /* ── CARD ── */
  .bcard {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  }
  .bcard:hover {
    border-color: #93c5fd;
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(9, 104, 229,0.12);
  }

  /* Image */
  .bcard-img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
  }
  .bcard-img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .bcard:hover .bcard-img-wrap img { transform: scale(1.05); }

  .bcard-cat {
    position: absolute;
    top: 12px; left: 12px;
    background: rgba(255,255,255,0.92);
    color: #0968e5;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 9999px;
    border: 1px solid rgba(9, 104, 229,0.2);
    backdrop-filter: blur(6px);
  }

  /* Body */
  .bcard-body {
    padding: 22px 22px 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }
  .bcard-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.77rem;
    color: #94a3b8;
    font-weight: 500;
  }
  .meta-dot {
    width: 3px; height: 3px;
    border-radius: 50%;
    background: #cbd5e1;
    flex-shrink: 0;
  }
  .bcard-title {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    font-weight: 700;
    color: #1e293b;
    line-height: 1.35;
    margin: 0;
    font-family: 'Outfit', sans-serif;
    transition: color 0.2s ease;
  }
  .bcard:hover .bcard-title { color: #0968e5; }
  .bcard-desc {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bcard-footer {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .bcard-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .btag {
    font-size: 0.7rem;
    color: #64748b;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 500;
  }
  .bcard-read {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #0968e5;
    white-space: nowrap;
    flex-shrink: 0;
    transition: gap 0.2s ease;
  }
  .bcard:hover .bcard-read { gap: 7px; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .blog-body-inner {
      grid-template-columns: 1fr;
    }
    .blog-sidebar {
      position: static;
      /* On mobile: hide vertical list, show as horizontal scroll */
      padding: 16px;
    }
    #category-filter-container {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .fpill {
      display: inline-block;
      width: auto;
      white-space: nowrap;
      padding: 6px 14px;
      border-radius: 9999px;
      border: 1px solid #e2e8f0;
      background: #f8fafc;
      overflow: visible;
      text-overflow: unset;
      border-left: none;
    }
    .fpill-active {
      background: #0968e5;
      color: #fff;
      border-color: #0968e5;
      border-left: none;
      padding-left: 14px;
    }
    .blog-hero { padding: 110px 22px 60px; }
    .blog-body { padding: 28px 20px 72px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput   = document.getElementById('blog-search-input') as HTMLInputElement;
    const filterButtons = document.querySelectorAll('.fpill');
    const blogCards     = document.querySelectorAll('.bcard');
    const noResults     = document.getElementById('no-results-message');
    const blogsGrid     = document.getElementById('blogs-grid');
    const countEl       = document.getElementById('results-count');

    let activeCategory = 'All';
    let searchQuery    = '';

    function applyFilter() {
      blogsGrid && (blogsGrid.style.opacity = '0.5');
      setTimeout(() => {
        let visible = 0;
        blogCards.forEach((node) => {
          const card = node as HTMLElement;
          const cat   = card.dataset.category ?? '';
          const title = card.dataset.title ?? '';
          const desc  = card.dataset.description ?? '';
          const tags  = card.dataset.tags ?? '';
          const catOk = activeCategory === 'All' || cat === activeCategory;
          const srchOk = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery) || tags.toLowerCase().includes(searchQuery);
          const show = catOk && srchOk;
          (card as HTMLElement).style.display = show ? 'flex' : 'none';
          if (show) visible++;
        });

        if (noResults && blogsGrid) {
          if (visible === 0) {
            noResults.style.display = 'block';
            blogsGrid.style.display = 'none';
          } else {
            noResults.style.display = 'none';
            blogsGrid.style.display = 'grid';
          }
        }
        if (countEl) countEl.textContent = `${visible} article${visible !== 1 ? 's' : ''}`;
        blogsGrid && (blogsGrid.style.opacity = '1');
      }, 120);
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('fpill-active'));
        btn.classList.add('fpill-active');
        activeCategory = (btn as HTMLElement).dataset.category ?? 'All';
        applyFilter();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilter();
    });
  });
</script>
