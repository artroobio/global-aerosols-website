---

<Layout
  title="Industrial Chemical Formulations & Technology Blog | Global Formulation"
  description="Explore technical insights, chemical formulation guides, aerosol technologies, and sustainable chemical engineering articles from specialist consultant Absar Khan."
  canonical="https://www.globalaerosols.com/blog/"
  ogImage="https://assets.zyrosite.com/AGBzPMBJDQiwDGny/industrial-cleaners-product-range-3WfzvDb7jHzmb5rd.jpg"
  schemaJson={listPageSchema}
>

  <!-- ── Hero ── -->
  <section class="blog-hero">
    <div class="blog-hero-inner">
      <span class="blog-eyebrow">Research &amp; Insights Hub</span>
      <h1 class="blog-title">
        Chemical Formulation<br class="br-desk" /> &amp; Technology Insights
      </h1>
      <p class="blog-subtitle">
        Deep-dives into surfactant science, industrial process engineering, aerosol gas dosing,
        and GHS-compliant green formulation techniques — written by practising specialists.
      </p>
      <div class="blog-stats">
        <div class="stat"><span class="stat-n">{allPosts.length}+</span><span class="stat-l">Articles</span></div>
        <div class="stat-div"></div>
        <div class="stat"><span class="stat-n">15+</span><span class="stat-l">Industries</span></div>
        <div class="stat-div"></div>
        <div class="stat"><span class="stat-n">Expert</span><span class="stat-l">Authors</span></div>
      </div>
    </div>
  </section>

  <!-- ── Body: sidebar + grid ── -->
  <div class="blog-body">
    <div class="blog-body-inner">

      <!-- ── Left sidebar ── -->
      <aside class="blog-sidebar">

        <!-- Search -->
        <div class="sidebar-search-wrap">
          <svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            type="text"
            id="blog-search-input"
            placeholder="Search articles…"
            autocomplete="off"
          />
        </div>

        <p class="sidebar-label">Categories</p>

        <!-- Category filters — vertically stacked -->
        <div id="category-filter-container">
          {categories.map((cat) => (
            <button
              class={`fpill${cat === 'All' ? ' fpill-active' : ''}`}
              data-category={cat}
            >{cat}</button>
          ))}
        </div>

      </aside>

      <!-- ── Main grid ── -->
      <main class="blog-main">

        <p class="results-count" id="results-count">{allPosts.length} articles</p>

        <div id="no-results-message" style="display:none;" class="no-results">
          No articles matched your search. Try a different keyword or reset the filter.
        </div>

        <div id="blogs-grid" class="blog-grid">
          {allPosts.map((post, idx) => (
            <a
              href={post.url}
              class="bcard"
              data-category={post.category}
              data-tags={post.tags.join(',')}
              data-title={post.title.toLowerCase()}
              data-description={post.description.toLowerCase()}
            >
              <!-- Image -->
              <div class="bcard-img-wrap">
                <img
                  src={post.coverImage}
                  alt={post.title}
                  loading={idx < 6 ? "eager" : "lazy"}
                  decoding="async"
                />
                <span class="bcard-cat">{post.category}</span>
              </div>

              <!-- Body -->
              <div class="bcard-body">
                <div class="bcard-meta">
                  <span>{post.publishDate}</span>
                  <span class="meta-dot"></span>
                  <span>{post.readingTime} read</span>
                </div>
                <h2 class="bcard-title">{post.title}</h2>
                <p class="bcard-desc">{post.description}</p>
                <div class="bcard-footer">
                  <div class="bcard-tags">
                    {post.tags.slice(0, 3).map(tag => (
                      <span class="btag">#{tag}</span>
                    ))}
                  </div>
                  <span class="bcard-read">
                    Read
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>

      </main>

    </div>
  </div>

</Layout>

<style>
