              </tr>
              <tr style="border-bottom: 1px solid var(--border);">
                <td style="padding: 15px; font-weight: 600; border: 1px solid var(--border);">Alkyl Glucosides (Nonionic)</td>
                <td style="padding: 15px; border: 1px solid var(--border);">Decyl Glucoside</td>
                <td style="padding: 15px; border: 1px solid var(--border);">Moderate / Coarse</td>
