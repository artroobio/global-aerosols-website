---
import Layout from '../lc/layouts/Layout.astro';
---

<Layout
  title="Sorry, We Couldn't Find That Page | Global Aerosols"
  description="The page you're looking for doesn't exist or may have moved. Explore our aerosol formulations, services, and technical engineering resources instead."
  robots="noindex, follow"
>
  <section class="not-found">
    <div class="not-found-inner">
      <p class="eyebrow">404 Error</p>
      <h1>Page Not Found</h1>
      <p class="lead">
        The page you're looking for doesn't exist or may have moved. Try one of the links below, or head back to the homepage.
      </p>
      <div class="not-found-links">
        <a href="/" class="not-found-btn primary">Go to Homepage</a>
        <a href="/products/" class="not-found-btn">Browse Products</a>
        <a href="/contact/" class="not-found-btn">Contact Us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    padding: 100px 24px 80px;
    text-align: center;
  }
  .not-found-inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0968e5;
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.1;
    margin-bottom: 20px;
    font-family: 'Outfit', sans-serif;
  }
  .lead {
    font-size: 1.1rem;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 36px;
  }
  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }
  .not-found-btn {
    display: inline-block;
    padding: 12px 26px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    color: #0968e5;
    border: 1px solid #0968e5;
    transition: all 0.2s ease;
  }
  .not-found-btn.primary {
    background: #0968e5;
    color: #fff;
  }
  .not-found-btn:hover {
    transform: translateY(-2px);
  }
</style>
