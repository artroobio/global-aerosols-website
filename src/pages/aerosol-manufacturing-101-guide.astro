                <th style="padding: 12px 14px; border: 1px solid #e5e7eb; font-weight: 600;">Propellant</th>
                <th style="padding: 12px 14px; border: 1px solid #e5e7eb; font-weight: 600;">Chemical Formula</th>
                <th style="padding: 12px 14px; border: 1px solid #e5e7eb; font-weight: 600;">Type</th>
