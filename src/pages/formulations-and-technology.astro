---
import Layout from '../lc/layouts/Layout.astro';
import ServicePageAnimations from '../lc/components/ServicePageAnimations.astro';

const capabilities = [
  'Emulsion chemistry — O/W, W/O, and multiple emulsion systems',
  'Surfactant selection, synergy design, and CMC optimisation',
  'Reactive and non-reactive coating systems',
  'Lubricant base oil selection and additive blending',
  'Rheology modification and viscosity engineering',
  'Aerosol and pressurised propellant formulation',
  'Active delivery systems in personal care',
  'Polymer and resin selection for adhesives and sealants',
  'Biocide and preservative system design',
  'Green chemistry and VOC-reduced alternatives',
];

const steps = [
  {
    n: '01',
    t: 'Brief & Feasibility',
    d: 'We map your product goals, target performance specs, cost envelope, and regulatory requirements before any lab work begins. No assumptions, no guesswork — just a clear picture of what success looks like.',
  },
  {
    n: '02',
    t: 'Formulation Development',
    d: 'Iterative lab development against your benchmarks — prototype, test, refine — until performance, stability, and cost targets are met. Every decision is traceable and documented.',
  },
  {
    n: '03',
    t: 'Validation & Testing',
    d: 'Stability testing across temperature and humidity, compatibility checks, performance testing under real application conditions, and regulatory screening before anything leaves the lab.',
  },
  {
    n: '04',
    t: 'Handover Package',
    d: 'A complete, manufacture-ready specification: formulation, raw material specs, processing SOP, QC test methods, stability data, and scale-up notes — everything your production team needs.',
  },
];

const industries = [
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="14" width="4" height="7" rx="1"/><path d="M7 17h4M3 14V9l5-5 5 5v12"/><rect x="14" y="10" width="7" height="11" rx="1"/></svg>',
    name: 'Paints & Coatings',
    desc: 'Architectural, industrial protective, and specialty coating systems',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c3 4.5 5 7.4 5 10a5 5 0 0 1-10 0c0-2.6 2-5.5 5-10Z"/></svg>',
    name: 'Lubricants & Tribology',
    desc: 'Engine oils, greases, metalworking fluids, and hydraulic systems',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="13" r="7"/><path d="M12 6V3M9 3h6"/></svg>',
    name: 'Cleaners & Degreasers',
    desc: 'Household, institutional, and industrial cleaning formulations',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10Z"/></svg>',
    name: 'Personal Care',
    desc: 'Skin, hair, and body care from functional to premium market positioning',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2v-4M9 21H5a2 2 0 0 1-2-2v-4m0 0h18"/></svg>',
    name: 'Adhesives & Sealants',
    desc: 'Reactive and non-reactive bonding, sealing, and encapsulation systems',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21V9M12 9c0-3 2-5 6-5 0 4-2 6-6 5ZM12 13c0-3-2-5-6-5 0 4 2 6 6 5Z"/></svg>',
    name: 'Agrochemicals',
    desc: 'Pesticide, herbicide, and fertiliser formulations for field and foliar use',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="9" y="8" width="7" height="13" rx="2"/><path d="M11 8V5h4v3M6 5h2M6 8h1"/></svg>',
    name: 'Aerosols',
    desc: 'Propellant-based delivery systems for consumer and industrial applications',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="7" cy="8" r="3"/><circle cx="17" cy="8" r="3"/><circle cx="12" cy="16" r="3"/><path d="M9.5 9.5 10.5 14M14.5 9.5 13.5 14M9.5 8h5"/></svg>',
    name: 'Specialty Chemicals',
    desc: 'High-value process chemicals, intermediates, and functional additives',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 19h16M4 15h16M8 11V5a4 4 0 1 1 8 0v6"/><path d="M4 19v2h16v-2"/></svg>',
    name: 'Construction Chemicals',
    desc: 'Concrete admixtures, waterproofing membranes, and surface treatment systems',
  },
];

const deliverables = [
  'Complete formulation specification with ingredient grades and approved sources',
  'Raw material qualification criteria and recommended supplier list',
  'Manufacturing process SOP — mixing sequence, temperatures, hold times',
  'Quality control test methods with acceptance criteria for each parameter',
  'Stability data package — accelerated and real-time where applicable',
  'Regulatory screening notes and REACH / SDS readiness checklist',
  'Scale-up commentary and equipment recommendations for production',
];

const splitWords = (s: string) => s.split(' ');
---

<Layout
  title="Formulations & Technology | Global Aerosols"
  description="Ready-to-produce and bespoke chemical formulations across coatings, lubricants, cleaners, personal care, and specialty chemicals — grounded in manufacturing reality."
  canonical="/formulations-and-technology"
>

  <!-- ══════════ S1 HERO [DARK] ══════════ -->
  <section class="ft-hero">
    <div class="ft-hero-inner">
      <span class="ft-eyebrow-c reveal">Core Service</span>
      <h1 class="ft-hero-h1">
        {splitWords('Formulations built').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
        <br class="br-d" />
        {splitWords('for commercial reality').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
      </h1>
      <p class="ft-hero-sub reveal">
        We develop ready-to-produce and custom formulations across every major industrial
        chemistry sector — grounded in manufacturing economics, raw-material availability,
        and the practical constraints of your plant.
      </p>
      <div class="ft-hero-ctas reveal">
        <a href="/contact/" class="ft-btn-primary">Start a Project</a>
        <a href="#process" class="ft-btn-ghost">See how it works</a>
      </div>
    </div>
  </section>

  <!-- ══════════ S2 OVERVIEW [LIGHT] ══════════ -->
  <section class="ft-section ft-light ft-split">
    <div class="ft-split-inner">
      <div class="ft-split-text">
        <span class="ft-eyebrow-l reveal">What We Deliver</span>
        <h2 class="ft-h2-l">
          {splitWords('From blank brief to').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
          <br class="br-d" />
          {splitWords('production-ready specification').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
        </h2>
        <p class="ft-body-l reveal">
          Our formulation service covers both ends of the development spectrum. If
          your product category falls within our library of validated formulations, we
          can deliver a manufacture-ready specification with minimal lead time. If you
          need something bespoke — a new technology, a specific performance target, a
          cost-constrained brief — we build it from first principles against your exact
          requirements.
        </p>
        <p class="ft-body-l reveal">
          Every engagement starts with a technical feasibility review. We map your
          performance targets, cost envelope, regulatory obligations, and manufacturing
          constraints before a single experiment runs. That discipline is what keeps
          development timelines short and deliverables useful.
        </p>
        <ul class="ft-points">
          {[
            'Ready-to-produce formulations validated for immediate commercial launch',
            'Bespoke development against your performance, stability, and cost targets',
            'Reverse engineering and competitive benchmarking of market products',
            'Regulatory validation and REACH / SDS readiness before handover',
          ].map(p => (
            <li class="ft-point reveal">
              <span class="ft-point-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="5 12 10 17 19 7"/></svg>
              </span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="ft-split-media reveal">
        <!-- IMAGE 1 PLACEHOLDER -->
        <img 
          src="/images/services/formulations-technology-lab-bench.webp" 
          alt="Formulation chemist's workbench. Multiple glass beakers containing coloured formulations at different stages — white emulsion, amber lubricant base, pale blue cleaner. Clean bench surface, pipettes and notes visible. Warm neutral editorial lighting. No people, no text in frame." 
          width="900" 
          height="700" 
          class="ft-img"
          style="width: 100%; border-radius: var(--ft-radius, 16px); object-fit: cover; aspect-ratio: 900/700;"
        />
      </div>
    </div>
  </section>

  <!-- ══════════ S3 CAPABILITIES [DARK] ══════════ -->
  <section class="ft-section ft-dark ft-split ft-split-rev" id="ft-s3">
    <div class="ft-split-inner">
      <div class="ft-split-media reveal">
        <!-- IMAGE 2 PLACEHOLDER -->
        <img 
          src="/images/services/formulations-technology-mixer-vortex.webp" 
          alt="Close-up of a high-shear laboratory mixer blade creating a smooth               vortex in white emulsion inside a stainless-steel vessel. Slightly               dramatic contrast, cool steel highlights. No people, no labels,               no text in frame." 
          width="900" 
          height="700" 
          class="ft-img"
          style="width: 100%; border-radius: var(--ft-radius, 16px); object-fit: cover; aspect-ratio: 900/700;"
        />
      </div>

      <div class="ft-split-text">
        <span class="ft-eyebrow-d reveal">Technical Scope</span>
        <h2 class="ft-h2-d">
          {splitWords('Formulation scope built').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
          ))}
          <br class="br-d" />
          {splitWords('for commercial success').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
          ))}
        </h2>
        <p class="ft-body-d reveal">
          Our formulation R&D covers the full development lifecycle — from initial molecular engineering and compatibility screening to scale-up process planning and regulatory validation. We work across all major industrial chemistry categories to deliver stable, high-performance, and cost-optimized chemical products.
        </p>
        <ul class="ft-cap-grid reveal">
          {capabilities.map(c => (
            <li>
              <span class="ft-cap-dot"></span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════ S4 PROCESS [LIGHT] ══════════ -->
  <section class="ft-section ft-light ft-process" id="ft-process">
    <div class="ft-process-head">
      <span class="ft-eyebrow-l reveal">How We Work</span>
      <h2 class="ft-h2-l ft-centered">
        {splitWords('Our formulation development approach').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
        ))}
      </h2>
      <p class="ft-process-sub reveal">
        Four phases that take a product concept from initial target specification through iterative lab synthesis to a fully validated handover package.
      </p>
    </div>
    <div class="ft-steps">
      {steps.map(s => (
        <div class="ft-step reveal">
          <span class="ft-step-n">{s.n}</span>
          <span class="ft-step-rule"></span>
          <h3 class="ft-step-t">{s.t}</h3>
          <p class="ft-step-d">{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════ S5 SPECIALIZATION [DARK] ══════════ -->
  <section class="ft-section ft-dark ft-industries" id="ft-s5">
    <div class="ft-tech-head">
      <span class="ft-eyebrow-c reveal">Industries We Serve</span>
      <h2 class="ft-h2-d ft-centered">
        {splitWords('Where we apply').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
        <br class="br-d" />
        {splitWords('our expertise').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
      </h2>
      <p class="ft-tech-sub reveal">
        Across industrial, commercial, and specialty chemical sectors — grounded in manufacturing reality and economic feasibility.
      </p>
    </div>
    <div class="ft-tech-grid">
      {industries.map((t, idx) => (
        <div class="ft-tech-tile reveal" style={`--d:${idx * 0.055}s`}>
          <span class="ft-tech-ico" set:html={t.icon}></span>
          <h3 class="ft-tech-name">{t.name}</h3>
          <p class="ft-tech-desc">{t.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════ S6 DELIVERABLES [LIGHT] ══════════ -->
  <section class="ft-section ft-light ft-split" id="ft-s6">
    <div class="ft-split-inner ft-split-inner-rev">
      <div class="ft-split-text">
        <span class="ft-eyebrow-l reveal">Deliverables</span>
        <h2 class="ft-h2-l">
          {splitWords('A complete specification').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
          <br class="br-d" />
          {splitWords('for immediate launch').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
        </h2>
        <p class="ft-body-l reveal">
          We don't deliver academic formulations that fail in a production blender. Every specification handover package contains complete raw material source approvals, processing sequences, safety SDS assessments, and QC parameters ready for instant manufacturing execution.
        </p>
        <ul class="ft-points">
          {deliverables.map(d => (
            <li class="ft-point reveal">
              <span class="ft-point-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="5 12 10 17 19 7"/></svg>
              </span>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="ft-split-media reveal">
        <!-- IMAGE 3 PLACEHOLDER -->
        <img 
          src="/images/services/formulations-technology-specification-handover.webp" 
          alt="Neatly organised laboratory notebook open to formulation notes alongside               a printed specification document, a small test tube rack, and a jar of               white cream product. Muted warm tones, 45° angle shot. No faces, no               screens, no visible text in frame." 
          width="900" 
          height="700" 
          class="ft-img"
          style="width: 100%; border-radius: var(--ft-radius, 16px); object-fit: cover; aspect-ratio: 900/700;"
        />
      </div>
    </div>
  </section>

  <!-- ══════════ S7 CTA [DARK] ══════════ -->
  <section class="ft-section ft-dark ft-cta" id="ft-s7">
    <div class="ft-cta-card reveal">
      <span class="ft-eyebrow-c" style="margin-bottom: 20px; display: block;">Get Started</span>
      <h2 class="ft-cta-h2">
        {splitWords('Build your next').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
        <br class="br-d" />
        {splitWords('chemical product.').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
      </h2>
      <p class="ft-cta-sub reveal">
        Whether you're designing a process from scratch, troubleshooting a scale-up
        failure, or preparing a safety analysis for a regulatory submission — we can help.
      </p>
      <form class="ft-cta-form reveal" action="/contact" method="get">
        <input type="email" name="email" placeholder="Enter your email to get started…" aria-label="Email address" required />
        <button type="submit">Discuss Your Process</button>
      </form>
      <p class="ft-cta-alt reveal">
        Need a call first?&nbsp;
        <a href="/contact/">Book a consultation →</a>
      </p>
    </div>
  </section>

  <ServicePageAnimations />
</Layout>

<style>
  /* --- HERO SECTION --- */
  .ft-hero {
    background: linear-gradient(135deg, #0b0f19 0%, #111827 100%);
    padding: 140px 24px 100px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .ft-hero-inner {
    max-width: 880px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }
  .ft-eyebrow-c {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #3b82f6;
    margin-bottom: 24px;
    display: inline-block;
  }
  .ft-hero-h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 24px;
    font-family: 'Outfit', sans-serif;
  }
  .ft-hero-sub {
    font-size: 1.2rem;
    color: #9ca3af;
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  .ft-hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .ft-btn-primary {
    background: #2563eb;
    color: #ffffff;
    padding: 14px 32px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .ft-btn-primary:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
  }
  .ft-btn-ghost {
    background: transparent;
    color: #ffffff;
    padding: 14px 32px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.2s ease;
  }
  .ft-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* --- SECTION BASE --- */
  .ft-section {
    padding: 100px 24px;
    position: relative;
  }
  .ft-light {
    background: #ffffff;
    color: #1f2937;
  }
  .ft-dark {
    background: #0b0f19;
    color: #f3f4f6;
  }

  /* --- SPLIT LAYOUT --- */
  .ft-split-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .ft-split-inner-rev {
    grid-template-columns: 1fr 1.2fr;
  }
  @media (max-width: 1024px) {
    .ft-split-inner, .ft-split-inner-rev {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  .ft-split-text {
    display: flex;
    flex-direction: column;
  }
  .ft-split-media {
    position: relative;
    width: 100%;
  }
  .ft-eyebrow-l {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #2563eb;
    margin-bottom: 20px;
    display: inline-block;
  }
  .ft-eyebrow-d {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #60a5fa;
    margin-bottom: 20px;
    display: inline-block;
  }
  .ft-h2-l {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    color: #111827;
    margin-bottom: 24px;
    font-family: 'Outfit', sans-serif;
  }
  .ft-h2-d {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: 24px;
    font-family: 'Outfit', sans-serif;
  }
  .ft-body-l {
    font-size: 1.05rem;
    color: #4b5563;
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .ft-body-d {
    font-size: 1.05rem;
    color: #9ca3af;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  /* --- POINTS LIST --- */
  .ft-points {
    list-style: none;
    padding: 0;
    margin: 32px 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .ft-point {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .ft-point-ico {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ft-point-ico svg {
    width: 14px;
    height: 14px;
  }
  .ft-point span {
    font-size: 1rem;
    color: #374151;
    line-height: 1.5;
  }

  /* --- CAPABILITIES GRID --- */
  .ft-cap-grid {
    list-style: none;
    padding: 0;
    margin: 32px 0 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 32px;
  }
  @media (max-width: 640px) {
    .ft-cap-grid {
      grid-template-columns: 1fr;
    }
  }
  .ft-cap-grid li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .ft-cap-dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #60a5fa;
    margin-top: 8px;
  }
  .ft-cap-grid span {
    font-size: 0.95rem;
    color: #d1d5db;
    line-height: 1.5;
  }

  /* --- IMAGE PLATFORM --- */
  .ft-img {
    width: 100%;
    height: auto;
    display: block;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  /* --- PROCESS STEPS --- */
  .ft-process {
    background: #f9fafb;
    border-top: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
  }
  .ft-process-head {
    max-width: 800px;
    margin: 0 auto 64px auto;
    text-align: center;
  }
  .ft-process-sub {
    font-size: 1.15rem;
    color: #4b5563;
    line-height: 1.6;
    margin-top: 16px;
  }
  .ft-steps {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  @media (max-width: 1024px) {
    .ft-steps {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 640px) {
    .ft-steps {
      grid-template-columns: 1fr;
    }
  }
  .ft-step {
    position: relative;
  }
  .ft-step-n {
    font-size: 2.5rem;
    font-weight: 800;
    color: #e5e7eb;
    display: block;
    line-height: 1;
    margin-bottom: 16px;
    font-family: 'Outfit', sans-serif;
  }
  .ft-step-rule {
