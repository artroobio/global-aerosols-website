                <td style="padding: 15px; font-weight: 600; border: 1px solid var(--border);">Thermosetting Acrylic</td>
                <td style="padding: 15px; border: 1px solid var(--border);">High</td>
                <td style="padding: 15px; border: 1px solid var(--border);">High</td>
                <td style="padding: 15px; border: 1px solid var(--border);">Fast (Heat Cure)</td>
                <td style="padding: 15px; border: 1px solid var(--border);">Automotive OEM</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--border);">
                <td style="padding: 15px; font-weight: 600; border: 1px solid var(--border);">2K Polyurethane</td>
                <td style="padding: 15px; border: 1px solid var(--border);">Exceptional</td>
                <td style="padding: 15px; border: 1px solid var(--border);">Very High</td>
                <td style="padding: 15px; border: 1px solid var(--border);">Medium</td>
