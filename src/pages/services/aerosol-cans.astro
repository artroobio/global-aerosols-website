  }

  .resource-link::after {
    content: "→";
    margin-left: 8px;
    font-size: 1rem;
    transition: transform 0.25s ease;
  }

  .resource-link:hover::after {
    transform: translateX(4px);
  }

  /* ════════════ 6. FAQ ACCORDION ════════════ */
  .faq-section-wrapper {
    background: var(--light-bg);
    padding: 90px 30px;
  }

  .faq-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .faq-head {
    text-align: center;
    margin-bottom: 48px;
  }

  .faq-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 700;
    color: var(--brand-blue);
    display: block;
    margin-bottom: 8px;
  }

  .faq-head .heading-font {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
