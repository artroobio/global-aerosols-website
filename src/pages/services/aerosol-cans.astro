const faqs = [
  {
    q: 'What are the primary safety standards for aerosol cans?',
    a: 'Aerosol cans must adhere to DOT 2Q/2P regulations in the US and FEA standards in Europe. This involves rigorous burst pressure testing, water bath leak detection, and micro-leak analysis to ensure the vessel can withstand internal pressures of up to 18 BAR.'
  },
  {
    q: 'What is the difference between 2-phase and 3-phase aerosol systems?',
    a: 'A 2-phase system consists of the product mixed with a liquefied propellant (solution or emulsion). A 3-phase system keeps the product separate from the propellant (usually compressed gas) often using a bag-on-valve or piston barrier system.'
  },
  {
    q: 'Can you print custom designs directly on the cans?',
    a: 'Yes, we offer high-definition offset lithography up to 8 colors for both aluminum and tinplate cans. We also provide base coating, matte finishes, and tactile "soft-touch" varnishes for premium shelf appeal.'
  },
  {
    q: 'Are aluminum and tinplate aerosol cans recyclable?',
    a: 'Absolutely. Metal aerosols are infinitely recyclable without loss of quality. Both our aluminum monobloc and steel tinplate cans fit into standard global recycling streams, making them a sustainable packaging choice.'
  },
  {
    q: 'What are the typical lead times for bulk manufacturing?',
    a: 'Lead times vary by customization level. Standard plain cans are often available for immediate dispatch from inventory. Custom lithographed orders typically require 4-6 weeks for proofing, production, and curing cycles.'
  }
];

const splitWords = (s: string) => s.split(' ');

const SITE = 'https://www.globalaerosols.com';
const PAGE_URL = `${SITE}/services/aerosol-cans/`;

// ── Commercial schema built from the catalog above (kept in sync with the grid) ──
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Aerosol Can Production Catalog',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: cans.length,
  itemListElement: cans.map((can, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: `${can.name} Aerosol Can`,
      image: can.img,
      description: can.alt,
      category: 'Aerosol Cans',
      brand: { '@type': 'Brand', name: 'Global Aerosols' },
      additionalProperty: can.specs.map(s => ({
        '@type': 'PropertyValue', name: s.key, value: s.val
      })),
      // Offer asserts commercial intent (supplier/wholesale). Price intentionally omitted — quote-based.
      offers: {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        businessFunction: 'http://purl.org/goodrelations/v1#Sell',
        areaServed: 'Worldwide',
        seller: { '@id': `${SITE}/#organization` },
        url: PAGE_URL
      }
    }
  }))
};

const serviceSchema = ['Contract Aerosol Filling', 'Custom Lithography & Printing', 'Wholesale & Bulk Supply'].map(name => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: name,
  provider: { '@id': `${SITE}/#organization` },
  areaServed: 'Worldwide',
  url: PAGE_URL
}));

const commercialSchema = [itemListSchema, ...serviceSchema];
---

<Layout
  title="Aerosol Cans — Wholesale Supplier & Manufacturer | Aluminum & Tinplate | Global Aerosols"
  description="Wholesale supplier & manufacturer of aluminum monobloc and tinplate aerosol cans, certified to DOT 2Q/2P & FEA. Bulk supply, contract filling & custom lithography — request a quote."
>
  <script type="application/ld+json" is:inline>
    [
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [{
          "@type": "Question",
          "name": "What are the primary safety standards for aerosol cans?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aerosol cans must adhere to DOT 2Q/2P regulations in the US and FEA standards in Europe. This involves rigorous burst pressure testing, water bath leak detection, and micro-leak analysis."
          }
        }, {
          "@type": "Question",
          "name": "What is the difference between 2-phase and 3-phase aerosol systems?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 2-phase system consists of the product mixed with a liquefied propellant. A 3-phase system keeps the product separate from the propellant (usually compressed gas) using a bag-on-valve or piston barrier."
          }
        }, {
          "@type": "Question",
          "name": "Can you print custom designs directly on the cans?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we offer high-definition offset lithography up to 8 colors for both aluminum and tinplate cans. We also provide base coating, matte finishes, and tactile 'soft-touch' varnishes for premium shelf appeal."
          }
        }, {
          "@type": "Question",
          "name": "Are aluminum and tinplate aerosol cans recyclable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. Metal aerosols are infinitely recyclable without loss of quality. Both our aluminum monobloc and steel tinplate cans fit into standard global recycling streams, making them a sustainable packaging choice."
          }
        }, {
          "@type": "Question",
          "name": "What are the typical lead times for bulk manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lead times vary by customization level. Standard plain cans are often available for immediate dispatch from inventory. Custom lithographed orders typically require 4-6 weeks for proofing, production, and curing cycles."
          }
        }]
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.globalaerosols.com/"
        },{
          "@type": "ListItem",
          "position": 2,
          "name": "Products",
          "item": "https://www.globalaerosols.com/products/"
        },{
          "@type": "ListItem",
          "position": 3,
          "name": "Aerosol Cans"
        }]
      }
    ]
  </script>

  <!-- ── Commercial Product / ItemList / Service schema (marketplace signal) ── -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(commercialSchema)} />

  <div class="industrial-light-wrapper" id="industrial-light-final-v7">
    
    <!-- ════════════ BREADCRUMBS ════════════ -->
    <div class="ind-breadcrumbs">
      <a href="/" target="_top">Home</a> <span>/</span> <a href="/products/" target="_top">Products</a> <span>/</span> <span class="curr-page">Aerosol Cans</span>
    </div>

    <!-- ════════════ HERO ════════════ -->
    <section class="ind-hero">
      <div class="ind-hero-inner">
        <span class="ind-hero-badge">OEM & Contract Manufacturing</span>
        <h1 class="ind-title">
          {splitWords('Industrial Aerosol Can Manufacturing').map(word => (
            <span class="aw">{word.split('').map(c => <span class="ac">{c}</span>)}</span>
          ))}
        </h1>
        <p class="ind-subtitle reveal">Aluminum & Tinplate Pressure Vessels</p>
        <p class="ind-hero-desc reveal">
          Precision-engineered pressure vessels certified to global standards. We provide seamless aluminum monobloc and high-rigidity tinplate steel containers manufactured for maximum performance, chemical compatibility, and burst safety.
        </p>
      </div>
    </section>

    <!-- ════════════ SHOWCASE GRID ════════════ -->
    <section class="ind-container">
      <div class="grid-header reveal">
        <span class="grid-eyebrow">Container Specifications</span>
        <h2 class="grid-title">Our Production Catalog</h2>
        <div class="grid-line-bar"></div>
      </div>

      <div class="ind-grid">
        {cans.map((can, idx) => (
          <div class="ind-card reveal" data-index={idx}>
            <div class="card-index">{can.index}</div>
            <div class="img-zone">
              <img src={can.img} alt={can.alt} loading="lazy" width="350" height="350" />
            </div>
            <div class="info-zone">
              <span class="cat-tag">{can.tag}</span>
              <h3 class="prod-name">{can.name}</h3>
              <div class="spec-grid">
                {can.specs.map(spec => (
                  <span class="spec-key">{spec.key}</span>
                  <span class="spec-val">{spec.val}</span>
                ))}
              </div>
              <a href="/contact/" class="action-btn">Request Quote</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════════ SUPPLY SPECS / MOQ / LEAD TIMES / CTA ════════════ -->
    <ProductSupplyBlock
      eyebrow="Wholesale Supply"
      heading="Sizes, MOQ & Lead Times"
      columns={["Can Type", "Diameters", "Material", "Typical MOQ", "Lead Time"]}
      rows={[
        ["Aluminum Monobloc", "35 / 45 / 53 / 66 mm", "Alloy 99.7%", "10,000 units", "4–6 weeks (custom)"],
        ["Tinplate (3-Piece)", "45 / 52 / 65 mm", "ETP Steel", "20,000 units", "4–6 weeks (custom)"],
        ["Plain / Stock Cans", "Standard range", "Aluminum / Tinplate", "Pallet quantities", "Immediate dispatch"],
      ]}
      badges={["DOT 2Q / 2P", "FEA Standards", "GMP (Pharma)", "Recyclable Metal"]}
      ctaText="Request a quote for wholesale aerosol cans — custom sizes, lithography and contract filling included."
      industries={[
        { label: "Cosmetics & Personal Care", href: "/cosmetics-and-personal-care-aerosols-guide/" },
        { label: "Automotive", href: "/automotive-aerosol-products/" },
        { label: "Paints & Coatings", href: "/paints-and-coatings-guide/" },
        { label: "Pharmaceutical", href: "/pharmaceutical-and-healthcare-guide/" },
        { label: "Household & Cleaning", href: "/household-cleaners-formulations-technology/" },
      ]}
      related={[
        { label: "Valves & Actuators", href: "/services/aerosol-valves-caps-and-actuators/" },
        { label: "Aerosol Caps", href: "/services/aerosol-caps/" },
        { label: "Filling Equipment", href: "/services/aerosol-machines-and-equipment/" },
      ]}
    />

    <!-- ════════════ TECHNICAL KNOWLEDGE HUB ════════════ -->
    <section class="resource-section">
      <div class="resource-head reveal">
        <span class="resource-eyebrow">Aerosol Reference Hub</span>
        <h2 class="heading-font">Technical <span class="highlight">Knowledge Hub</span></h2>
        <p class="resource-subtitle-text">Deepen your understanding of aerosol engineering and manufacturing processes.</p>
      </div>
      
      <div class="resource-grid">
        <div class="resource-card reveal">
          <h3 class="resource-title">Aerosol Can Safety Standards</h3>
          <p class="resource-p">Understanding rigorous testing protocols: DOT 2Q/2P compliance, hot water bath validation, and burst pressure limits for hazmat transport.</p>
          <a href="/aerosol-can-safety-explained/" class="resource-link">Read Safety Guide</a>
        </div>
        <div class="resource-card reveal">
          <h3 class="resource-title">Types of Aerosol Systems</h3>
          <p class="resource-p">A detailed breakdown of 2-phase vs. 3-phase systems, bag-on-valve (BoV), and piston barrier designs engineered for various formulation viscosities.</p>
          <a href="/types-of-aerosol-systems-explained/" class="resource-link">Explore Systems</a>
        </div>
        <div class="resource-card reveal">
          <h3 class="resource-title">Aerosol Manufacturing 101</h3>
          <p class="resource-p">Explore the complete engineering lifecycle: from raw aluminum slug extrusion to necking, flanging, valve crimping, and quality control.</p>
          <a href="/aerosol-manufacturing-101-guide/" class="resource-link">View Process Flow</a>
        </div>
        <div class="resource-card reveal">
          <h3 class="resource-title">Machinery & Equipment</h3>
          <p class="resource-p">Discover the mechanical systems that power high-volume lines, including automated filling, gassing houses, and crimping stations.</p>
          <a href="/services/aerosol-machines-and-equipment/" class="resource-link">Browse Equipment</a>
        </div>
      </div>
    </section>

    <!-- ════════════ FAQ SECTION ════════════ -->
    <section class="faq-section-wrapper">
      <div class="faq-container">
        <div class="faq-head reveal">
          <span class="faq-eyebrow">Common Enquiries</span>
          <h2 class="heading-font">Frequently Asked Questions</h2>
        </div>
        
        <div class="faq-accordion-group">
          {faqs.map((faq, i) => (
            <div class="faq-item reveal">
              <button class="faq-question-btn" aria-expanded="false" aria-controls={`faq-answer-${i}`}>
                <span class="faq-q-prefix">Q.</span>
                <span class="faq-q-text">{faq.q}</span>
                <span class="faq-icon"></span>
              </button>
              <div id={`faq-answer-${i}`} class="faq-answer-panel" hidden>
                <div class="faq-a-content">
                  {faq.a}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════ ENGINEERING DOSSIER ════════════ -->
    <section class="tech-dossier">
      <div class="dossier-container">
        <div class="dossier-head reveal">
          <span class="dossier-eyebrow">Engineering Specifications</span>
          <h2 class="dossier-title">Global Aerosols Engineering Dossier</h2>
          <div class="dossier-line"></div>
        </div>
        
        <div class="dossier-col-layout">
          <div class="dossier-text reveal">
            <h3>1. The Physics of Pressurized Packaging</h3>
            <p>The aerosol can is a marvel of modern engineering, functioning as a portable pressure vessel that must maintain structural integrity under varying thermal and physical stress conditions. At Global Aerosols, we engineer our containers to withstand internal pressures significantly higher than standard atmospheric conditions.</p>
            <p>In a typical 2-phase system, the propellant exists in both liquid and gaseous states. As the product is dispensed, the liquid propellant boils off to replenish the vapor phase, maintaining a constant internal pressure (approximately 3 to 5 bar at 20°C).</p>

            <h3>2. Metallurgy: Monobloc Aluminum vs. Tinplate Steel</h3>
            <p>Material selection is dictated by chemical compatibility. Our <strong>Aluminum Monobloc</strong> cans are manufactured via impact extrusion from 99.7% pure aluminum slugs. This seamless construction eliminates side-seam risks and provides a premium vessel for personal care.</p>
            <p>Conversely, our <strong>3-Piece Tinplate Cans</strong> are constructed from a flat steel sheet that is rolled and welded. Tinplate offers superior rigidity and magnetic properties, making it the preferred choice for industrial lubricants and paints.</p>

            <h3>3. Propellant Thermodynamics & Selection</h3>
            <p>The choice of propellant defines the spray characteristics. Liquefied Gas Propellants (Propane, Butane, DME) act as solvents and propellants. For non-flammable applications, we engineer systems using Compressed Gases (Nitrogen, CO2) which require precise initial pressure calculations.</p>
          </div>

          <div class="dossier-text reveal">
            <h3>4. Manufacturing: The Cold Extrusion Process</h3>
            <p>Our aluminum cans begin as a metal slug. Through <strong>Impact Extrusion</strong>, a heavy mechanical press causes the aluminum to flow backwards around a punch, forming the cylinder in milliseconds. The cans are then trimmed, washed, and passed through necking stations.</p>
            <p>Necking reduces the top diameter to accommodate the valve cup. This process induces work hardening, increasing the shoulder's structural strength. Finally, flanging creates the curl for crimping, measured in microns.</p>

            <h3>5. Quality Assurance & Regulatory Compliance</h3>
            <p>Adhering to DOT 2Q/2P standards requires validation. The most critical test is the <strong>Hot Water Bath</strong>. Every filled can is submerged at 50°C to raise internal pressure near burst limits, allowing immediate detection of leaks.</p>
            <p>We also conduct statistical burst pressure analysis. A standard monobloc can must withstand deformation pressures of 12 bar and burst pressures exceeding 18 bar, ensuring safety even in high heat conditions.</p>

            <h3>6. Advanced Valve & Actuator Tribology</h3>
            <p>The valve is the engine of the aerosol. We utilize metered-dose valves for pharmaceuticals and high-output valves for industrial paints to prevent clogging. The actuator determines spray morphology—whether it is a jet, cone, or fan.</p>
          </div>
        </div>
      </div>
    </section>

  </div>

  <ContactFormVideo />
</Layout>

<style>
  /* ════════════ 1. CORE THEME & BACKGROUND ════════════ */
  :root {
    --light-bg: #f8fafc;       
    --light-card: #ffffff;     
    --light-text-main: #0f172a; 
    --light-text-sub: #475569;  
    --light-border: #e2e8f0;   
    --brand-blue: #0968e5;  
    --brand-blue-hover: #2563eb;
    --grid-line: #cbd5e1;      
  }

  .industrial-light-wrapper * { 
    box-sizing: border-box; 
  }

  .industrial-light-wrapper {
    font-family: 'Inter', 'Roboto', sans-serif;
    background-color: var(--light-bg);
    color: var(--light-text-main);
    padding-bottom: 0px; 
    /* Premium Technical Grid Background */
    background-image: 
      linear-gradient(rgba(203, 213, 225, 0.25) 1px, transparent 1px),
      linear-gradient(90deg, rgba(203, 213, 225, 0.25) 1px, transparent 1px);
    background-size: 50px 50px;
    position: relative;
  }

  /* Font Styling */
  .heading-font, h1, h2, h3, .prod-name, .resource-title, .dossier-title {
    font-family: 'Outfit', 'Montserrat', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  /* GSAP initial reveal states */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
  }

  /* Animated heading char spans */
  .aw { 
    display: inline-block; 
    white-space: nowrap; 
    margin-right: 0.24em; 
  }
  .ac { 
    display: inline-block; 
    opacity: 0; 
    color: var(--brand-blue); 
    -webkit-text-fill-color: var(--brand-blue); 
  }

  /* ════════════ 2. BREADCRUMBS ════════════ */
  .ind-breadcrumbs {
    max-width: 1400px;
    margin: 0 auto;
    padding: 100px 30px 0; /* Padding top accounts for navbar height */
    font-size: 0.72rem;
    color: var(--light-text-sub);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 2px;
  }
  .ind-breadcrumbs a {
    text-decoration: none;
    color: var(--light-text-sub);
    transition: color 0.25s ease;
  }
  .ind-breadcrumbs a:hover {
    color: var(--brand-blue);
  }
  .ind-breadcrumbs span {
    color: #94a3b8;
    margin: 0 8px;
  }
  .ind-breadcrumbs .curr-page {
    color: var(--light-text-main);
  }

  /* ════════════ 3. HERO SECTION ════════════ */
  .ind-hero {
    background: #ffffff;
    border-bottom: 6px solid var(--brand-blue);
    padding: 80px 30px 100px;
    text-align: center;
    position: relative;
    box-shadow: 0 4px 30px rgba(15, 23, 42, 0.03);
    margin-bottom: 60px;
    overflow: hidden;
  }

  .ind-hero::after {
    content: '';
    position: absolute;
    bottom: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(ellipse at center, rgba(9, 104, 229, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .ind-hero-inner {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .ind-hero-badge {
    display: inline-block;
