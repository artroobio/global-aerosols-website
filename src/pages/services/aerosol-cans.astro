  }

  .faq-accordion-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid var(--light-border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .faq-item:hover {
    border-color: rgba(9, 104, 229, 0.4);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
  }

  .faq-question-btn {
    width: 100%;
    background: none;
    border: none;
    padding: 24px;
    display: flex;
    align-items: center;
    text-align: left;
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--light-text-main);
    transition: color 0.25s;
  }

  .faq-question-btn:hover {
    color: var(--brand-blue);
  }

  .faq-q-prefix {
    color: var(--brand-blue);
    margin-right: 12px;
    font-weight: 800;
  }

  .faq-q-text {
    flex-grow: 1;
    line-height: 1.4;
  }

  .faq-icon {
    width: 20px;
    height: 20px;
    position: relative;
    flex-shrink: 0;
    margin-left: 16px;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    background-color: var(--light-text-sub);
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  /* Horizontal line */
  .faq-icon::before {
    top: 9px;
    left: 2px;
    width: 16px;
    height: 2px;
  }

  /* Vertical line */
  .faq-icon::after {
    top: 2px;
    left: 9px;
    width: 2px;
    height: 16px;
  }

  .faq-question-btn[aria-expanded="true"] .faq-icon::before {
    background-color: var(--brand-blue);
  }

  .faq-question-btn[aria-expanded="true"] .faq-icon::after {
    transform: rotate(90deg);
    opacity: 0;
    background-color: var(--brand-blue);
  }

  .faq-answer-panel {
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
  }

  .faq-answer-panel:not([hidden]) {
    opacity: 1;
  }

  .faq-a-content {
    padding: 0 24px 24px 44px;
    font-size: 0.95rem;
    color: var(--light-text-sub);
    line-height: 1.7;
    border-top: 1px solid #f8fafc;
  }

  /* ════════════ 7. ENGINEERING DOSSIER ════════════ */
  .tech-dossier {
    background: #0f172a;
    color: #cbd5e1;
    padding: 90px 30px;
    border-top: 5px solid var(--brand-blue);
  }

  .dossier-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .dossier-head {
    margin-bottom: 50px;
  }

  .dossier-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 700;
    color: var(--brand-blue);
    display: block;
    margin-bottom: 8px;
  }

  .dossier-title {
    color: white;
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    margin: 0 0 16px 0;
  }

  .dossier-line {
