<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script is:inline>
(function () {
  var container = document.getElementById('canvas-container');
  if (!container || typeof THREE === 'undefined') return;
  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(35, container.offsetWidth / container.offsetHeight, 0.1, 1000);
  camera.position.z = 13; camera.position.y = 1;
  var renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
  renderer.setSize(container.offsetWidth, container.offsetHeight);
  renderer.setPixelRatio(window.devicePixelRatio);
  container.appendChild(renderer.domElement);
  var canGroup = new THREE.Group(); scene.add(canGroup);
  canGroup.add(new THREE.Mesh(new THREE.CylinderGeometry(1.6,1.6,5,64), new THREE.MeshPhysicalMaterial({ color:0xffffff, metalness:0.3, roughness:0.1, transparent:true, opacity:0.95, clearcoat:1 })));
  var outerMat = new THREE.MeshBasicMaterial({ color:0x0968e5, wireframe:true, transparent:true, opacity:0.15 });
  var outerCan = new THREE.Mesh(new THREE.CylinderGeometry(1.63,1.63,5.05,32,10), outerMat);
  canGroup.add(outerCan);
  var capMat = new THREE.MeshStandardMaterial({ color:0xe2e8f0, metalness:0.8, roughness:0.2 });
  var topCap = new THREE.Mesh(new THREE.CylinderGeometry(1.6,1.6,0.2,64), capMat); topCap.position.y=2.6; canGroup.add(topCap);
  var botCap = new THREE.Mesh(new THREE.CylinderGeometry(1.6,1.6,0.2,64), capMat); botCap.position.y=-2.6; canGroup.add(botCap);
  var ref = canGroup.clone(); ref.scale.y=-1; ref.position.y=-5.4;
  ref.traverse(function(c){ if(c.isMesh){ c.material=c.material.clone(); c.material.transparent=true; c.material.opacity=0.1; } });
  scene.add(ref);
  var pg = new THREE.BufferGeometry(); var pa = new Float32Array(300);
  for(var i=0;i<300;i++) pa[i]=(Math.random()-0.5)*10;
  pg.setAttribute('position', new THREE.BufferAttribute(pa,3));
  var pm = new THREE.Points(pg, new THREE.PointsMaterial({ size:0.03, color:0x0968e5, transparent:true, opacity:0.4 }));
  scene.add(pm);
  scene.add(new THREE.AmbientLight(0xffffff,0.9));
  var dl = new THREE.DirectionalLight(0xffffff,1.5); dl.position.set(5,5,5); scene.add(dl);
  var bl = new THREE.PointLight(0x0968e5,2,20); bl.position.set(-5,0,5); scene.add(bl);
  var mx=0, my=0; canGroup.rotation.x=0.2; canGroup.rotation.z=0.1;
  (function loop(){ requestAnimationFrame(loop);
    canGroup.rotation.y+=0.005; outerCan.rotation.y-=0.007;
    ref.rotation.y=-canGroup.rotation.y; ref.rotation.x=-canGroup.rotation.x;
    pm.rotation.y+=0.001; pm.position.y+=0.002; if(pm.position.y>1) pm.position.y=-1;
    canGroup.rotation.x+=0.05*(my*0.3+0.2-canGroup.rotation.x);
    canGroup.rotation.y+=0.05*(mx*0.3-canGroup.rotation.y);
    renderer.render(scene,camera);
  })();
  window.addEventListener('resize', function(){ camera.aspect=container.offsetWidth/container.offsetHeight; camera.updateProjectionMatrix(); renderer.setSize(container.offsetWidth,container.offsetHeight); });
  document.addEventListener('mousemove', function(e){ mx=(e.clientX/window.innerWidth)*2-1; my=-((e.clientY/window.innerHeight)*2-1); });
})();
</script>

<!-- ═══════════════════════ BABYLON.JS CDN ════════════════════════ -->
<script is:inline src="https://cdn.babylonjs.com/babylon.js"></script>
<script is:inline src="https://cdn.babylonjs.com/loaders/babylonjs.loaders.min.js"></script>

<!-- ═══════════════════════ STUDIO ENGINE ════════════════════════ -->
<script is:inline>
document.addEventListener('DOMContentLoaded', function () {
  if (typeof BABYLON === 'undefined') return;

  var CAN_DB = [
    { diam: 4.3, height: 10.5 },
    { diam: 4.3, height: 13.5 },
    { diam: 4.3, height: 14.2 },
    { diam: 3.4, height: 7.0  },
    { diam: 3.4, height: 12.0 },
    { diam: 3.4, height: 13.5 }
  ];

  var canvas      = document.getElementById('renderCanvas');
  var wrapper     = document.getElementById('cw-engine-wrapper');
  var scene, rootNode, labelMaterial, metalMat, capMat, currentTexture, seamPivot;

  var engine = new BABYLON.Engine(canvas, true, { preserveDrawingBuffer: true, stencil: true });
  scene = new BABYLON.Scene(engine);
  scene.clearColor = new BABYLON.Color4(0,0,0,0);

  var isMobile = window.innerWidth < 900;
  var camera = new BABYLON.ArcRotateCamera('cam', Math.PI/2, Math.PI/2.2, isMobile ? 32 : 24, new BABYLON.Vector3(0,8,0), scene);
  camera.attachControl(canvas, true);
  camera.wheelPrecision = 50;
  camera.minZ = 0.1;
  camera.lowerRadiusLimit = 10;
  camera.upperRadiusLimit = 50;

  // Block page scroll only when the pointer is directly over the 3D canvas
  canvas.addEventListener('wheel', function(e) { e.preventDefault(); }, { passive: false });

  var hLight = new BABYLON.HemisphericLight('hLight', new BABYLON.Vector3(0,1,0), scene);
  hLight.intensity = 0.6;
  hLight.specular  = BABYLON.Color3.Black();

  scene.createDefaultEnvironment({
    createSkybox: false,
    createGround: false,
    environmentTexture: 'https://assets.babylonjs.com/environments/studio.env'
  });
  scene.environmentIntensity = 1.2;

  metalMat = new BABYLON.PBRMaterial('metal', scene);
  metalMat.metallic  = 1.0;
  metalMat.roughness = 0.2;
  metalMat.albedoColor = new BABYLON.Color3(0.95, 0.95, 0.95);

  labelMaterial = new BABYLON.PBRMaterial('label', scene);
  labelMaterial.metallic  = 0.1;
  labelMaterial.roughness = 0.3;
  labelMaterial.albedoColor  = new BABYLON.Color3(0.9, 0.9, 0.9);
  labelMaterial.emissiveColor = new BABYLON.Color3(0,0,0);

  capMat = new BABYLON.PBRMaterial('cap', scene);
  capMat.albedoColor = BABYLON.Color3.FromHexString('#0D40BF');
  capMat.metallic  = 0;
  capMat.roughness = 0.4;

  function buildCan(idx) {
    if (rootNode) rootNode.dispose();
    var d = CAN_DB[idx]; var D = d.diam; var H = d.height;
    rootNode = new BABYLON.TransformNode('root', scene);

    var body = BABYLON.MeshBuilder.CreateCylinder('body', { height: H, diameter: D, tessellation: 64 }, scene);
    body.material = labelMaterial; body.position.y = H/2 + 0.2; body.parent = rootNode;

    seamPivot = new BABYLON.TransformNode('sp', scene);
    seamPivot.position.y = H/2 + 0.2; seamPivot.parent = rootNode;
    var seam = BABYLON.MeshBuilder.CreateBox('s', { height: H-0.2, width: 0.1, depth: 0.05 }, scene);
    seam.material = metalMat; seam.position.z = -D/2; seam.parent = seamPivot;
    seamPivot.rotation.y = Math.PI;

    var shoulder = BABYLON.MeshBuilder.CreateSphere('sh', { diameter: D, segments: 64 }, scene);
    shoulder.scaling.y = 0.4; shoulder.position.y = H + 0.2; shoulder.material = metalMat; shoulder.parent = rootNode;

    var cap = BABYLON.MeshBuilder.CreateCylinder('cap', { height: 3.5, diameter: D+0.1, tessellation: 64 }, scene);
    cap.position.y = H + 1.8; cap.material = capMat; cap.parent = rootNode;

    var rim = BABYLON.MeshBuilder.CreateTorus('rim', { diameter: D-0.1, thickness: 0.25, tessellation: 64 }, scene);
    rim.position.y = 0.125; rim.material = metalMat; rim.parent = rootNode;
  }

  buildCan(0);
  engine.runRenderLoop(function () { scene.render(); });
  window.addEventListener('resize', function () { engine.resize(); });

  /* ── File upload ── */
  var fileInput = document.getElementById('fileInput');
  document.getElementById('uploadBtn').addEventListener('click', function () { fileInput.click(); });
  fileInput.addEventListener('change', function (evt) {
    var file = evt.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function (e) {
      if (currentTexture) currentTexture.dispose();
      currentTexture = new BABYLON.Texture(e.target.result, scene, false, true);
      currentTexture.vScale = 1; currentTexture.uScale = 1;
      currentTexture.uOffset = 0; currentTexture.vOffset = 0;
      document.getElementById('rotSlider').value = 0;
      labelMaterial.albedoTexture  = currentTexture;
      labelMaterial.emissiveTexture = currentTexture;
      labelMaterial.albedoColor = new BABYLON.Color3(1,1,1);
      updateVibrancy(30);
    };
    reader.readAsDataURL(file);
  });

  /* ── Background toggle ── */
  document.getElementById('bg-light').addEventListener('click', function () {
    wrapper.style.background = 'radial-gradient(circle at 60% 50%, #ffffff 0%, #e2e8f0 100%)';
    document.getElementById('bg-light').classList.add('cw-toggle-active');
    document.getElementById('bg-dark').classList.remove('cw-toggle-active');
  });
  document.getElementById('bg-dark').addEventListener('click', function () {
    wrapper.style.background = 'radial-gradient(circle at 60% 50%, #1e293b 0%, #0f172a 100%)';
    document.getElementById('bg-dark').classList.add('cw-toggle-active');
    document.getElementById('bg-light').classList.remove('cw-toggle-active');
  });

  /* ── Can size ── */
  document.getElementById('sizeSelector').addEventListener('change', function () {
    buildCan(parseInt(this.value));
  });

  /* ── Vibrancy ── */
  function updateVibrancy(val) {
    document.getElementById('vibVal').innerText = val + '%';
    if (labelMaterial) { var i = val/100; labelMaterial.emissiveColor = new BABYLON.Color3(i,i,i); }
  }
  document.getElementById('vibrancySlider').addEventListener('input', function () { updateVibrancy(this.value); });

  /* ── Gloss ── */
  document.getElementById('glossSlider').addEventListener('input', function () {
    document.getElementById('glossVal').innerText = this.value + '%';
    if (labelMaterial) labelMaterial.roughness = 1.0 - (this.value/100);
  });

  /* ── Rotation ── */
  document.getElementById('rotSlider').addEventListener('input', function () {
    if (currentTexture) currentTexture.uOffset = this.value/360;
  });

  /* ── Seam ── */
  document.getElementById('seamSlider').addEventListener('input', function () {
    if (seamPivot) seamPivot.rotation.y = (this.value * Math.PI) / 180;
  });

  /* ── Flip ── */
  document.getElementById('flipVertBtn').addEventListener('click',  function () { if (currentTexture) currentTexture.vScale *= -1; });
  document.getElementById('flipHorizBtn').addEventListener('click', function () { if (currentTexture) currentTexture.uScale *= -1; });

  /* ── Cap colour ── */
  function applyCapColor(hex) {
    if (!/^#([0-9A-Fa-f]{3}){1,2}$/.test(hex)) return;
    document.getElementById('capColorPicker').value = hex;
    document.getElementById('capHexInput').value    = hex.toUpperCase();
    if (capMat) capMat.albedoColor = BABYLON.Color3.FromHexString(hex);
  }
  document.getElementById('capColorSelect').addEventListener('change', function () {
    if (this.value !== 'custom') applyCapColor(this.value);
  });
  document.getElementById('capColorPicker').addEventListener('input', function () { applyCapColor(this.value); });
  document.getElementById('capHexInput').addEventListener('change', function () { applyCapColor(this.value); });
});
</script>

<!-- ═══════════════════════ GSAP ANIMATIONS ═══════════════════════ -->
<script>
  import { gsap } from "gsap";

  const card = document.getElementById('spotlight-card') as HTMLElement;
  card?.addEventListener('mousemove', (e: MouseEvent) => {
    const rect = card.getBoundingClientRect();
    card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
    card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
  });

  function scrambleText(el: HTMLElement, final: string, dur: number) {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&';
    const frames = dur * 30; let f = 0;
    const id = setInterval(() => {
      f++; const p = f / frames; const rev = Math.floor(p * final.length);
      let out = '';
      for (let i = 0; i < final.length; i++) {
        if (i < rev) out += final[i];
        else if (final[i] === ' ') out += ' ';
        else out += chars[Math.floor(Math.random() * chars.length)];
      }
      el.innerText = out;
      if (f >= frames) { clearInterval(id); el.innerText = final; }
    }, 30);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.from('.cw-badge', { y: 20, opacity: 0, duration: 0.8, delay: 0.2 });
    tl.call(() => {
      const t = document.getElementById('scramble-target') as HTMLElement;
      if (t) scrambleText(t, 'CanWrap 3D Design Studio', 1.8);
    }, undefined, '-=0.4');
    tl.to('.cw-subhead', { opacity: 1, y: 0, duration: 1 }, '-=0.2');
    tl.to('.cw-desc',    { y: 0, duration: 1 },             '-=0.8');
    tl.to('.step-item',  { opacity: 1, duration: 0.6, stagger: 0.15 }, '-=0.5');

    setInterval(() => {
      const el = document.getElementById('coord-x');
      if (el) el.innerText = String(Math.floor(Math.random() * 999)).padStart(3, '0');
    }, 150);
  });
</script>
