  /* ════════════ 5. KNOWLEDGE HUB SECTION ════════════ */
  .resource-section {
    background: #ffffff;
    padding: 80px 30px;
    border-top: 1px solid var(--light-border);
    border-bottom: 1px solid var(--light-border);
  }

  .resource-head {
    max-width: 800px;
    margin: 0 auto 50px;
    text-align: center;
  }

  .resource-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
