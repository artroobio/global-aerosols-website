    margin: 0;
  }

  .resource-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .resource-card {
    background: #f8fafc;
    border-left: 5px solid var(--industrial-green);
    border-radius: 0 12px 12px 0;
    padding: 36px;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.01);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .resource-card:hover {
    transform: translateX(8px);
    background: #f1f5f9;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
  }

  .resource-title {
    font-size: 1.3rem;
    color: var(--light-text-main);
    margin-bottom: 12px;
  }

  .resource-p {
    font-size: 0.95rem;
    color: var(--light-text-sub);
    line-height: 1.65;
    margin-bottom: 24px;
  }

  .resource-link {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--industrial-green);
    text-decoration: none;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    letter-spacing: 0.5px;
    transition: color 0.25s;
  }

  .resource-link:hover {
    color: var(--industrial-green-hover);
  }

  .resource-link::after {
    content: "→";
    margin-left: 8px;
    font-size: 1rem;
    transition: transform 0.25s ease;
  }

  .resource-link:hover::after {
    transform: translateX(4px);
  }

  /* ════════════ 6. FAQ ACCORDION ════════════ */
  .faq-section-wrapper {
    background: var(--light-bg);
    padding: 90px 30px;
  }

  .faq-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .faq-head {
    text-align: center;
    margin-bottom: 48px;
  }

  .faq-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 700;
    color: var(--industrial-green);
    display: block;
    margin-bottom: 8px;
  }

  .faq-head .heading-font {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    color: var(--light-text-main);
  }

  .faq-accordion-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid var(--light-border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .faq-item:hover {
    border-color: rgba(5, 150, 105, 0.4);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
  }

  .faq-question-btn {
    width: 100%;
    background: none;
    border: none;
    padding: 24px;
    display: flex;
    align-items: center;
    text-align: left;
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--light-text-main);
    transition: color 0.25s;
  }

  .faq-question-btn:hover {
    color: var(--industrial-green);
  }

  .faq-q-prefix {
    color: var(--industrial-green);
    margin-right: 12px;
    font-weight: 800;
  }

  .faq-q-text {
    flex-grow: 1;
    line-height: 1.4;
  }

  .faq-icon {
    width: 20px;
    height: 20px;
    position: relative;
    flex-shrink: 0;
    margin-left: 16px;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    background-color: var(--light-text-sub);
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  /* Horizontal line */
  .faq-icon::before {
    top: 9px;
    left: 2px;
    width: 16px;
    height: 2px;
  }

  /* Vertical line */
  .faq-icon::after {
    top: 2px;
    left: 9px;
    width: 2px;
    height: 16px;
  }

  .faq-question-btn[aria-expanded="true"] .faq-icon::before {
    background-color: var(--industrial-green);
  }

  .faq-question-btn[aria-expanded="true"] .faq-icon::after {
    transform: rotate(90deg);
    opacity: 0;
    background-color: var(--industrial-green);
  }

  .faq-answer-panel {
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
  }

  .faq-answer-panel:not([hidden]) {
    opacity: 1;
  }

  .faq-a-content {
    padding: 0 24px 24px 44px;
    font-size: 0.95rem;
    color: var(--light-text-sub);
    line-height: 1.7;
    border-top: 1px solid #f8fafc;
  }

  /* ════════════ 7. ENGINEERING DOSSIER ════════════ */
  .tech-dossier {
    background: #0f172a;
    color: #cbd5e1;
    padding: 90px 30px;
    border-top: 5px solid var(--industrial-green);
  }

  .dossier-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .dossier-head {
    margin-bottom: 50px;
  }

  .dossier-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 700;
    color: var(--industrial-green);
    display: block;
    margin-bottom: 8px;
  }

  .dossier-title {
    color: white;
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    margin: 0 0 16px 0;
  }

  .dossier-line {
    width: 80px;
    height: 4px;
    background: var(--industrial-green);
    border-radius: 2px;
  }

  .dossier-col-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
  }

  .dossier-text h3 {
    color: white;
    font-size: 1.25rem;
    margin-top: 32px;
    margin-bottom: 16px;
    letter-spacing: 0.5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 10px;
  }

  .dossier-text p {
    margin-bottom: 20px;
    line-height: 1.75;
    font-size: 0.92rem;
    text-align: justify;
    color: #94a3b8;
  }

  .dossier-text strong {
    color: #ffffff;
  }

  /* ════════════ 8. RESPONSIVE MEDIA QUERIES ════════════ */
  @media (max-width: 1150px) { 
    .ind-grid { 
      grid-template-columns: repeat(2, minmax(0, 1fr)); 
    } 
    .resource-grid, 
    .dossier-col-layout { 
      grid-template-columns: 1fr; 
    }
  }

  @media (max-width: 768px) { 
    .ind-grid { 
      grid-template-columns: 1fr; 
    }
    .ind-hero {
      padding: 60px 20px 70px;
    }
    .ind-container,
    .resource-section,
    .faq-section-wrapper,
    .tech-dossier {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  /* ── FAQ ACCORDION CODE ── */
  const initAccordion = () => {
    const items = document.querySelectorAll('.faq-item');
    
    items.forEach(item => {
      const button = item.querySelector('.faq-question-btn') as HTMLButtonElement;
      const panel = item.querySelector('.faq-answer-panel') as HTMLDivElement;
      
      if (!button || !panel) return;
      
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        
        // Collapse all other panels
        items.forEach(otherItem => {
          if (otherItem !== item) {
            const otherBtn = otherItem.querySelector('.faq-question-btn');
            const otherPanel = otherItem.querySelector('.faq-answer-panel') as HTMLDivElement;
            if (otherBtn && otherPanel) {
              otherBtn.setAttribute('aria-expanded', 'false');
              otherPanel.style.maxHeight = '0';
              setTimeout(() => {
                otherPanel.setAttribute('hidden', '');
              }, 300);
            }
          }
        });

        if (isExpanded) {
          button.setAttribute('aria-expanded', 'false');
          panel.style.maxHeight = '0';
          setTimeout(() => {
            panel.setAttribute('hidden', '');
          }, 300);
        } else {
          button.setAttribute('aria-expanded', 'true');
          panel.removeAttribute('hidden');
          // Scroll height calculation for animation
          panel.style.maxHeight = panel.scrollHeight + 'px';
        }
      });
    });
  };

  initAccordion();

  /* ── GSAP ANIMATIONS ── */

  /* blue/green → actual text-color char reveal */
  const charReveal = (selector: string, delay = 0) => {
    gsap.fromTo(selector,
      { opacity: 0, x: -8, color: '#059669', webkitTextFillColor: '#059669' },
      {
        opacity: 1, x: 0, color: '#059669', webkitTextFillColor: '#059669',
        duration: 0.45, stagger: 0.01, delay, ease: 'power3.out',
        onComplete: () => {
          gsap.to(selector, { clearProps: 'color,webkitTextFillColor', duration: 0.4, stagger: 0.01, ease: 'power2.inOut' });
        }
      }
    );
  };

  const fadeUp = (targets: gsap.TweenTarget, delay = 0, stagger = 0) =>
    gsap.to(targets, { opacity: 1, y: 0, duration: 0.6, stagger, delay, ease: 'power2.out' });

  /* ── HERO (on load) ── */
  const startHero = () => {
    const tl = gsap.timeline();
    tl.to('.ind-hero .ind-hero-badge', { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' });
    tl.fromTo('.ind-hero .ac',
      { opacity: 0, x: -8, color: '#059669', webkitTextFillColor: '#059669' },
      { opacity: 1, x: 0, color: '#059669', webkitTextFillColor: '#059669', duration: 0.5, stagger: 0.012, ease: 'power3.out' },
      '-=0.2'
    ).to('.ind-hero .ac', { clearProps: 'color,webkitTextFillColor', duration: 0.45, stagger: 0.012, ease: 'power2.inOut' }, '-=0.45');
    tl.to('.ind-hero .ind-subtitle', { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.4');
    tl.to('.ind-hero-desc', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3');
  };

  startHero();

  /* ── Generic per-section reveal ── */
  const section = (sel: string, opts: { bodyDelay?: number; stagger?: number } = {}) => {
    const el = document.querySelector(sel);
    if (!el) return;
    ScrollTrigger.create({
      trigger: sel,
      start: 'top 80%',
      once: true,
      onEnter: () => {
        fadeUp(`${sel} .reveal`, opts.bodyDelay ?? 0.1, opts.stagger ?? 0.08);
      }
    });
  };

  // Animate showcase container title and grid items
  section('.ind-container', { stagger: 0.05 });
  section('.resource-section', { stagger: 0.06 });
  section('.faq-section-wrapper', { stagger: 0.06 });
  section('.tech-dossier', { stagger: 0.08 });
</script>
