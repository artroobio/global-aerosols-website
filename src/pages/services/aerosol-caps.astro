    color: var(--brand-blue);
    display: block;
    margin-bottom: 8px;
  }

  .dossier-title {
    color: white;
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    margin: 0 0 16px 0;
  }

  .dossier-line {
