---
import Layout from '../../lc/layouts/Layout.astro';
import ContactFormVideo from '../../lc/components/ContactFormVideo.astro';
import ProductSupplyBlock from '../../lc/components/ProductSupplyBlock.astro';

const components = [
  {
    index: '01',
    name: 'Tin Plate Aerosol Caps',
    tag: 'Industrial',
    specs: [
      { key: 'Diameter', val: '52mm / 65mm' },
      { key: 'Material', val: 'PP / Metal' },
      { key: 'Fit', val: 'Steel Cans' }
    ],
    img: 'https://cdn.globalaerosols.com/images/products/aerosol-caps/aerosol-cap-01.webp',
    alt: 'Tin plate Aerosol caps for steel cans'
  },
  {
    index: '02',
    name: 'Spray Caps',
    tag: 'Actuators',
    specs: [
      { key: 'Pattern', val: 'Fog / Stream' },
      { key: 'Insert', val: 'Variable MBU' },
      { key: 'Color', val: 'Customizable' }
    ],
    img: 'https://cdn.globalaerosols.com/images/products/aerosol-caps/aerosol-actuators.webp',
    alt: 'Aerosol spray caps and actuators'
  },
  {
    index: '03',
    name: 'Aluminium Can Caps',
    tag: 'Cosmetic',
    specs: [
      { key: 'Diameter', val: '35mm / 45mm' },
      { key: 'Finish', val: 'Gloss / Matte' },
      { key: 'Style', val: 'Seamless' }
    ],
    img: 'https://cdn.globalaerosols.com/images/products/aerosol-caps/aluminium-can-caps.webp',
    alt: 'Aluminium can caps for monobloc bottles'
  },
  {
    index: '04',
    name: 'Cap with Extension Tube',
    tag: 'Technical',
    specs: [
      { key: 'Straw', val: 'Integrated' },
      { key: 'Use', val: 'Lubricants' },
      { key: 'Feature', val: '2-Way Spray' }
    ],
    img: 'https://cdn.globalaerosols.com/images/products/aerosol-caps/cap-with-extension-tube.webp',
    alt: 'Aerosol cap with extension tube smart straw'
  },
  {
    index: '05',
    name: 'Trigger Spray Cap',
    tag: 'Ergonomic',
    specs: [
      { key: 'Grip', val: 'Pistol Style' },
      { key: 'Safety', val: 'Locking Tab' },
      { key: 'Output', val: 'High Volume' }
    ],
    img: 'https://cdn.globalaerosols.com/images/products/aerosol-caps/trigger-spray-valve.webp',
    alt: 'Trigger spray cap for aerosol cans'
  }
];

const faqs = [
  {
    q: 'What is the difference between Tinplate and Aluminium caps?',
    a: 'The difference lies in the diameter and fit. Tinplate caps typically fit 52mm, 57mm, or 65mm steel cans (often used for paints and lubricants), while Aluminium caps are designed for the 35mm, 45mm, or 53mm shoulders of monobloc aluminium cans (cosmetics and pharma).'
  },
  {
    q: 'When should I use a cap with an extension tube?',
    a: 'Extension tubes (or "smart straws") are essential for products requiring precision application, such as penetrating oils, electronics cleaners, and compressed air dusters. They allow the user to direct the spray into tight crevices.'
  },
  {
    q: 'Are trigger sprayers compatible with standard aerosol valves?',
    a: 'Yes, our trigger spray caps are designed to snap onto standard mounting cups. They convert a standard vertical valve actuation into a gun-style grip, which is ideal for furniture polish, garden sprays, and other products requiring prolonged spraying.'
  },
  {
    q: 'Can spray caps be customized for different spray patterns?',
    a: 'Absolutely. The colored insert within the spray cap determines the spray morphology (fan, cone, or stream) and the particle size (MBU). We can swap inserts to match your formulation\'s viscosity.'
  }
];

const splitWords = (s: string) => s.split(' ');

const SITE = 'https://www.globalaerosols.com';
const PAGE_URL = `${SITE}/services/aerosol-caps/`;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Aerosol Cap & Overcap Catalog',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: components.length,
  itemListElement: components.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: c.name,
      image: c.img,
      description: c.alt,
      category: 'Aerosol Caps & Closures',
      brand: { '@type': 'Brand', name: 'Global Aerosols' },
      additionalProperty: c.specs.map(s => ({ '@type': 'PropertyValue', name: s.key, value: s.val })),
      offers: {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        businessFunction: 'http://purl.org/goodrelations/v1#Sell',
        areaServed: 'Worldwide',
        seller: { '@id': `${SITE}/#organization` },
        url: PAGE_URL
      }
    }
  }))
};

const serviceSchema = ['Custom Cap Tooling & Moulding', 'Colour Matching & Finishing', 'Wholesale & Bulk Supply'].map(name => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: name,
  provider: { '@id': `${SITE}/#organization` },
  areaServed: 'Worldwide',
  url: PAGE_URL
}));

const commercialSchema = [itemListSchema, ...serviceSchema];
---

<Layout
  title="Aerosol Caps & Overcaps — Wholesale Supplier | Spray Caps & Actuators | Global Aerosols"
  description="Wholesale supplier of aerosol overcaps, spray caps and custom actuators for tinplate steel and monobloc aluminium cans. Bulk & OEM supply with custom tooling — request a quote."
>
  <script type="application/ld+json" is:inline>
    [
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [{
          "@type": "Question",
          "name": "What is the difference between Tinplate and Aluminium caps?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The difference lies in the diameter and fit. Tinplate caps typically fit 52mm, 57mm, or 65mm steel cans (often used for paints and lubricants), while Aluminium caps are designed for the 35mm, 45mm, or 53mm shoulders of monobloc aluminium cans (cosmetics and pharma)."
          }
        }, {
          "@type": "Question",
          "name": "When should I use a cap with an extension tube?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Extension tubes (or 'smart straws') are essential for products requiring precision application, such as penetrating oils, electronics cleaners, and compressed air dusters. They allow the user to direct the spray into tight crevices."
          }
        }, {
          "@type": "Question",
          "name": "Are trigger sprayers compatible with standard aerosol valves?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, our trigger spray caps are designed to snap onto standard mounting cups. They convert a standard vertical valve actuation into a gun-style grip, which is ideal for furniture polish, garden sprays, and other products requiring prolonged spraying."
          }
        }, {
          "@type": "Question",
          "name": "Can spray caps be customized for different spray patterns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. The colored insert within the spray cap determines the spray morphology (fan, cone, or stream) and the particle size (MBU). We can swap inserts to match your formulation's viscosity."
          }
        }]
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.globalaerosols.com/"
        },{
          "@type": "ListItem",
          "position": 2,
          "name": "Products",
          "item": "https://www.globalaerosols.com/products/"
        },{
          "@type": "ListItem",
          "position": 3,
          "name": "Aerosol Caps"
        }]
      }
    ]
  </script>

  <!-- ── Commercial Product / ItemList / Service schema (marketplace signal) ── -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(commercialSchema)} />

  <div class="industrial-light-wrapper" id="industrial-light-caps-blue">
    
    <!-- ════════════ BREADCRUMBS ════════════ -->
    <div class="ind-breadcrumbs">
      <a href="/" target="_top">Home</a> <span>/</span> <a href="/products/" target="_top">Products</a> <span>/</span> <span class="curr-page">Aerosol Caps</span>
    </div>

    <!-- ════════════ HERO ════════════ -->
    <section class="ind-hero">
      <div class="ind-hero-inner">
        <span class="ind-hero-badge">Injection Molding & Actuators</span>
        <h1 class="ind-title">
          {splitWords('Industrial Aerosol Caps & Spray Actuators').map(word => (
            <span class="aw">{word.split('').map(c => <span class="ac">{c}</span>)}</span>
          ))}
        </h1>
        <p class="ind-subtitle reveal">Specialized Closures for Tinplate & Aluminium</p>
        <p class="ind-hero-desc reveal">
          Global Aerosols provides a complete range of closure solutions. From <strong>Tinplate Aerosol Caps</strong> for industrial lubricants to cosmetic <strong>Aluminium Can Caps</strong>. We also specialize in technical actuators, including <strong>caps with extension tubes</strong> and ergonomic <strong>trigger sprayers</strong>.
        </p>
      </div>
    </section>

    <!-- ════════════ SHOWCASE GRID ════════════ -->
    <section class="ind-container">
      <div class="grid-header reveal">
        <span class="grid-eyebrow">Container Closures</span>
        <h2 class="grid-title">Technical Specifications</h2>
        <div class="grid-line-bar"></div>
      </div>

      <div class="ind-grid">
        {components.map((can, idx) => (
          <div class="ind-card reveal" data-index={idx}>
            <div class="card-index">{can.index}</div>
            <div class="img-zone">
              <img src={can.img} alt={can.alt} loading="lazy" width="350" height="350" />
            </div>
            <div class="info-zone">
              <span class="cat-tag">{can.tag}</span>
              <h3 class="prod-name">{can.name}</h3>
              <div class="spec-grid">
                {can.specs.map(spec => (
                  <span class="spec-key">{spec.key}</span>
                  <span class="spec-val">{spec.val}</span>
                ))}
              </div>
              <a href="/contact/" class="action-btn">Request Quote</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════════ SUPPLY SPECS / MOQ / LEAD TIMES / CTA ════════════ -->
    <ProductSupplyBlock
      eyebrow="Wholesale Supply"
      heading="Sizes, MOQ & Lead Times"
      columns={["Closure Type", "Diameters", "Material", "Typical MOQ", "Lead Time"]}
      rows={[
        ["Tinplate Caps", "52 / 57 / 65 mm", "PP / Metal", "50,000 pcs", "4–6 weeks"],
        ["Aluminium Caps", "35 / 45 / 53 mm", "Aluminium / PP", "50,000 pcs", "4–6 weeks"],
        ["Spray Caps & Actuators", "Standard fit", "PP / PE", "100,000 pcs", "4–6 weeks (custom)"],
        ["Trigger / Extension Caps", "Snap-on", "PP", "50,000 pcs", "5–7 weeks"],
      ]}
      badges={["Custom Colour Matching", "Variable MBU Inserts", "Gloss / Matte Finish", "Custom Moulding"]}
      ctaText="Request a quote for wholesale aerosol caps, overcaps and actuators — custom tooling and colours included."
      industries={[
        { label: "Cosmetics & Personal Care", href: "/cosmetics-and-personal-care-aerosols-guide/" },
        { label: "Automotive", href: "/automotive-aerosol-products/" },
        { label: "Household & Cleaning", href: "/household-cleaners-formulations-technology/" },
        { label: "Pharmaceutical", href: "/pharmaceutical-and-healthcare-guide/" },
      ]}
      related={[
        { label: "Aerosol Cans", href: "/services/aerosol-cans/" },
        { label: "Valves & Actuators", href: "/services/aerosol-valves-caps-and-actuators/" },
        { label: "Filling Equipment", href: "/services/aerosol-machines-and-equipment/" },
      ]}
    />

    <!-- ════════════ ENGINEERING RESOURCES ════════════ -->
    <section class="resource-section">
      <div class="resource-head reveal">
        <span class="resource-eyebrow">Technical Knowledge Hub</span>
        <h2 class="heading-font">Engineering <span class="highlight">Resources</span></h2>
        <p class="resource-subtitle-text">Review the documentation and mechanical blueprints that power our flow control systems.</p>
      </div>
      
      <div class="resource-grid">
        <div class="resource-card reveal">
          <h3 class="resource-title">Crimping & Leak Detection</h3>
          <p class="resource-p">A guide to the most critical manufacturing steps: ensuring a safe seal with crimp depth validation and water bath testing.</p>
          <a href="/aerosol-crimping-gassing-leak-detection-explained/" class="resource-link">View Tech Guide</a>
        </div>
        <div class="resource-card reveal">
          <h3 class="resource-title">Actuators 101</h3>
          <p class="resource-p">Understanding the components that determine spray patterns, particle size (MBU), and consumer experience.</p>
          <a href="/aerosol-actuators-101/" class="resource-link">Actuator Guide</a>
        </div>
        <div class="resource-card reveal">
          <h3 class="resource-title">Manufacturing 101</h3>
          <p class="resource-p">A comprehensive overview of the aerosol production line, from empty cans to finished goods.</p>
          <a href="/aerosol-manufacturing-101-guide/" class="resource-link">Production Flow</a>
        </div>
        <div class="resource-card reveal">
          <h3 class="resource-title">How Aerosol Cans Work</h3>
          <p class="resource-p">The physics behind pressurized packaging: the relationship between propellants, product, and pressure.</p>
          <a href="/how-aerosol-cans-work/" class="resource-link">Physics Explained</a>
        </div>
      </div>
    </section>

    <!-- ════════════ FAQ SECTION ════════════ -->
    <section class="faq-section-wrapper">
      <div class="faq-container">
        <div class="faq-head reveal">
          <span class="faq-eyebrow">Common Enquiries</span>
          <h2 class="heading-font">Closures Technical FAQ</h2>
        </div>
        
        <div class="faq-accordion-group">
          {faqs.map((faq, i) => (
            <div class="faq-item reveal">
              <button class="faq-question-btn" aria-expanded="false" aria-controls={`faq-answer-${i}`}>
                <span class="faq-q-prefix">Q.</span>
                <span class="faq-q-text">{faq.q}</span>
                <span class="faq-icon"></span>
              </button>
              <div id={`faq-answer-${i}`} class="faq-answer-panel" hidden>
                <div class="faq-a-content">
                  {faq.a}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════ VALVE ENGINEERING DOSSIER ════════════ -->
    <section class="tech-dossier">
      <div class="dossier-container">
        <div class="dossier-head reveal">
          <span class="dossier-eyebrow">Technical Dossier</span>
          <h2 class="dossier-title">Closures Engineering Dossier</h2>
          <div class="dossier-line"></div>
        </div>
        
        <div class="dossier-col-layout">
          <div class="dossier-text reveal">
            <h3>1. Injection Molding Precision</h3>
            <p>Aerosol overcaps are manufactured using High-Speed Injection Molding. Polypropylene (PP) pellets are melted and injected into a steel mold cavity under high pressure. The cooling cycle determines the crystalline structure and impact resistance of the cap. We maintain tolerances of +/- 0.1mm to ensure the "snap fit" remains secure during transport but removable by the consumer.</p>
            <p>For custom branding, we utilize In-Mold Labeling (IML) or post-mold pad printing to apply logos directly onto the plastic surface.</p>

            <h3>2. Snap-Fit Tribology</h3>
            <p>The retention force of a cap is governed by the friction between the cap ribs and the can's mounting cup or shoulder. We engineer the <strong>Undercut Geometry</strong> to provide an audible "click" upon closure. If the retention is too low (&lt;2kg), the cap falls off on the shelf; if too high (&gt;6kg), the consumer cannot remove it easily. We balance this for optimal user experience.</p>
          </div>

          <div class="dossier-text reveal">
            <h3>3. The Mechanics of Trigger Actuators</h3>
            <p>Trigger caps are complex assemblies involving a lever, a pivot point, and a vertical actuation channel. Unlike standard buttons, the trigger mechanism translates horizontal finger force into vertical valve depression. This reduces finger fatigue during extended use, making them the standard for household cleaners and garden insecticides.</p>
            
            <h3>4. Extension Tube Integration</h3>
            <p>For "Smart Straw" or extension tube caps, the actuator insert is modified to accept a polyethylene tube. The fit must be tight enough to prevent the tube from becoming a projectile under pressure (70+ PSI), yet allow for smooth flow. We utilize press-fit automation to ensure consistent tube retention and alignment.</p>

            <h3>5. Material Science: PP vs. PCR</h3>
            <p>Virgin Polypropylene (PP) offers the best clarity and color vibrancy. However, environmental regulations are driving the shift to Post-Consumer Recycled (PCR) plastics. We modify our mold flow analysis for PCR resins, which have a slightly different melt flow index (MFI), ensuring that sustainable caps retain the same structural integrity as virgin materials.</p>
          </div>
        </div>
      </div>
    </section>

  </div>

  <ContactFormVideo />
</Layout>

<style>
  /* ════════════ 1. CORE THEME & BACKGROUND ════════════ */
  :root {
    --light-bg: #f8fafc;       
    --light-card: #ffffff;     
    --light-text-main: #0f172a; 
    --light-text-sub: #475569;  
    --light-border: #e2e8f0;   
    --brand-blue: #0968e5;  
    --brand-blue-hover: #2563eb;
    --grid-line: #cbd5e1;      
  }

  .industrial-light-wrapper * { 
    box-sizing: border-box; 
  }

  .industrial-light-wrapper {
    font-family: 'Inter', 'Roboto', sans-serif;
    background-color: var(--light-bg);
    color: var(--light-text-main);
    padding-bottom: 0px; 
    /* Premium Technical Grid Background */
    background-image: 
      linear-gradient(rgba(203, 213, 225, 0.25) 1px, transparent 1px),
      linear-gradient(90deg, rgba(203, 213, 225, 0.25) 1px, transparent 1px);
    background-size: 50px 50px;
    position: relative;
  }

  /* Font Styling */
  .heading-font, h1, h2, h3, .prod-name, .resource-title, .dossier-title {
    font-family: 'Outfit', 'Montserrat', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  /* GSAP initial reveal states */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
  }

  /* Animated heading char spans */
  .aw { 
    display: inline-block; 
    white-space: nowrap; 
    margin-right: 0.24em; 
  }
  .ac { 
    display: inline-block; 
    opacity: 0; 
    color: var(--brand-blue); 
    -webkit-text-fill-color: var(--brand-blue); 
  }

  /* ════════════ 2. BREADCRUMBS ════════════ */
  .ind-breadcrumbs {
    max-width: 1400px;
    margin: 0 auto;
    padding: 100px 30px 0; /* Padding top accounts for navbar height */
    font-size: 0.72rem;
    color: var(--light-text-sub);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 2px;
  }
  .ind-breadcrumbs a {
    text-decoration: none;
    color: var(--light-text-sub);
    transition: color 0.25s ease;
  }
  .ind-breadcrumbs a:hover {
    color: var(--brand-blue);
  }
  .ind-breadcrumbs span {
    color: #94a3b8;
    margin: 0 8px;
  }
  .ind-breadcrumbs .curr-page {
    color: var(--light-text-main);
  }

  /* ════════════ 3. HERO SECTION ════════════ */
  .ind-hero {
    background: #ffffff;
    border-bottom: 6px solid var(--brand-blue);
    padding: 80px 30px 100px;
    text-align: center;
    position: relative;
    box-shadow: 0 4px 30px rgba(15, 23, 42, 0.03);
    margin-bottom: 60px;
    overflow: hidden;
  }

  .ind-hero::after {
    content: '';
    position: absolute;
    bottom: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(ellipse at center, rgba(9, 104, 229, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .ind-hero-inner {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .ind-hero-badge {
    display: inline-block;
    background: rgba(9, 104, 229, 0.09);
    color: var(--brand-blue);
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 0.72rem;
    padding: 6px 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    border-radius: 50px;
    border: 1px solid rgba(9, 104, 229, 0.2);
    margin-bottom: 24px;
  }

  .ind-title {
    font-size: clamp(2rem, 4.5vw, 3.8rem);
    color: var(--light-text-main);
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .ind-subtitle {
    color: var(--brand-blue);
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 28px;
  }

  .ind-hero-desc {
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    color: var(--light-text-sub);
    line-height: 1.75;
    max-width: 760px;
    margin: 0 auto;
  }

  /* ════════════ 4. SHOWCASE GRID ════════════ */
  .ind-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px 80px;
  }

  .grid-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .grid-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 700;
    color: var(--brand-blue);
    display: block;
    margin-bottom: 8px;
  }

  .grid-title {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    color: var(--light-text-main);
    margin-bottom: 16px;
  }

  .grid-line-bar {
    width: 60px;
    height: 4px;
    background: var(--brand-blue);
    margin: 0 auto;
    border-radius: 2px;
  }

  .ind-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  /* Card Layout */
  .ind-card {
    background: var(--light-card);
    border: 1px solid var(--light-border);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
    min-width: 0;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.015);
  }

  .ind-card:hover {
    border-color: var(--brand-blue);
    transform: translateY(-8px);
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
    z-index: 10;
  }

  .card-index {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--brand-blue);
    color: white;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 0.95rem;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    box-shadow: 0 4px 10px rgba(9, 104, 229, 0.25);
  }

  /* Image Container & Shine Sweep */
  .img-zone {
    height: 260px;
    background: #f8fafc;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--light-border);
    overflow: hidden;
    transition: border-color 0.4s;
    z-index: 2;
    padding: 30px;
  }

  .img-zone::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.75), transparent);
    transform: skewX(-25deg);
    transition: 0.6s ease-in-out;
    z-index: 10;
    pointer-events: none;
  }

  .ind-card:hover .img-zone::before {
    left: 150%;
  }

