---
import Layout from '../lc/layouts/Layout.astro';
import ContactFormVideo from '../lc/components/ContactFormVideo.astro';
---

<Layout
  title="Contact Us | Global Aerosols"
  description="Get in touch with the Global Aerosols team. Discuss your formulation project, request a consultation, or ask about our chemical engineering services."
  canonical="https://www.globalaerosols.com/contact"
>
  <section class="contact-hero">
    <div class="contact-hero-inner">
      <p class="eyebrow">Get in Touch</p>
      <h1>Let's start your Project</h1>
      <p class="lead">
        Whether you need a new product formulation, scale-up engineering, reverse engineering, or regulatory support — our team of chemical formulators and reaction engineers is ready to help.
      </p>
    </div>
  </section>

  <ContactFormVideo variant="contact" />

</Layout>

<style>
  .contact-hero {
    background: #f8fafc;
    padding: 100px 24px 60px;
    text-align: center;
    border-bottom: 1px solid #e2e8f0;
  }
  .contact-hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0968e5;
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.1;
    margin-bottom: 20px;
    font-family: 'Outfit', sans-serif;
  }
  .lead {
    font-size: 1.15rem;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 0;
  }
</style>
