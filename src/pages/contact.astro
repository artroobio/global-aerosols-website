---
import Layout from '../lc/layouts/Layout.astro';
import ContactFormVideo from '../lc/components/ContactFormVideo.astro';
---

<Layout
  title="Contact Us | Global Formulation"
  description="Get in touch with the Global Formulation team. Discuss your formulation project, request a consultation, or ask about our chemical engineering services."
  canonical="https://www.globalformulation.com/contact"
>
  <section class="contact-hero">
    <div class="contact-hero-inner">
      <p class="eyebrow">Get in Touch</p>
      <h1>Let's Build Your Formulation</h1>
      <p class="lead">
        Whether you need a new product formulation, scale-up engineering, reverse engineering, or regulatory support — our team of chemical formulators and reaction engineers is ready to help.
      </p>
      <div class="contact-cards">
        <div class="contact-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.6 3.43 2 2 0 0 1 3.56 1.25h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l.88-.88a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <div>
            <strong>Phone</strong>
            <a href="tel:+919819548320">+91 98195 48320</a>
          </div>
        </div>
        <div class="contact-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <div>
            <strong>Email</strong>
            <a href="mailto:consulting@globalformulation.com">consulting@globalformulation.com</a>
          </div>
        </div>
        <div class="contact-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <div>
            <strong>Location</strong>
            <span>Mumbai, India · Global Projects</span>
          </div>
        </div>
      </div>

      <a href="https://wa.me/918169102990" target="_blank" rel="noopener noreferrer" class="whatsapp-btn">
        <span class="wa-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>
        </span>
        <span class="wa-text">Message on WhatsApp</span>
      </a>
    </div>
  </section>

  <ContactFormVideo />

</Layout>

<style>
  .contact-hero {
    background: #f8fafc;
    padding: 100px 24px 60px;
    text-align: center;
    border-bottom: 1px solid #e2e8f0;
  }
  .contact-hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0968e5;
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.1;
    margin-bottom: 20px;
    font-family: 'Outfit', sans-serif;
  }
  .lead {
    font-size: 1.15rem;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 48px;
  }
  .contact-cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 18px 24px;
    text-align: left;
    min-width: 220px;
  }
  .contact-card svg {
    width: 28px;
    height: 28px;
    color: #0968e5;
    flex-shrink: 0;
  }
  .contact-card strong {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94a3b8;
    margin-bottom: 4px;
    font-family: 'Inter', sans-serif;
  }
  .contact-card a,
  .contact-card span {
    font-size: 0.95rem;
    color: #1e293b;
    font-weight: 600;
    text-decoration: none;
  }
  .contact-card a:hover { color: #0968e5; }

  /* WhatsApp CTA — blue gradient, sits below the contact cards */
  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 32px;
    padding: 16px 40px;
    border-radius: 14px;
    background: linear-gradient(135deg, #1a7cff 0%, #0a4fce 100%);
    color: #ffffff;
    text-decoration: none;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 12px 30px rgba(26, 124, 255, 0.35), 0 4px 10px rgba(0, 0, 0, 0.12);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1), filter 0.25s ease;
  }
  .whatsapp-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(26, 124, 255, 0.45), 0 6px 14px rgba(0, 0, 0, 0.15);
    filter: brightness(1.05);
  }
  .wa-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    flex-shrink: 0;
  }
  .wa-icon svg { display: block; }
</style>
