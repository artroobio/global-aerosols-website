              </tr>
              <tr style="border-bottom: 1px solid var(--border);">
                <td style="padding: 15px; font-weight: 600; border: 1px solid var(--border);"><strong>Group V</strong></td>
                <td style="padding: 15px; border: 1px solid var(--border);">Variable</td>
                <td style="padding: 15px; border: 1px solid var(--border);">Variable</td>
                <td style="padding: 15px; border: 1px solid var(--border);">Variable</td>
                <td style="padding: 15px; border: 1px solid var(--border);">Synthetic Esters, PAGs, Silicones, Bio-based stocks</td>
              </tr>
            </tbody>
          </table>
        </div>

