              <tr><td>Best skin type</td><td>Normal to combination</td><td>Dry to very dry</td></tr>
              <tr><td>Climate suitability</td><td>Temperate to warm</td><td>Cold, dry climates</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Diagram image -->
      <div class="article-img-wrap" style="margin: 2em 0 0.6em; border-radius: 6px; overflow: hidden; border: 1px solid #e4e4e0;">
