>
  <main class="section-container" style="max-width: 1000px; padding-left: 24px; padding-right: 24px; padding-top: 40px; padding-bottom: 80px;">
    
    <!-- HTML5 Compliant Breadcrumbs (target="_top" for framed environments) -->
    <nav aria-label="Breadcrumb" style="display: flex; gap: 8px; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 24px; font-family: 'Inter', sans-serif;">
