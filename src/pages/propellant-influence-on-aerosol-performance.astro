                    <td>Reduces need for co-solvents; higher material interaction</td>
                </tr>
                <tr>
                    <td>Non-Solvent</td>
                    <td>LPG, CO₂, N₂</td>
                    <td>Requires external solvents; predictable compatibility</td>
                </tr>
            </table>
        </section>

