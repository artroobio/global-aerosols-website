              <tr><td>Fatty acid ester</td><td>GMS, sorbitan esters, EO-esters</td><td>Interfacial competition with stabilising surfactant</td><td>0–80°C</td><td>Yes</td><td>Food-contact, personal care, textile</td></tr>
              <tr><td>Hydrophobic silica (no PDMS)</td><td>Precipitated silica + hydrophobising agent</td><td>Particle bridging without PDMS</td><td>0–200°C</td><td>Yes</td><td>Silicone-free industrial, paint lines</td></tr>
              <tr><td>Mineral oil + silica</td><td>Hydrophobic mineral oil + silica</td><td>Spreading + particle bridging</td><td>0–120°C</td><td>Yes</td><td>Cost-sensitive industrial, non-food</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Diagram image -->
      <img 
