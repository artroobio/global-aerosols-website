              <tr><td>Cathodic disbondment</td><td>Alkaline liquid</td><td>Metal-primer interface</td><td>Weeks–months in CP service</td><td>High pH interior; structure under CP</td></tr>
              <tr><td>Thermal</td><td>Dry or vapour</td><td>Film-substrate or within film</td><td>On first high-temperature exposure</td><td>Appears on thermal cycling; high-temp service</td></tr>
            </tbody>
          </table>
        </div>
      </section>

