---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

// Already logged in → go to dashboard
if (Astro.locals.user) {
  return Astro.redirect('/dashboard');
}

const redirect = Astro.url.searchParams.get('redirect') || '/dashboard';
const error    = Astro.url.searchParams.get('error');
const expired  = Astro.url.searchParams.get('expired');
---

<Layout title="Sign In — Global Aerosols Store" description="Sign in to access your purchased e-books from Global Aerosols." hideCart={true} robots="noindex, nofollow">
  <section class="auth-split">

    <!-- LEFT: sign-in options -->
    <div class="auth-panel">
      <div class="auth-inner">
        <div class="login-logo">
          <a href="/" target="_top">Global <span>Formulation</span></a>
        </div>

        <h1>Sign in to the Store</h1>
        <p class="login-sub">Access your purchased e-books and downloads. Sign in with your email, or continue with Google.</p>

        {expired && <div class="login-notice">Your session expired. Please sign in again.</div>}
        {error   && <div class="login-error">Sign-in failed. Please try again.</div>}

        <!-- Step 1: details + request code -->
        <form id="email-form" class="auth-form" data-redirect={redirect} novalidate>
          <label class="field">
            <span>Full name</span>
            <input type="text" name="name" autocomplete="name" placeholder="Your name" required />
          </label>
          <label class="field">
            <span>Email address</span>
            <input type="email" name="email" autocomplete="email" placeholder="you@company.com" required />
          </label>
          <label class="field">
            <span>Phone number</span>
            <input type="tel" name="phone" autocomplete="tel" placeholder="+91 …" required />
          </label>

          <p class="form-msg" id="form-msg-1" role="alert"></p>

          <button type="submit" class="btn btn-primary" id="send-code-btn">
            Email me a sign-in code
          </button>
        </form>

        <!-- Step 2: verify code (hidden until step 1 succeeds) -->
        <form id="code-form" class="auth-form" data-redirect={redirect} hidden>
          <p class="code-sent">We sent a 6-digit code to <strong id="sent-to"></strong>.</p>
          <label class="field">
            <span>Verification code</span>
            <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code"
                   maxlength="6" placeholder="••••••" required />
          </label>

          <p class="form-msg" id="form-msg-2" role="alert"></p>

          <button type="submit" class="btn btn-primary" id="verify-btn">Verify &amp; sign in</button>
          <div class="code-actions">
            <button type="button" class="link-btn" id="resend-btn">Resend code</button>
            <button type="button" class="link-btn" id="change-btn">Use a different email</button>
          </div>
        </form>

        <div class="auth-divider"><span>or</span></div>

        <a href={`/api/auth/google?redirect=${encodeURIComponent(redirect)}`} class="google-btn">
          <svg width="20" height="20" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M43.611 20.083H42V20H24V28H35.303C33.654 32.657 29.223 36 24 36C17.373 36 12 30.627 12 24C12 17.373 17.373 12 24 12C27.059 12 29.842 13.154 31.961 15.039L37.618 9.382C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24C4 35.045 12.955 44 24 44C35.045 44 44 35.045 44 24C44 22.659 43.862 21.35 43.611 20.083Z" fill="#FFC107"/>
            <path d="M6.306 14.691L12.877 19.51C14.655 15.108 18.961 12 24 12C27.059 12 29.842 13.154 31.961 15.039L37.618 9.382C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691Z" fill="#FF3D00"/>
            <path d="M24 44C29.166 44 33.86 42.023 37.409 38.808L31.219 33.57C29.211 35.091 26.715 36 24 36C18.798 36 14.381 32.683 12.717 28.054L6.195 33.079C9.505 39.556 16.227 44 24 44Z" fill="#4CAF50"/>
            <path d="M43.611 20.083H42V20H24V28H35.303C34.511 30.237 33.072 32.166 31.216 33.571L31.219 33.569L37.409 38.807C36.971 39.205 44 34 44 24C44 22.659 43.862 21.35 43.611 20.083Z" fill="#1976D2"/>
          </svg>
          Continue with Google
        </a>

        <p class="login-terms">
          By signing in you agree to our
          <a href="/terms-and-conditions/" target="_top">Terms</a> and
          <a href="/privacy-policy/" target="_top">Privacy Policy</a>.
        </p>
      </div>
    </div>

    <!-- RIGHT: imagery -->
    <div class="auth-image">
      <div class="auth-image-overlay">
        <p class="auth-quote">“Formulation is where chemistry becomes product.”</p>
        <p class="auth-quote-sub">Technical e-books from practising industrial consultants.</p>
      </div>
    </div>

  </section>
</Layout>

<script is:inline>
  (function () {
    const emailForm = document.getElementById('email-form');
    const codeForm  = document.getElementById('code-form');
    const msg1 = document.getElementById('form-msg-1');
    const msg2 = document.getElementById('form-msg-2');
    const sentTo = document.getElementById('sent-to');
    const sendBtn = document.getElementById('send-code-btn');
    const verifyBtn = document.getElementById('verify-btn');
    let currentEmail = '';

    function setMsg(el, text, ok) {
      el.textContent = text || '';
      el.classList.toggle('is-error', !!text && !ok);
      el.classList.toggle('is-ok', !!text && !!ok);
    }

    emailForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      setMsg(msg1, '', false);
      const fd = new FormData(emailForm);
      const payload = {
        name:  (fd.get('name')  || '').toString().trim(),
        email: (fd.get('email') || '').toString().trim(),
        phone: (fd.get('phone') || '').toString().trim(),
      };
      sendBtn.disabled = true;
      sendBtn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/auth/email/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) { setMsg(msg1, data.error || 'Something went wrong.', false); return; }
        currentEmail = payload.email;
        sentTo.textContent = payload.email;
        emailForm.hidden = true;
        codeForm.hidden = false;
        codeForm.querySelector('input[name="code"]').focus();
      } catch {
        setMsg(msg1, 'Network error. Please try again.', false);
      } finally {
        sendBtn.disabled = false;
        sendBtn.textContent = 'Email me a sign-in code';
      }
    });

    codeForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      setMsg(msg2, '', false);
      const code = (new FormData(codeForm).get('code') || '').toString().trim();
      verifyBtn.disabled = true;
      verifyBtn.textContent = 'Verifying…';
      try {
        const res = await fetch('/api/auth/email/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: currentEmail, code, redirect: codeForm.dataset.redirect }),
        });
        const data = await res.json();
        if (!res.ok) { setMsg(msg2, data.error || 'Invalid code.', false); return; }
        window.location.href = data.redirect || '/dashboard';
      } catch {
        setMsg(msg2, 'Network error. Please try again.', false);
      } finally {
        verifyBtn.disabled = false;
        verifyBtn.textContent = 'Verify & sign in';
      }
    });

    document.getElementById('resend-btn').addEventListener('click', async () => {
      setMsg(msg2, '', false);
      const fd = new FormData(emailForm);
      try {
        const res = await fetch('/api/auth/email/request', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: (fd.get('name')||'').toString().trim(),
            email: currentEmail,
            phone: (fd.get('phone')||'').toString().trim(),
          }),
        });
        const data = await res.json();
        setMsg(msg2, res.ok ? 'A new code is on its way.' : (data.error || 'Could not resend.'), res.ok);
      } catch { setMsg(msg2, 'Network error. Please try again.', false); }
    });

    document.getElementById('change-btn').addEventListener('click', () => {
      codeForm.hidden = true;
      emailForm.hidden = false;
      setMsg(msg2, '', false);
    });
  })();
</script>

<style>
  .auth-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: calc(100vh - 60px);
  }

  /* ── Left panel ── */
  .auth-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F9F9F7;
    padding: 28px 32px;
    overflow-y: auto;
  }
  .auth-inner { width: 100%; max-width: 400px; }

  .login-logo a {
    font-family: 'Playfair Display', serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #0A0A0A;
    text-decoration: none;
  }
  .login-logo span { color: #0968e5; }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 700;
    margin: 14px 0 6px;
    color: #0A0A0A;
  }
  .login-sub { color: #6B7280; font-size: 0.9rem; margin: 0 0 16px; line-height: 1.5; }

  .login-notice {
    background: #FFF8E1; border: 1px solid #F59E0B; color: #92400E;
    border-radius: 6px; padding: 10px 14px; font-size: 0.88rem; margin-bottom: 16px;
  }
  .login-error {
    background: #FEF2F2; border: 1px solid #FCA5A5; color: #991B1B;
    border-radius: 6px; padding: 10px 14px; font-size: 0.88rem; margin-bottom: 16px;
  }

  /* ── Form ── */
  .auth-form { display: flex; flex-direction: column; gap: 10px; }
  .auth-form[hidden] { display: none; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field span {
    font-family: 'Outfit', sans-serif; font-size: 0.8rem; font-weight: 600;
    color: #374151; letter-spacing: 0.01em;
  }
  .field input {
    width: 100%; padding: 10px 14px; border: 1.5px solid #E4E4E0; border-radius: 8px;
    font-size: 0.95rem; color: #0A0A0A; background: #fff; transition: border-color 0.15s, box-shadow 0.15s;
  }
  .field input::placeholder { color: #B6BBC2; }
  .field input:focus {
    outline: none; border-color: #0968e5; box-shadow: 0 0 0 3px rgba(9, 104, 229,0.12);
  }

  .code-sent { font-size: 0.9rem; color: #374151; margin: 0; line-height: 1.5; }
  .code-sent strong { color: #0A0A0A; }
  .code-form input[name="code"] { letter-spacing: 0.4em; font-size: 1.1rem; text-align: center; }

  .form-msg { font-size: 0.85rem; margin: 0; min-height: 1px; }
  .form-msg.is-error { color: #B91C1C; }
  .form-msg.is-ok    { color: #15803D; }

  .btn {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; padding: 11px 18px; border-radius: 8px; border: none; cursor: pointer;
    font-family: 'Outfit', sans-serif; font-size: 0.95rem; font-weight: 700;
    transition: opacity 0.15s, transform 0.15s;
  }
  .btn-primary { background: #0968e5; color: #fff; }
  .btn-primary:hover:not(:disabled) { opacity: 0.9; transform: translateY(-1px); }
  .btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .code-actions { display: flex; justify-content: space-between; gap: 12px; margin-top: 2px; }
  .link-btn {
    background: none; border: none; padding: 0; cursor: pointer;
    color: #0968e5; font-size: 0.82rem; font-family: 'Outfit', sans-serif; font-weight: 600;
  }
  .link-btn:hover { text-decoration: underline; }

  .auth-divider {
    display: flex; align-items: center; text-align: center;
    color: #9CA3AF; font-size: 0.8rem; margin: 14px 0;
  }
  .auth-divider::before, .auth-divider::after {
    content: ''; flex: 1; height: 1px; background: #E4E4E0;
  }
  .auth-divider span { padding: 0 14px; }

  .google-btn {
    display: flex; align-items: center; justify-content: center; gap: 12px;
    width: 100%; padding: 11px 20px; background: #fff; border: 1.5px solid #E4E4E0;
    border-radius: 8px; font-family: 'Outfit', sans-serif; font-size: 0.95rem;
    font-weight: 600; color: #0A0A0A; text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .google-btn:hover { border-color: #0968e5; box-shadow: 0 0 0 3px rgba(9, 104, 229,0.1); }

  .login-terms { margin-top: 14px; font-size: 0.78rem; color: #9CA3AF; }
  .login-terms a { color: #6B7280; }
  .login-terms a:hover { color: #0968e5; }

  /* ── Right image ── */
  .auth-image {
    position: relative;
    background-image: linear-gradient(180deg, rgba(8,20,40,0.15), rgba(8,20,40,0.55)),
      url('/images/cap-scientists.webp');
    background-size: cover;
    background-position: center;
  }
  .auth-image-overlay {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 48px 44px; color: #fff;
  }
  .auth-quote {
    font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700;
    line-height: 1.3; margin: 0 0 8px; max-width: 460px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }
  .auth-quote-sub {
    font-size: 0.95rem; color: rgba(255,255,255,0.9); margin: 0;
    text-shadow: 0 1px 8px rgba(0,0,0,0.4);
  }

  /* ── Responsive ── */
  @media (max-width: 880px) {
    .auth-split { grid-template-columns: 1fr; height: auto; min-height: calc(100vh - 60px); }
    .auth-image { display: none; }
    .auth-panel { overflow-y: visible; }
  }
</style>
