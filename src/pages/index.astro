---
import Navbar from '../components/Navbar.astro';
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Global Aerosols</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Michroma&family=Montserrat:wght@200;300;400;700;800;900&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet" />

    <link rel="preload" as="image" href="https://assets.zyrosite.com/A3QlOV94WLSaL6xE/gemini_generated_image_5z3rkq5z3rkq5z3r-3ywNElGmkJA1EjZM.webp" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer is:inline></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer is:inline></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" defer is:inline></script>
</head>
<body>

    <Navbar />

    <div id="ga-main-wrapper">
        <div id="ga-preloader">
            <div class="preloader-text">Global Aerosols</div>
            <div class="preloader-sub">Loading<span class="dots"><span>.</span><span>.</span><span>.</span></span></div>
        </div>

        <!-- Ambient Backgrounds locked to hero viewport -->
        <div id="hero-bg-container">
            <div id="star-canvas-container"></div>
            <!-- Hero image: starts tiny in center, zooms in like a hyperspace object -->
            <img id="hero-image" src="/global aerosols 2.png" alt="Global Aerosols" />
            <canvas id="ripple-canvas"></canvas>
        </div>

        <div id="ui-layer">
            <div id="intro-sequence">
                <h1 id="intro-main">Global Aerosols</h1>
                <div id="intro-sub">Aerosols Systems, Formulations &amp; Process Engineering</div>
            </div>

            <div id="hero-sequence">
                <!-- Mid-screen horizontal divider line with labels -->
                <div class="hero-mid-divider">
                    <span class="mid-label left-label">SYSTEMS &amp; TECHNOLOGY</span>
                    <span class="mid-label center-label">FORMULATIONS</span>
                    <span class="mid-label right-label">AEROSOL ENGINEERING</span>
                </div>

                <!-- Massive Bottom Container -->
                <div class="hero-bottom-container">
                    <h2 class="hero-massive-title" id="hero-massive-title">GLOBAL AEROSOLS</h2>
                </div>

                <!-- CTA Button (like GET FOR FREE) -->
                <a href="#services-section" class="hero-cta-btn">EXPLORE SERVICES +</a>
            </div>
        </div>
    </div>

    <!-- OUR SERVICES SECTION -->
    <section id="services-section">
        <div class="section-container">
            <div class="section-header">
                <span class="section-label">Our Services</span>
            </div>

            <div class="services-grid">
                <!-- Card 1 -->
                <div class="service-card">
