                        <span class="card-count">/6 services</span>
                    </div>
                    <img class="card-bg-image" src="https://assets.zyrosite.com/A3QlOV94WLSaL6xE/aerosol-formulations-2EFrbqOisfHrxDUQ.png" alt="Product Development" />
                    <div class="card-icon-wrapper">
                        <!-- Custom CSS dot-matrix icon (Beaker / Chemistry Flask shape) -->
                        <svg viewBox="0 0 24 24" width="32" height="32" class="dot-matrix-svg">
                            <circle cx="12" cy="4" r="1.5" fill="#00ffcc" />
                            <circle cx="10" cy="8" r="1.5" fill="#00ffcc" />
                            <circle cx="14" cy="8" r="1.5" fill="#00ffcc" />
                            <circle cx="10" cy="12" r="1.5" fill="#00ffcc" />
                            <circle cx="14" cy="12" r="1.5" fill="#00ffcc" />
                            <circle cx="7" cy="16" r="1.5" fill="#00ffcc" />
                            <circle cx="17" cy="16" r="1.5" fill="#00ffcc" />
                            <circle cx="12" cy="16" r="1.5" fill="#00ffcc" />
                            <circle cx="4" cy="20" r="1.5" fill="#00ffcc" />
