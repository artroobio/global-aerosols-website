                            <circle cx="16" cy="20" r="1.5" fill="#00ffcc" />
                            <circle cx="20" cy="20" r="1.5" fill="#00ffcc" />
                        </svg>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="service-card">
                    <div class="card-header">
                        <h3 class="card-title">Manufacturing<br/>&amp; Filling</h3>
                        <span class="card-count">/5 services</span>
                    </div>
                    <img class="card-bg-image" src="https://assets.zyrosite.com/A3QlOV94WLSaL6xE/industrial-aerosol-filling-line-consultancy-3Y4xkTeHD23LZ2jp.png" alt="Manufacturing & Filling" />
                    <div class="card-icon-wrapper">
