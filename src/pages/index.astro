                            <circle cx="6" cy="12" r="1.5" fill="#00ffcc" />
                            <circle cx="12" cy="12" r="1.5" fill="#00ffcc" />
                            <circle cx="18" cy="12" r="1.5" fill="#00ffcc" />
                            <circle cx="6" cy="18" r="1.5" fill="#00ffcc" />
                            <circle cx="12" cy="18" r="1.5" fill="#00ffcc" />
