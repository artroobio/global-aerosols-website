                    <img class="card-bg-image" src="https://assets.zyrosite.com/A3QlOV94WLSaL6xE/lubricant-dOqZaGanOoI6Zknz.png" alt="Industrial Applications" />
                    <div class="card-icon-wrapper">
                        <!-- Factory / Gear dot-matrix outline -->
                        <svg viewBox="0 0 24 24" width="32" height="32" class="dot-matrix-svg">
                            <circle cx="6" cy="6" r="1.5" fill="#00ffcc" />
