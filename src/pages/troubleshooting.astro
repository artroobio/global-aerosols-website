---
import Layout from '../lc/layouts/Layout.astro';
import ServicePageAnimations from '../lc/components/ServicePageAnimations.astro';

const capabilities = [
  'Batch failure investigation — yield loss, off-spec product, or rejected batches',
  'Stability failure root cause analysis — physical, chemical, or microbiological breakdown',
  'Scale-up discrepancy diagnosis — performance gap between lab and production',
  'Customer complaint technical investigation with corrective action design',
  'Raw material non-conformance impact assessment and approved alternative identification',
  'Process deviation investigation and out-of-specification result review',
  'Supplier change impact assessment — formulation and process implications',
  'Sensory defect diagnosis — unexpected colour, odour, texture, or appearance change',
  'Packaging interaction and product contamination investigation',
  'Regulatory non-compliance identification and remediation strategy',
];

const steps = [
  {
    n: '01',
    t: 'Problem Documentation',
    d: 'Systematic capture of the failure — when it first appeared, under what conditions, how frequently, what changed before onset, and what has already been tried. Incomplete symptom documentation is the leading cause of misdiagnosis.',
  },
  {
    n: '02',
    t: 'Root Cause Analysis',
    d: 'Structured hypothesis testing using the documented evidence. We work through probable causes systematically — ruling each in or out with targeted testing — until the actual cause is confirmed, not just the most plausible one.',
  },
  {
    n: '03',
    t: 'Corrective Action Design',
    d: 'A corrective action targeted at the root cause, not the symptom. We design the fix, specify the verification testing needed to confirm it works, and identify the preventive measures that stop the same failure recurring.',
  },
  {
    n: '04',
    t: 'Verification & Prevention',
    d: 'Validation testing confirms the corrective action resolves the failure without creating new problems. We document the findings and update the process controls, specifications, or batch records to prevent recurrence.',
  },
];

const problems = [
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
    name: 'Batch Rejection',
    desc: 'Out-of-spec viscosity, colour, pH, or active content at batch release. We trace the cause to raw material, process, or equipment before the next batch runs.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c3 4.5 5 7.4 5 10a5 5 0 0 1-10 0c0-2.6 2-5.5 5-10Z"/><line x1="9" y1="14" x2="15" y2="14"/></svg>',
    name: 'Stability Failure',
    desc: 'Phase separation, colour change, viscosity drift, or microbiological growth appearing mid-shelf life. We identify whether the cause is formulation, packaging, or process.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M9 10h.01M15 10h.01M9.5 15a3.5 3.5 0 0 0 5 0"/></svg>',
    name: 'Customer Complaint',
    desc: 'Product returns or performance complaints from the field. We build the technical investigation that determines whether the cause is product, application, or use-condition related.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>',
    name: 'Scale-Up Performance Gap',
    desc: 'Lab results don\'t replicate at production scale. We identify which physical parameter is driving the gap — mixing, heat transfer, addition rate, or hold time — and correct it.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h.01M15 9h.01M9 15h6"/></svg>',
    name: 'Raw Material Change',
    desc: 'Supplier change, batch-to-batch variation, or raw material non-conformance that affects the finished product. We assess the impact and define an approved alternative or process adjustment.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.5 10c-.83 0-1.5-.67-1.5-1.5v-5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5Z"/><path d="M20.5 10H19V8.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5Z"/><path d="M9.5 14c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5S8 21.33 8 20.5v-5c0-.83.67-1.5 1.5-1.5Z"/><path d="M3.5 14H5v1.5c0 .83-.67 1.5-1.5 1.5S2 16.33 2 15.5 2.67 14 3.5 14Z"/><path d="M14 14.5c0-.83.67-1.5 1.5-1.5h5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5h-5c-.83 0-1.5-.67-1.5-1.5Z"/><path d="M15.5 19H14v1.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5-.67-1.5-1.5-1.5Z"/><path d="M10 9.5C10 8.67 9.33 8 8.5 8h-5C2.67 8 2 8.67 2 9.5S2.67 11 3.5 11h5c.83 0 1.5-.67 1.5-1.5Z"/><path d="M8.5 5H10V3.5C10 2.67 9.33 2 8.5 2S7 2.67 7 3.5 7.67 5 8.5 5Z"/></svg>',
    name: 'Sensory Defect',
    desc: 'Unexpected colour shift, off-odour, grainy texture, or unusual appearance. We trace whether the cause is raw material degradation, process change, or a packaging interaction.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>',
    name: 'Packaging Interaction',
    desc: 'Product contamination, leaching, migration, or permeation through the primary packaging. We identify the interaction mechanism and recommend the corrective packaging change.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>',
    name: 'Regulatory Non-Compliance',
    desc: 'Restricted ingredient identified in existing formulation, failed regulatory screening, or notification of new restriction. We assess the scope and design the remediation.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/></svg>',
    name: 'Batch-to-Batch Variability',
    desc: 'Inconsistent product quality across batches from the same formulation and process. We identify the uncontrolled variable and lock it into the specification or process record.',
  },
];

const deliverables = [
  'Root cause analysis report — confirmed cause, evidence base, and ruled-out hypotheses',
  'Corrective action specification — what to change, how to implement it, and why it addresses the root cause',
  'Verification test protocol and results confirming the corrective action is effective',
  'Preventive action recommendations — process controls, specification updates, or monitoring changes',
  'Updated batch record or SOP amendments where the process is implicated',
  'Risk assessment for batches produced during the failure period — retain, rework, or reject determination',
  'Supplier or raw material non-conformance report for third-party accountability where applicable',
];

const splitWords = (s: string) => s.split(' ');
---

<Layout
  title="Troubleshooting | Global Aerosols"
  description="Expert formulation and process troubleshooting — batch failure investigation, stability root cause analysis, customer complaint response, and corrective action design."
  canonical="/troubleshooting"
>

  <!-- ══════════ S1 HERO [DARK] ══════════ -->
  <section class="ts-hero" id="ts-s1">
    <div class="ts-hero-inner">
      <span class="ts-eyebrow-c reveal">Troubleshooting</span>
      <h1 class="ts-hero-h1">
        {splitWords('Find the root cause.').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
        <br class="br-d" />
        {splitWords('Fix it properly.').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
      </h1>
      <p class="ts-hero-sub reveal">
        We investigate formulation and process failures with the same systematic rigour
        we apply to new development — diagnosing the actual cause, not the most
        convenient explanation, and designing fixes that last.
      </p>
      <div class="ts-hero-ctas reveal">
        <a href="/contact" class="ts-btn-primary">Describe the Problem</a>
        <a href="#ts-process" class="ts-btn-ghost">See the approach</a>
      </div>
    </div>
  </section>

  <!-- ══════════ S2 OVERVIEW [LIGHT] ══════════ -->
  <section class="ts-section ts-light ts-split" id="ts-s2">
    <div class="ts-split-inner">
      <div class="ts-split-text">
        <span class="ts-eyebrow-l reveal">The Problem With Problems</span>
        <h2 class="ts-h2-l">
          {splitWords('Most failures are').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
          <br class="br-d" />
          {splitWords('misdiagnosed the first time').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
        </h2>
        <p class="ts-body-l reveal">
          The symptom of a formulation or process failure is almost never the cause.
          A batch that comes out with the wrong viscosity is not a viscosity problem —
          it is a symptom of something that changed upstream: a raw material batch with
          different moisture content, a process step that ran at the wrong temperature,
          a pH drift that deactivated the thickener. Treating the symptom — adding more
          thickener — does not fix the problem. It masks it temporarily and leaves the
          actual cause in place to produce the next failure.
        </p>
        <p class="ts-body-l reveal">
          Our troubleshooting discipline starts with exhaustive symptom documentation
          and systematic hypothesis testing. We work through probable causes in order
          of likelihood, ruling each one in or out with targeted evidence — not gut
          feel and not the answer that is easiest to implement. The corrective action
          we design addresses the root cause. The preventive measures we recommend
          stop the same failure recurring.
        </p>
        <ul class="ts-points">
          {[
            'Systematic root cause analysis — confirmed cause, not most convenient explanation',
            'Corrective action targeted at the cause, not the visible symptom',
            'Verification testing confirms the fix works before production resumes',
            'Preventive measures documented to stop the failure recurring',
          ].map(p => (
            <li class="ts-point reveal">
              <span class="ts-point-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="5 12 10 17 19 7"/></svg>
              </span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="ts-split-media reveal">
        <!-- IMAGE 1 PLACEHOLDER -->
        <img 
          src="https://cdn.globalaerosols.com/images/services/troubleshooting-investigation.webp" 
          alt="Laboratory investigation scene — a rejected or failed product sample jar next to diagnostic tools: pH meter, viscometer probe, and a printed batch record with handwritten annotations. Focused, analytical atmosphere. No people, no readable text on documents." 
          width="900" 
          height="700" 
          class="ts-img"
          style="width: 100%; border-radius: var(--ts-radius, 16px); object-fit: cover; aspect-ratio: 900/700;"
        />
        <p class="img-caption">Troubleshooting Investigation: Diagnostic pH, viscometric, and density review of a returned commercial product batch.</p>
      </div>
    </div>
  </section>

  <!-- ══════════ S3 CAPABILITIES [DARK] ══════════ -->
  <section class="ts-section ts-dark ts-split ts-split-rev" id="ts-s3">
    <div class="ts-split-inner">
      <div class="ts-split-media reveal">
        <!-- IMAGE 2 PLACEHOLDER -->
        <img 
          src="https://cdn.globalaerosols.com/images/services/troubleshooting-sample-comparison.webp" 
          alt="Two sets of product samples in glass vials side by side — one set               showing normal product, the other showing the defective batch with               visible separation, discolouration, or different texture. Clean               dark background, precise lighting. No people, no labels." 
          width="900" 
          height="700" 
          class="ts-img"
          style="width: 100%; border-radius: var(--ts-radius, 16px); object-fit: cover; aspect-ratio: 900/700;"
        />
        <p class="img-caption">Sample Comparison: Side-by-side analysis of a stable, uniform emulsion (left) versus a phase-separated, failed batch (right).</p>
      </div>

      <div class="ts-split-text">
        <span class="ts-eyebrow-d reveal">Technical Scope</span>
        <h2 class="ts-h2-d">
          {splitWords('Diagnostic clarity').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
          ))}
          <br class="br-d" />
          {splitWords('for complex issues').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
          ))}
        </h2>
        <p class="ts-body-d reveal">
          Our troubleshooting service provides rapid, decisive engineering support when batches fail QC, formulations degrade, or processing equipment encounters blockages. We combine chemical forensics with plant process auditing to isolate the root cause of the failure and deliver immediate corrective SOPs.
        </p>
        <ul class="ts-cap-grid reveal">
          {capabilities.map(c => (
            <li>
              <span class="ts-cap-dot"></span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════ S4 PROCESS [LIGHT] ══════════ -->
  <section class="ts-section ts-light ts-process" id="ts-process">
    <div class="ts-process-head">
      <span class="ts-eyebrow-l reveal">How We Work</span>
      <h2 class="ts-h2-l ts-centered">
        {splitWords('Our systematic diagnostic process').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
        ))}
      </h2>
      <p class="ts-process-sub reveal">
        Four phases that triage the failure, analyze chemical forensics, execute pilot corrective runs, and establish locked plant safeguards to design out future errors.
      </p>
    </div>
    <div class="ts-steps">
      {steps.map(s => (
        <div class="ts-step reveal">
          <span class="ts-step-n">{s.n}</span>
          <span class="ts-step-rule"></span>
          <h3 class="ts-step-t">{s.t}</h3>
          <p class="ts-step-d">{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════ S5 SPECIALIZATION [DARK] ══════════ -->
  <section class="ts-section ts-dark ts-problems" id="ts-s5">
    <div class="ts-tech-head">
      <span class="ts-eyebrow-c reveal">Common Failures</span>
      <h2 class="ts-h2-d ts-centered">
        {splitWords('Diagnostic and').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
        <br class="br-d" />
        {splitWords('corrective action').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
      </h2>
      <p class="ts-tech-sub reveal">
        Quickly isolating and correcting the chemical, physical, and processing errors that cause manufacturing batches to fail QC.
      </p>
    </div>
    <div class="ts-tech-grid">
      {problems.map((t, idx) => (
        <div class="ts-tech-tile reveal" style={`--d:${idx * 0.055}s`}>
          <span class="ts-tech-ico" set:html={t.icon}></span>
          <h3 class="ts-tech-name">{t.name}</h3>
          <p class="ts-tech-desc">{t.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════ S6 DELIVERABLES [LIGHT] ══════════ -->
  <section class="ts-section ts-light ts-split" id="ts-s6">
    <div class="ts-split-inner ts-split-inner-rev">
      <div class="ts-split-text">
        <span class="ts-eyebrow-l reveal">Deliverables</span>
        <h2 class="ts-h2-l">
          {splitWords('Rapid response &').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
          <br class="br-d" />
          {splitWords('corrective plant SOPs').map(w => (
            <span class="aw">{w.split('').map(c => <span class="ac ac-l">{c}</span>)}</span>
          ))}
        </h2>
        <p class="ts-body-l reveal">
          When production stalls, every hour counts. We supply immediate root cause analysis (RCA) reports, updated corrective batch mixing protocols, raw material replacement logs, local exhaust/safety audits, and post-corrective stability assessments to resume manufacturing with total confidence.
        </p>
        <ul class="ts-points">
          {deliverables.map(d => (
            <li class="ts-point reveal">
              <span class="ts-point-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="5 12 10 17 19 7"/></svg>
              </span>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="ts-split-media reveal">
        <!-- IMAGE 3 PLACEHOLDER -->
        <img 
          src="https://cdn.globalaerosols.com/images/services/troubleshooting-rca-report.webp" 
          alt="A printed root cause analysis report document open on a clean desk —               structured pages visible with section headers, a fishbone or               cause-and-effect diagram visible as a graphic element on the page,               and a corrective action log alongside it. Overhead angle, clean light.               No people, no legible body text visible." 
          width="900" 
          height="700" 
          class="ts-img"
          style="width: 100%; border-radius: var(--ts-radius, 16px); object-fit: cover; aspect-ratio: 900/700;"
        />
        <p class="img-caption">Root Cause Analysis: Formal fishbone diagrammatic report tracking corrective and preventive actions (CAPA) for product stabilization.</p>
      </div>
    </div>
  </section>

  <!-- ══════════ S7 CTA [DARK] ══════════ -->
  <section class="ts-section ts-dark ts-cta" id="ts-s7">
    <div class="ts-cta-card reveal">
      <span class="ts-eyebrow-c" style="margin-bottom: 20px; display: block;">Get Started</span>
      <h2 class="ts-cta-h2">
        {splitWords('Isolate your batch').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
        <br class="br-d" />
        {splitWords('failures today.').map(w => (
          <span class="aw">{w.split('').map(c => <span class="ac">{c}</span>)}</span>
        ))}
      </h2>
      <p class="ts-cta-sub reveal">
        Whether you're designing a process from scratch, troubleshooting a scale-up
        failure, or preparing a safety analysis for a regulatory submission — we can help.
      </p>
      <form class="ts-cta-form reveal" action="/contact" method="get">
        <input type="email" name="email" placeholder="Enter your email to get started…" aria-label="Email address" required />
        <button type="submit">Discuss Your Process</button>
      </form>
      <p class="ts-cta-alt reveal">
        Need a call first?&nbsp;
        <a href="/contact">Book a consultation →</a>
      </p>
    </div>
  </section>

  <ServicePageAnimations />
</Layout>

<style>
  /* --- HERO SECTION --- */
  .ts-hero {
    background: linear-gradient(135deg, #0b0f19 0%, #111827 100%);
    padding: 140px 24px 100px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .ts-hero-inner {
    max-width: 880px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }
  .ts-eyebrow-c {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #3b82f6;
    margin-bottom: 24px;
    display: inline-block;
  }
  .ts-hero-h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 24px;
    font-family: 'Outfit', sans-serif;
  }
  .ts-hero-sub {
    font-size: 1.2rem;
    color: #9ca3af;
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  .ts-hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .ts-btn-primary {
    background: #2563eb;
    color: #ffffff;
    padding: 14px 32px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .ts-btn-primary:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
  }
  .ts-btn-ghost {
    background: transparent;
    color: #ffffff;
    padding: 14px 32px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.2s ease;
  }
  .ts-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* --- SECTION BASE --- */
  .ts-section {
    padding: 100px 24px;
    position: relative;
  }
  .ts-light {
    background: #ffffff;
    color: #1f2937;
  }
  .ts-dark {
    background: #0b0f19;
    color: #f3f4f6;
  }

  /* --- SPLIT LAYOUT --- */
  .ts-split-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .ts-split-inner-rev {
    grid-template-columns: 1fr 1.2fr;
  }
  @media (max-width: 1024px) {
    .ts-split-inner, .ts-split-inner-rev {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  .ts-split-text {
    display: flex;
    flex-direction: column;
  }
  .ts-split-media {
    position: relative;
    width: 100%;
  }
  .ts-eyebrow-l {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #2563eb;
    margin-bottom: 20px;
    display: inline-block;
  }
  .ts-eyebrow-d {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #60a5fa;
    margin-bottom: 20px;
    display: inline-block;
  }
  .ts-h2-l {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    color: #111827;
    margin-bottom: 24px;
    font-family: 'Outfit', sans-serif;
  }
  .ts-h2-d {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: 24px;
    font-family: 'Outfit', sans-serif;
  }
  .ts-body-l {
    font-size: 1.05rem;
    color: #4b5563;
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .ts-body-d {
    font-size: 1.05rem;
    color: #9ca3af;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  /* --- POINTS LIST --- */
  .ts-points {
    list-style: none;
    padding: 0;
    margin: 32px 0 0 0;
    display: flex;
